{"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/com.nvidia.CloudXRKit\/documentation\/CloudXRKit\/OpaqueDataChannel","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/cloudxrkit\/opaquedatachannel"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/cloudxrkit\/opaquedatachannel"],"traits":[{"interfaceLanguage":"occ"}]}],"metadata":{"modules":[{"name":"CloudXRKit"}],"role":"article","title":"CloudXR Opaque Data (Message Channel) API User Guide","roleHeading":"Article"},"hierarchy":{"paths":[["doc:\/\/com.nvidia.CloudXRKit\/documentation\/CloudXRKit"]]},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"The CloudXR Message Channel API provides a bi-directional communication mechanism between the CloudXR client and server applications. This allows you to send custom data alongside the video\/audio streaming, enabling rich interactions between client and server."}],"type":"paragraph"},{"inlineContent":[{"text":"On the server-side, this requires the app to implement the XR_NV_opaque_data_channel extension. On the client side, the name used for the API is MessageChannel.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Key Concepts","anchor":"Key-Concepts"},{"level":3,"type":"heading","text":"Message Channels","anchor":"Message-Channels"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Channel"}],"type":"strong"},{"text":": A bi-directional communication pipe identified by a unique UUID","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Channel Info"}]},{"type":"text","text":": Contains channel metadata (ID and UUID)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Channel Status","type":"text"}],"type":"strong"},{"type":"text","text":": Tracks the state of a channel (Not Initialized, Ready, or Closed)"}]}]}],"type":"unorderedList"},{"text":"Components","anchor":"Components","type":"heading","level":3},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"CloudXRKit.Session"}],"type":"strong"},{"text":": Manages available channels and provides access to them","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"MessageChannel","type":"text"}],"type":"strong"},{"text":": Represents an individual communication channel","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"MessageChannelManager"}],"type":"strong"},{"type":"text","text":": Internal component that handles channel lifecycle"}]}]}],"type":"orderedList"},{"type":"heading","anchor":"API-Usage","level":2,"text":"API Usage"},{"level":3,"type":"heading","text":"1. Discovering Available Channels","anchor":"1-Discovering-Available-Channels"},{"inlineContent":[{"type":"text","text":"Channels are announced by the server. Monitor the session’s "},{"code":"availableMessageChannels","type":"codeVoice"},{"type":"text","text":" property:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Access available channels from your CloudXRKit.Session instance","let availableChannels = cxrSession.availableMessageChannels","","\/\/ Each ChannelInfo contains:","\/\/ - channelId: Internal numeric identifier","\/\/ - uuid: Unique identifier as Data (can be converted to string)"]},{"level":3,"type":"heading","text":"2. Opening a Channel","anchor":"2-Opening-a-Channel"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To start using a channel, retrieve it from the session:"}]},{"code":["\/\/ Select a channel from available channels","let channelInfo = cxrSession.availableMessageChannels.first","","\/\/ Get the MessageChannel object","if let channel = cxrSession.getMessageChannel(channelInfo) {","    \/\/ Channel is now ready to use","    print(\"Channel status: \\(channel.status)\")","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"3. Sending Messages","anchor":"3-Sending-Messages","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Send data to the server using the channel:"}]},{"code":["\/\/ Convert your data to Data format","let message = \"Hello Server\"","if let data = message.data(using: .utf8) {","    let success = channel.sendServerMessage(data)","    if success {","        print(\"Message sent successfully\")","    }","}","","\/\/ You can send any binary data","let binaryData = Data([0x01, 0x02, 0x03, 0x04])","channel.sendServerMessage(binaryData)"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"4. Receiving Messages","anchor":"4-Receiving-Messages","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Messages from the server are delivered through an AsyncStream:"}]},{"code":["\/\/ Set up a task to receive messages","Task {","    for await messageData in channel.receivedMessageStream {","        \/\/ Process received data","        if let message = String(data: messageData, encoding: .utf8) {","            print(\"Received: \\(message)\")","        } else {","            \/\/ Handle binary data","            print(\"Received \\(messageData.count) bytes\")","        }","    }","    \/\/ Stream ended - channel is closed","    print(\"Channel closed\")","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"5. Channel Status","anchor":"5-Channel-Status","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Monitor the channel status to ensure proper operation:"}]},{"code":["switch channel.status {","case .notInitialized:","    print(\"Channel not yet initialized\")","case .ready:","    print(\"Channel ready for communication\")","case .closed:","    print(\"Channel has been closed\")","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"6. Closing a Channel","anchor":"6-Closing-a-Channel","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Explicitly close a channel when done:"}]},{"code":["channel.disconnect()"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Complete Example","anchor":"Complete-Example","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Here’s a complete example showing typical usage:"}]},{"code":["import CloudXRKit","import SwiftUI","","struct MessageChannelExample: View {","    let cxrSession: CloudXRKit.Session","    @State private var currentChannel: MessageChannel?","    @State private var receivedMessages: [String] = []","    @State private var readerTask: Task<Void, Never>?","","    var body: some View {","        VStack {","            \/\/ Channel selection","            if let firstChannel = cxrSession.availableMessageChannels.first {","                Button(\"Open Channel\") {","                    openChannel(firstChannel)","                }","            }","","            \/\/ Send message","            if currentChannel?.status == .ready {","                Button(\"Send Hello\") {","                    sendMessage(\"Hello from client!\")","                }","            }","","            \/\/ Display received messages","            List(receivedMessages, id: \\.self) { message in","                Text(message)","            }","        }","        .onDisappear {","            \/\/ Clean up","            readerTask?.cancel()","            currentChannel?.disconnect()","        }","    }","","    func openChannel(_ channelInfo: ChannelInfo) {","        guard let channel = cxrSession.getMessageChannel(channelInfo) else {","            print(\"Failed to open channel\")","            return","        }","","        currentChannel = channel","","        \/\/ Start receiving messages","        readerTask = Task {","            for await data in channel.receivedMessageStream {","                if let message = String(data: data, encoding: .utf8) {","                    await MainActor.run {","                        receivedMessages.append(message)","                    }","                }","            }","        }","    }","","    func sendMessage(_ text: String) {","        guard let data = text.data(using: .utf8),","              let channel = currentChannel else { return }","","        _ = channel.sendServerMessage(data)","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Best Practices","anchor":"Best-Practices","level":2},{"type":"heading","text":"1. Error Handling","anchor":"1-Error-Handling","level":3},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Always check if ","type":"text"},{"code":"getMessageChannel()","type":"codeVoice"},{"text":" returns a valid channel","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Verify ","type":"text"},{"code":"sendServerMessage()","type":"codeVoice"},{"text":" return value for send confirmation","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Handle channel closure gracefully in your receive loop","type":"text"}]}]}]},{"type":"heading","text":"2. Data Encoding","anchor":"2-Data-Encoding","level":3},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Use consistent encoding between client and server (e.g., UTF-8 for text)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Consider using structured formats (JSON, Protocol Buffers) for complex data","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Handle binary data appropriately"}],"type":"paragraph"}]}]},{"level":3,"type":"heading","text":"3. Resource Management","anchor":"3-Resource-Management"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Cancel reader tasks when no longer needed"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Disconnect channels explicitly when done"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Monitor channel status changes"}],"type":"paragraph"}]}]},{"type":"heading","text":"4. Performance Considerations","anchor":"4-Performance-Considerations","level":3},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Message channels share bandwidth with video\/audio streaming"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Avoid sending large amounts of data frequently"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Consider batching small messages"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"text":"Advanced Usage","type":"heading","anchor":"Advanced-Usage"},{"level":3,"text":"Custom Data Formats","type":"heading","anchor":"Custom-Data-Formats"},{"type":"paragraph","inlineContent":[{"text":"For structured data, consider using JSON:","type":"text"}]},{"code":["struct GameState: Codable {","    let playerPosition: SIMD3<Float>","    let score: Int","}","","\/\/ Sending","let gameState = GameState(playerPosition: [1, 2, 3], score: 100)","if let jsonData = try? JSONEncoder().encode(gameState) {","    channel.sendServerMessage(jsonData)","}","","\/\/ Receiving","for await data in channel.receivedMessageStream {","    if let gameState = try? JSONDecoder().decode(GameState.self, from: data) {","        print(\"Player at: \\(gameState.playerPosition), Score: \\(gameState.score)\")","    }","}"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Multiple-Channels","text":"Multiple Channels","type":"heading"},{"inlineContent":[{"text":"You can manage multiple channels simultaneously:","type":"text"}],"type":"paragraph"},{"code":["var activeChannels: [ChannelInfo: MessageChannel] = [:]","","\/\/ Open multiple channels","for channelInfo in cxrSession.availableMessageChannels {","    if let channel = cxrSession.getMessageChannel(channelInfo) {","        activeChannels[channelInfo] = channel","        \/\/ Set up individual receivers for each channel","    }","}"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Troubleshooting","anchor":"Troubleshooting","type":"heading"},{"level":3,"text":"Channel Not Available","anchor":"Channel-Not-Available","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Ensure the server has announced the channel","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Check that the session is in connected state","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Verify the channel UUID matches between client and server","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"heading","anchor":"Messages-Not-Received","level":3,"text":"Messages Not Received"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Confirm the channel status is ","type":"text"},{"type":"codeVoice","code":".ready"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Check that the receive task is running","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Verify data encoding matches between sender and receiver","type":"text"}],"type":"paragraph"}]}]},{"level":3,"text":"Channel Closes Unexpectedly","anchor":"Channel-Closes-Unexpectedly","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"Monitor server-side logs for errors","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Check network connectivity","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Ensure proper error handling in message processing","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"text":"Server-Side Implementation","anchor":"Server-Side-Implementation","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The server implements the XR_NV_opaque_data_channel OpenXR extension, which maps to the client’s MessageChannel API:"}]},{"anchor":"How-Server-and-Client-Connect","level":3,"type":"heading","text":"How Server and Client Connect"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Server creates channel"}],"type":"strong"},{"text":": ","type":"text"},{"code":"xrCreateOpaqueDataChannelNV()","type":"codeVoice"},{"text":" with a UUID","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Client discovers channel","type":"text"}]},{"text":": Appears in ","type":"text"},{"type":"codeVoice","code":"availableMessageChannels"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Client opens channel","type":"text"}],"type":"strong"},{"type":"text","text":": "},{"code":"getMessageChannel()","type":"codeVoice"},{"text":" initiates connection","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Both wait for ready state","type":"text"}],"type":"strong"},{"text":": Server polls for CONNECTED, client for ready","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Exchange messages","type":"text"}]},{"type":"text","text":": "},{"code":"xrSend\/ReceiveOpaqueDataChannelNV","type":"codeVoice"},{"text":" ↔ ","type":"text"},{"code":"sendServerMessage\/receivedMessageStream","type":"codeVoice"}],"type":"paragraph"}]}]},{"anchor":"Key-Differences","level":3,"type":"heading","text":"Key Differences"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Shutdown vs Destroy"}]},{"text":":","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"xrShutdownOpaqueDataChannelNV"},{"text":": Gracefully closes connection (client sees “closed”)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"xrDestroyOpaqueDataChannelNV"},{"text":": Frees resources (must call after shutdown)","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Why Server Waits"}]},{"type":"text","text":": Although server creates the channel, it must wait for client connection due to announcement propagation and handshaking."}]},{"anchor":"Example-Pairing","type":"heading","level":3,"text":"Example Pairing"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Server (C++)"}]},{"text":":","type":"text"}],"type":"paragraph"},{"code":["\/\/ Create with known UUID","xrCreateOpaqueDataChannelNV(instance, &createInfo, &channel);","WaitForConnection(channel);  \/\/ Poll until CONNECTED","xrSendOpaqueDataChannelNV(channel, len, data);"],"syntax":"c++","type":"codeListing"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Client (Swift)"}],"type":"strong"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Find matching UUID","let channel = cxrSession.getMessageChannel(channelInfo)!","channel.sendServerMessage(responseData)"]},{"level":2,"type":"heading","text":"Summary","anchor":"Summary"},{"inlineContent":[{"type":"text","text":"The CloudXR Message Channel API provides a flexible way to extend CloudXR applications with custom communication. By following this guide, you can implement robust bi-directional messaging between your client and server applications."}],"type":"paragraph"}]}],"references":{"doc://com.nvidia.CloudXRKit/documentation/CloudXRKit":{"type":"topic","role":"collection","title":"CloudXRKit","abstract":[{"text":"Stream immersive applications.","type":"text"}],"identifier":"doc:\/\/com.nvidia.CloudXRKit\/documentation\/CloudXRKit","url":"\/documentation\/cloudxrkit","kind":"symbol"}},"variantOverrides":[{"traits":[{"interfaceLanguage":"occ"}],"patch":[{"path":"\/identifier\/interfaceLanguage","value":"occ","op":"replace"},{"path":"\/topicSections","value":null,"op":"add"},{"path":"\/seeAlsoSections","value":null,"op":"add"}]}]}