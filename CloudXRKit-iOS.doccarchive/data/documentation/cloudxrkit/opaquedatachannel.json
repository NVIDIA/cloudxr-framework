{"metadata":{"role":"article","roleHeading":"Article","title":"CloudXR Opaque Data (Message Channel) API User Guide","modules":[{"name":"CloudXRKit"}]},"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.nvidia.CloudXRKit\/documentation\/CloudXRKit\/OpaqueDataChannel"},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The CloudXR Message Channel API provides a bi-directional communication mechanism between the CloudXR client and server applications. This allows you to send custom data alongside the video\/audio streaming, enabling rich interactions between client and server."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"On the server-side, this requires the app to implement the XR_NV_opaque_data_channel extension. On the client side, the name used for the API is MessageChannel."}],"type":"paragraph"},{"anchor":"Key-Concepts","text":"Key Concepts","type":"heading","level":2},{"anchor":"Message-Channels","text":"Message Channels","type":"heading","level":3},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Channel","type":"text"}]},{"type":"text","text":": A bi-directional communication pipe identified by a unique UUID"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Channel Info","type":"text"}]},{"type":"text","text":": Contains channel metadata (ID and UUID)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Channel Status","type":"text"}]},{"type":"text","text":": Tracks the state of a channel (Not Initialized, Ready, or Closed)"}]}]}],"type":"unorderedList"},{"anchor":"Components","text":"Components","type":"heading","level":3},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"CloudXRKit.Session","type":"text"}]},{"type":"text","text":": Manages available channels and provides access to them"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"MessageChannel","type":"text"}]},{"type":"text","text":": Represents an individual communication channel"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"MessageChannelManager","type":"text"}]},{"type":"text","text":": Internal component that handles channel lifecycle"}]}]}],"type":"orderedList"},{"anchor":"API-Usage","text":"API Usage","type":"heading","level":2},{"anchor":"1-Discovering-Available-Channels","text":"1. Discovering Available Channels","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Channels are announced by the server. Monitor the session’s "},{"type":"codeVoice","code":"availableMessageChannels"},{"type":"text","text":" property:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Access available channels from your CloudXRKit.Session instance","let availableChannels = cxrSession.availableMessageChannels","","\/\/ Each ChannelInfo contains:","\/\/ - channelId: Internal numeric identifier","\/\/ - uuid: Unique identifier as Data (can be converted to string)"],"type":"codeListing"},{"anchor":"2-Opening-a-Channel","text":"2. Opening a Channel","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"To start using a channel, retrieve it from the session:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Select a channel from available channels","let channelInfo = cxrSession.availableMessageChannels.first","","\/\/ Get the MessageChannel object","if let channel = cxrSession.getMessageChannel(channelInfo) {","    \/\/ Channel is now ready to use","    print(\"Channel status: \\(channel.status)\")","}"],"type":"codeListing"},{"anchor":"3-Sending-Messages","text":"3. Sending Messages","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Send data to the server using the channel:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Convert your data to Data format","let message = \"Hello Server\"","if let data = message.data(using: .utf8) {","    let success = channel.sendServerMessage(data)","    if success {","        print(\"Message sent successfully\")","    }","}","","\/\/ You can send any binary data","let binaryData = Data([0x01, 0x02, 0x03, 0x04])","channel.sendServerMessage(binaryData)"],"type":"codeListing"},{"anchor":"4-Receiving-Messages","text":"4. Receiving Messages","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Messages from the server are delivered through an AsyncStream:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Set up a task to receive messages","Task {","    for await messageData in channel.receivedMessageStream {","        \/\/ Process received data","        if let message = String(data: messageData, encoding: .utf8) {","            print(\"Received: \\(message)\")","        } else {","            \/\/ Handle binary data","            print(\"Received \\(messageData.count) bytes\")","        }","    }","    \/\/ Stream ended - channel is closed","    print(\"Channel closed\")","}"],"type":"codeListing"},{"anchor":"5-Channel-Status","text":"5. Channel Status","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Monitor the channel status to ensure proper operation:"}],"type":"paragraph"},{"syntax":"swift","code":["switch channel.status {","case .notInitialized:","    print(\"Channel not yet initialized\")","case .ready:","    print(\"Channel ready for communication\")","case .closed:","    print(\"Channel has been closed\")","}"],"type":"codeListing"},{"anchor":"6-Closing-a-Channel","text":"6. Closing a Channel","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Explicitly close a channel when done:"}],"type":"paragraph"},{"syntax":"swift","code":["channel.disconnect()"],"type":"codeListing"},{"anchor":"Complete-Example","text":"Complete Example","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Here’s a complete example showing typical usage:"}],"type":"paragraph"},{"syntax":"swift","code":["import CloudXRKit","import SwiftUI","","struct MessageChannelExample: View {","    let cxrSession: CloudXRKit.Session","    @State private var currentChannel: MessageChannel?","    @State private var receivedMessages: [String] = []","    @State private var readerTask: Task<Void, Never>?","","    var body: some View {","        VStack {","            \/\/ Channel selection","            if let firstChannel = cxrSession.availableMessageChannels.first {","                Button(\"Open Channel\") {","                    openChannel(firstChannel)","                }","            }","","            \/\/ Send message","            if currentChannel?.status == .ready {","                Button(\"Send Hello\") {","                    sendMessage(\"Hello from client!\")","                }","            }","","            \/\/ Display received messages","            List(receivedMessages, id: \\.self) { message in","                Text(message)","            }","        }","        .onDisappear {","            \/\/ Clean up","            readerTask?.cancel()","            currentChannel?.disconnect()","        }","    }","","    func openChannel(_ channelInfo: ChannelInfo) {","        guard let channel = cxrSession.getMessageChannel(channelInfo) else {","            print(\"Failed to open channel\")","            return","        }","","        currentChannel = channel","","        \/\/ Start receiving messages","        readerTask = Task {","            for await data in channel.receivedMessageStream {","                if let message = String(data: data, encoding: .utf8) {","                    await MainActor.run {","                        receivedMessages.append(message)","                    }","                }","            }","        }","    }","","    func sendMessage(_ text: String) {","        guard let data = text.data(using: .utf8),","              let channel = currentChannel else { return }","","        _ = channel.sendServerMessage(data)","    }","}"],"type":"codeListing"},{"anchor":"Best-Practices","text":"Best Practices","type":"heading","level":2},{"anchor":"1-Error-Handling","text":"1. Error Handling","type":"heading","level":3},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Always check if "},{"type":"codeVoice","code":"getMessageChannel()"},{"type":"text","text":" returns a valid channel"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify "},{"type":"codeVoice","code":"sendServerMessage()"},{"type":"text","text":" return value for send confirmation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Handle channel closure gracefully in your receive loop"}]}]}],"type":"unorderedList"},{"anchor":"2-Data-Encoding","text":"2. Data Encoding","type":"heading","level":3},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use consistent encoding between client and server (e.g., UTF-8 for text)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Consider using structured formats (JSON, Protocol Buffers) for complex data"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Handle binary data appropriately"}]}]}],"type":"unorderedList"},{"anchor":"3-Resource-Management","text":"3. Resource Management","type":"heading","level":3},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cancel reader tasks when no longer needed"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Disconnect channels explicitly when done"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Monitor channel status changes"}]}]}],"type":"unorderedList"},{"anchor":"4-Performance-Considerations","text":"4. Performance Considerations","type":"heading","level":3},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Message channels share bandwidth with video\/audio streaming"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Avoid sending large amounts of data frequently"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Consider batching small messages"}]}]}],"type":"unorderedList"},{"anchor":"Advanced-Usage","text":"Advanced Usage","type":"heading","level":2},{"anchor":"Custom-Data-Formats","text":"Custom Data Formats","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"For structured data, consider using JSON:"}],"type":"paragraph"},{"syntax":"swift","code":["struct GameState: Codable {","    let playerPosition: SIMD3<Float>","    let score: Int","}","","\/\/ Sending","let gameState = GameState(playerPosition: [1, 2, 3], score: 100)","if let jsonData = try? JSONEncoder().encode(gameState) {","    channel.sendServerMessage(jsonData)","}","","\/\/ Receiving","for await data in channel.receivedMessageStream {","    if let gameState = try? JSONDecoder().decode(GameState.self, from: data) {","        print(\"Player at: \\(gameState.playerPosition), Score: \\(gameState.score)\")","    }","}"],"type":"codeListing"},{"anchor":"Multiple-Channels","text":"Multiple Channels","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"You can manage multiple channels simultaneously:"}],"type":"paragraph"},{"syntax":"swift","code":["var activeChannels: [ChannelInfo: MessageChannel] = [:]","","\/\/ Open multiple channels","for channelInfo in cxrSession.availableMessageChannels {","    if let channel = cxrSession.getMessageChannel(channelInfo) {","        activeChannels[channelInfo] = channel","        \/\/ Set up individual receivers for each channel","    }","}"],"type":"codeListing"},{"anchor":"Troubleshooting","text":"Troubleshooting","type":"heading","level":2},{"anchor":"Channel-Not-Available","text":"Channel Not Available","type":"heading","level":3},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensure the server has announced the channel"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Check that the session is in connected state","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Verify the channel UUID matches between client and server"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"heading","text":"Messages Not Received","level":3,"anchor":"Messages-Not-Received"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Confirm the channel status is "},{"code":".ready","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Check that the receive task is running"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Verify data encoding matches between sender and receiver","type":"text"}]}]}]},{"anchor":"Channel-Closes-Unexpectedly","text":"Channel Closes Unexpectedly","type":"heading","level":3},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Monitor server-side logs for errors"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Check network connectivity"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensure proper error handling in message processing"}]}]}],"type":"unorderedList"},{"anchor":"Server-Side-Implementation","text":"Server-Side Implementation","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The server implements the XR_NV_opaque_data_channel OpenXR extension, which maps to the client’s MessageChannel API:"}],"type":"paragraph"},{"type":"heading","text":"How Server and Client Connect","level":3,"anchor":"How-Server-and-Client-Connect"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Server creates channel"}]},{"type":"text","text":": "},{"code":"xrCreateOpaqueDataChannelNV()","type":"codeVoice"},{"type":"text","text":" with a UUID"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Client discovers channel","type":"text"}]},{"type":"text","text":": Appears in "},{"type":"codeVoice","code":"availableMessageChannels"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Client opens channel","type":"text"}],"type":"strong"},{"text":": ","type":"text"},{"code":"getMessageChannel()","type":"codeVoice"},{"text":" initiates connection","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Both wait for ready state","type":"text"}],"type":"strong"},{"text":": Server polls for CONNECTED, client for ready","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Exchange messages","type":"text"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"xrSend\/ReceiveOpaqueDataChannelNV"},{"type":"text","text":" ↔ "},{"type":"codeVoice","code":"sendServerMessage\/receivedMessageStream"}],"type":"paragraph"}]}]},{"type":"heading","text":"Key Differences","level":3,"anchor":"Key-Differences"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Shutdown vs Destroy"}]},{"type":"text","text":":"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"xrShutdownOpaqueDataChannelNV","type":"codeVoice"},{"type":"text","text":": Gracefully closes connection (client sees “closed”)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"xrDestroyOpaqueDataChannelNV","type":"codeVoice"},{"type":"text","text":": Frees resources (must call after shutdown)"}]}]}]},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Why Server Waits","type":"text"}]},{"type":"text","text":": Although server creates the channel, it must wait for client connection due to announcement propagation and handshaking."}],"type":"paragraph"},{"anchor":"Example-Pairing","text":"Example Pairing","type":"heading","level":3},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Server (C++)"}],"type":"strong"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"c++","code":["\/\/ Create with known UUID","xrCreateOpaqueDataChannelNV(instance, &createInfo, &channel);","WaitForConnection(channel);  \/\/ Poll until CONNECTED","xrSendOpaqueDataChannelNV(channel, len, data);"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Client (Swift)","type":"text"}],"type":"strong"},{"text":":","type":"text"}]},{"type":"codeListing","code":["\/\/ Find matching UUID","let channel = cxrSession.getMessageChannel(channelInfo)!","channel.sendServerMessage(responseData)"],"syntax":"swift"},{"type":"heading","text":"Summary","level":2,"anchor":"Summary"},{"type":"paragraph","inlineContent":[{"text":"The CloudXR Message Channel API provides a flexible way to extend CloudXR applications with custom communication. By following this guide, you can implement robust bi-directional messaging between your client and server applications.","type":"text"}]}]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/com.nvidia.CloudXRKit\/documentation\/CloudXRKit"]]},"variants":[{"paths":["\/documentation\/cloudxrkit\/opaquedatachannel"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/cloudxrkit\/opaquedatachannel"],"traits":[{"interfaceLanguage":"occ"}]}],"references":{"doc://com.nvidia.CloudXRKit/documentation/CloudXRKit":{"url":"\/documentation\/cloudxrkit","title":"CloudXRKit","abstract":[{"type":"text","text":"Stream immersive applications."}],"type":"topic","identifier":"doc:\/\/com.nvidia.CloudXRKit\/documentation\/CloudXRKit","kind":"symbol","role":"collection"}},"variantOverrides":[{"patch":[{"op":"replace","path":"\/identifier\/interfaceLanguage","value":"occ"},{"op":"add","path":"\/topicSections","value":null},{"op":"add","path":"\/seeAlsoSections","value":null}],"traits":[{"interfaceLanguage":"occ"}]}]}