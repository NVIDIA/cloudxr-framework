{"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The CloudXR Message Channel API provides a bi-directional communication mechanism between the CloudXR client and server applications. This allows you to send custom data alongside the video\/audio streaming, enabling rich interactions between client and server."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On the server-side, this requires the app to implement the XR_NV_opaque_data_channel extension. On the client side, the name used for the API is MessageChannel."}]},{"text":"Key Concepts","anchor":"Key-Concepts","type":"heading","level":2},{"text":"Message Channels","anchor":"Message-Channels","type":"heading","level":3},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Channel"}]},{"type":"text","text":": A bi-directional communication pipe identified by a unique UUID"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Channel Info"}]},{"type":"text","text":": Contains channel metadata (ID and UUID)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Channel Status"}]},{"type":"text","text":": Tracks the state of a channel (Not Initialized, Ready, or Closed)"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Components","anchor":"Components","type":"heading","level":3},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"CloudXRKit.Session"}]},{"type":"text","text":": Manages available channels and provides access to them"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"MessageChannel"}]},{"type":"text","text":": Represents an individual communication channel"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"MessageChannelManager"}]},{"type":"text","text":": Internal component that handles channel lifecycle"}],"type":"paragraph"}]}],"type":"orderedList"},{"text":"API Usage","anchor":"API-Usage","type":"heading","level":2},{"text":"1. Discovering Available Channels","anchor":"1-Discovering-Available-Channels","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Channels are announced by the server. Monitor the session’s "},{"code":"availableMessageChannels","type":"codeVoice"},{"type":"text","text":" property:"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Access available channels from your CloudXRKit.Session instance","let availableChannels = cxrSession.availableMessageChannels","","\/\/ Each ChannelInfo contains:","\/\/ - channelId: Internal numeric identifier","\/\/ - uuid: Unique identifier as Data (can be converted to string)"]},{"text":"2. Opening a Channel","anchor":"2-Opening-a-Channel","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"To start using a channel, retrieve it from the session:"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Select a channel from available channels","let channelInfo = cxrSession.availableMessageChannels.first","","\/\/ Get the MessageChannel object","if let channel = cxrSession.getMessageChannel(channelInfo) {","    \/\/ Channel is now ready to use","    print(\"Channel status: \\(channel.status)\")","}"]},{"text":"3. Sending Messages","anchor":"3-Sending-Messages","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Send data to the server using the channel:"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Convert your data to Data format","let message = \"Hello Server\"","if let data = message.data(using: .utf8) {","    let success = channel.sendServerMessage(data)","    if success {","        print(\"Message sent successfully\")","    }","}","","\/\/ You can send any binary data","let binaryData = Data([0x01, 0x02, 0x03, 0x04])","channel.sendServerMessage(binaryData)"]},{"text":"4. Receiving Messages","anchor":"4-Receiving-Messages","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Messages from the server are delivered through an AsyncStream:"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Set up a task to receive messages","Task {","    for await messageData in channel.receivedMessageStream {","        \/\/ Process received data","        if let message = String(data: messageData, encoding: .utf8) {","            print(\"Received: \\(message)\")","        } else {","            \/\/ Handle binary data","            print(\"Received \\(messageData.count) bytes\")","        }","    }","    \/\/ Stream ended - channel is closed","    print(\"Channel closed\")","}"]},{"text":"5. Channel Status","anchor":"5-Channel-Status","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Monitor the channel status to ensure proper operation:"}]},{"syntax":"swift","type":"codeListing","code":["switch channel.status {","case .notInitialized:","    print(\"Channel not yet initialized\")","case .ready:","    print(\"Channel ready for communication\")","case .closed:","    print(\"Channel has been closed\")","}"]},{"text":"6. Closing a Channel","anchor":"6-Closing-a-Channel","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Explicitly close a channel when done:"}]},{"syntax":"swift","type":"codeListing","code":["channel.disconnect()"]},{"text":"Complete Example","anchor":"Complete-Example","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Here’s a complete example showing typical usage:"}]},{"syntax":"swift","type":"codeListing","code":["import CloudXRKit","import SwiftUI","","struct MessageChannelExample: View {","    let cxrSession: CloudXRKit.Session","    @State private var currentChannel: MessageChannel?","    @State private var receivedMessages: [String] = []","    @State private var readerTask: Task<Void, Never>?","","    var body: some View {","        VStack {","            \/\/ Channel selection","            if let firstChannel = cxrSession.availableMessageChannels.first {","                Button(\"Open Channel\") {","                    openChannel(firstChannel)","                }","            }","","            \/\/ Send message","            if currentChannel?.status == .ready {","                Button(\"Send Hello\") {","                    sendMessage(\"Hello from client!\")","                }","            }","","            \/\/ Display received messages","            List(receivedMessages, id: \\.self) { message in","                Text(message)","            }","        }","        .onDisappear {","            \/\/ Clean up","            readerTask?.cancel()","            currentChannel?.disconnect()","        }","    }","","    func openChannel(_ channelInfo: ChannelInfo) {","        guard let channel = cxrSession.getMessageChannel(channelInfo) else {","            print(\"Failed to open channel\")","            return","        }","","        currentChannel = channel","","        \/\/ Start receiving messages","        readerTask = Task {","            for await data in channel.receivedMessageStream {","                if let message = String(data: data, encoding: .utf8) {","                    await MainActor.run {","                        receivedMessages.append(message)","                    }","                }","            }","        }","    }","","    func sendMessage(_ text: String) {","        guard let data = text.data(using: .utf8),","              let channel = currentChannel else { return }","","        _ = channel.sendServerMessage(data)","    }","}"]},{"text":"Best Practices","anchor":"Best-Practices","type":"heading","level":2},{"text":"1. Error Handling","anchor":"1-Error-Handling","type":"heading","level":3},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Always check if "},{"type":"codeVoice","code":"getMessageChannel()"},{"type":"text","text":" returns a valid channel"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Verify "},{"type":"codeVoice","code":"sendServerMessage()"},{"type":"text","text":" return value for send confirmation"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Handle channel closure gracefully in your receive loop"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"2. Data Encoding","anchor":"2-Data-Encoding","type":"heading","level":3},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Use consistent encoding between client and server (e.g., UTF-8 for text)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Consider using structured formats (JSON, Protocol Buffers) for complex data"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Handle binary data appropriately"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"3. Resource Management","anchor":"3-Resource-Management","type":"heading","level":3},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Cancel reader tasks when no longer needed"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Disconnect channels explicitly when done"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Monitor channel status changes"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"4. Performance Considerations","anchor":"4-Performance-Considerations","type":"heading","level":3},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Message channels share bandwidth with video\/audio streaming"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Avoid sending large amounts of data frequently"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Consider batching small messages"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Advanced Usage","anchor":"Advanced-Usage","type":"heading","level":2},{"text":"Custom Data Formats","anchor":"Custom-Data-Formats","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"For structured data, consider using JSON:"}]},{"syntax":"swift","type":"codeListing","code":["struct GameState: Codable {","    let playerPosition: SIMD3<Float>","    let score: Int","}","","\/\/ Sending","let gameState = GameState(playerPosition: [1, 2, 3], score: 100)","if let jsonData = try? JSONEncoder().encode(gameState) {","    channel.sendServerMessage(jsonData)","}","","\/\/ Receiving","for await data in channel.receivedMessageStream {","    if let gameState = try? JSONDecoder().decode(GameState.self, from: data) {","        print(\"Player at: \\(gameState.playerPosition), Score: \\(gameState.score)\")","    }","}"]},{"text":"Multiple Channels","anchor":"Multiple-Channels","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can manage multiple channels simultaneously:"}]},{"syntax":"swift","type":"codeListing","code":["var activeChannels: [ChannelInfo: MessageChannel] = [:]","","\/\/ Open multiple channels","for channelInfo in cxrSession.availableMessageChannels {","    if let channel = cxrSession.getMessageChannel(channelInfo) {","        activeChannels[channelInfo] = channel","        \/\/ Set up individual receivers for each channel","    }","}"]},{"text":"Troubleshooting","anchor":"Troubleshooting","type":"heading","level":2},{"text":"Channel Not Available","anchor":"Channel-Not-Available","type":"heading","level":3},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Ensure the server has announced the channel"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Check that the session is in connected state"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Verify the channel UUID matches between client and server"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Messages Not Received","anchor":"Messages-Not-Received","type":"heading","level":3},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Confirm the channel status is "},{"type":"codeVoice","code":".ready"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Check that the receive task is running"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Verify data encoding matches between sender and receiver"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Channel Closes Unexpectedly","anchor":"Channel-Closes-Unexpectedly","type":"heading","level":3},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Monitor server-side logs for errors"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Check network connectivity"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Ensure proper error handling in message processing"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Server-Side Implementation","anchor":"Server-Side-Implementation","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The server implements the XR_NV_opaque_data_channel OpenXR extension, which maps to the client’s MessageChannel API:"}]},{"text":"How Server and Client Connect","anchor":"How-Server-and-Client-Connect","type":"heading","level":3},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Server creates channel"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"xrCreateOpaqueDataChannelNV()"},{"type":"text","text":" with a UUID"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Client discovers channel"}]},{"type":"text","text":": Appears in "},{"type":"codeVoice","code":"availableMessageChannels"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Client opens channel"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"getMessageChannel()"},{"type":"text","text":" initiates connection"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Both wait for ready state"}]},{"type":"text","text":": Server polls for CONNECTED, client for ready"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Exchange messages"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"xrSend\/ReceiveOpaqueDataChannelNV"},{"type":"text","text":" ↔ "},{"type":"codeVoice","code":"sendServerMessage\/receivedMessageStream"}],"type":"paragraph"}]}],"type":"orderedList"},{"text":"Key Differences","anchor":"Key-Differences","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Shutdown vs Destroy","type":"text"}]},{"type":"text","text":":"}]},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"xrShutdownOpaqueDataChannelNV"},{"type":"text","text":": Gracefully closes connection (client sees “closed”)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"xrDestroyOpaqueDataChannelNV"},{"type":"text","text":": Frees resources (must call after shutdown)"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Why Server Waits","type":"text"}]},{"type":"text","text":": Although server creates the channel, it must wait for client connection due to announcement propagation and handshaking."}]},{"text":"Example Pairing","anchor":"Example-Pairing","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Server (C++)","type":"text"}]},{"type":"text","text":":"}]},{"syntax":"c++","type":"codeListing","code":["\/\/ Create with known UUID","xrCreateOpaqueDataChannelNV(instance, &createInfo, &channel);","WaitForConnection(channel);  \/\/ Poll until CONNECTED","xrSendOpaqueDataChannelNV(channel, len, data);"]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Client (Swift)","type":"text"}]},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Find matching UUID","let channel = cxrSession.getMessageChannel(channelInfo)!","channel.sendServerMessage(responseData)"]},{"text":"Summary","anchor":"Summary","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The CloudXR Message Channel API provides a flexible way to extend CloudXR applications with custom communication. By following this guide, you can implement robust bi-directional messaging between your client and server applications."}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.nvidia.CloudXRKit\/documentation\/CloudXRKit\/OpaqueDataChannel"},"sections":[],"hierarchy":{"paths":[["doc:\/\/com.nvidia.CloudXRKit\/documentation\/CloudXRKit"]]},"metadata":{"modules":[{"name":"CloudXRKit"}],"roleHeading":"Article","title":"CloudXR Opaque Data (Message Channel) API User Guide","role":"article"},"variants":[{"paths":["\/documentation\/cloudxrkit\/opaquedatachannel"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/cloudxrkit\/opaquedatachannel"],"traits":[{"interfaceLanguage":"occ"}]}],"references":{"doc://com.nvidia.CloudXRKit/documentation/CloudXRKit":{"url":"\/documentation\/cloudxrkit","abstract":[{"text":"Stream immersive applications.","type":"text"}],"identifier":"doc:\/\/com.nvidia.CloudXRKit\/documentation\/CloudXRKit","type":"topic","role":"collection","title":"CloudXRKit","kind":"symbol"}},"variantOverrides":[{"traits":[{"interfaceLanguage":"occ"}],"patch":[{"op":"replace","value":"occ","path":"\/identifier\/interfaceLanguage"},{"op":"add","value":null,"path":"\/topicSections"},{"op":"add","value":null,"path":"\/seeAlsoSections"}]}]}