{"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"The CloudXR Message Channel API provides a bi-directional communication mechanism between the CloudXR client and server applications. This allows you to send custom data alongside the video\/audio streaming, enabling rich interactions between client and server.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"On the server-side, this requires the app to implement the XR_NV_opaque_data_channel extension. On the client side, the name used for the API is MessageChannel.","type":"text"}],"type":"paragraph"},{"anchor":"Key-Concepts","level":2,"text":"Key Concepts","type":"heading"},{"anchor":"Message-Channels","level":3,"text":"Message Channels","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Channel"}]},{"type":"text","text":": A bi-directional communication pipe identified by a unique UUID"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Channel Info"}]},{"type":"text","text":": Contains channel metadata (ID and UUID)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Channel Status"}]},{"type":"text","text":": Tracks the state of a channel (Not Initialized, Ready, or Closed)"}]}]}],"type":"unorderedList"},{"anchor":"Components","level":3,"text":"Components","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"CloudXRKit.Session"}]},{"type":"text","text":": Manages available channels and provides access to them"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"MessageChannel"}]},{"type":"text","text":": Represents an individual communication channel"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"MessageChannelManager"}]},{"type":"text","text":": Internal component that handles channel lifecycle"}]}]}],"type":"orderedList"},{"anchor":"API-Usage","level":2,"text":"API Usage","type":"heading"},{"anchor":"1-Discovering-Available-Channels","level":3,"text":"1. Discovering Available Channels","type":"heading"},{"inlineContent":[{"text":"Channels are announced by the server. Monitor the session’s ","type":"text"},{"type":"codeVoice","code":"availableMessageChannels"},{"text":" property:","type":"text"}],"type":"paragraph"},{"code":["\/\/ Access available channels from your CloudXRKit.Session instance","let availableChannels = cxrSession.availableMessageChannels","","\/\/ Each ChannelInfo contains:","\/\/ - channelId: Internal numeric identifier","\/\/ - uuid: Unique identifier as Data (can be converted to string)"],"syntax":"swift","type":"codeListing"},{"anchor":"2-Opening-a-Channel","level":3,"text":"2. Opening a Channel","type":"heading"},{"inlineContent":[{"text":"To start using a channel, retrieve it from the session:","type":"text"}],"type":"paragraph"},{"code":["\/\/ Select a channel from available channels","let channelInfo = cxrSession.availableMessageChannels.first","","\/\/ Get the MessageChannel object","if let channel = cxrSession.getMessageChannel(channelInfo) {","    \/\/ Channel is now ready to use","    print(\"Channel status: \\(channel.status)\")","}"],"syntax":"swift","type":"codeListing"},{"anchor":"3-Sending-Messages","level":3,"text":"3. Sending Messages","type":"heading"},{"inlineContent":[{"text":"Send data to the server using the channel:","type":"text"}],"type":"paragraph"},{"code":["\/\/ Convert your data to Data format","let message = \"Hello Server\"","if let data = message.data(using: .utf8) {","    let success = channel.sendServerMessage(data)","    if success {","        print(\"Message sent successfully\")","    }","}","","\/\/ You can send any binary data","let binaryData = Data([0x01, 0x02, 0x03, 0x04])","channel.sendServerMessage(binaryData)"],"syntax":"swift","type":"codeListing"},{"anchor":"4-Receiving-Messages","level":3,"text":"4. Receiving Messages","type":"heading"},{"inlineContent":[{"text":"Messages from the server are delivered through an AsyncStream:","type":"text"}],"type":"paragraph"},{"code":["\/\/ Set up a task to receive messages","Task {","    for await messageData in channel.receivedMessageStream {","        \/\/ Process received data","        if let message = String(data: messageData, encoding: .utf8) {","            print(\"Received: \\(message)\")","        } else {","            \/\/ Handle binary data","            print(\"Received \\(messageData.count) bytes\")","        }","    }","    \/\/ Stream ended - channel is closed","    print(\"Channel closed\")","}"],"syntax":"swift","type":"codeListing"},{"anchor":"5-Channel-Status","level":3,"text":"5. Channel Status","type":"heading"},{"inlineContent":[{"text":"Monitor the channel status to ensure proper operation:","type":"text"}],"type":"paragraph"},{"code":["switch channel.status {","case .notInitialized:","    print(\"Channel not yet initialized\")","case .ready:","    print(\"Channel ready for communication\")","case .closed:","    print(\"Channel has been closed\")","}"],"syntax":"swift","type":"codeListing"},{"anchor":"6-Closing-a-Channel","level":3,"text":"6. Closing a Channel","type":"heading"},{"inlineContent":[{"text":"Explicitly close a channel when done:","type":"text"}],"type":"paragraph"},{"code":["channel.disconnect()"],"syntax":"swift","type":"codeListing"},{"anchor":"Complete-Example","level":2,"text":"Complete Example","type":"heading"},{"inlineContent":[{"text":"Here’s a complete example showing typical usage:","type":"text"}],"type":"paragraph"},{"code":["import CloudXRKit","import SwiftUI","","struct MessageChannelExample: View {","    let cxrSession: CloudXRKit.Session","    @State private var currentChannel: MessageChannel?","    @State private var receivedMessages: [String] = []","    @State private var readerTask: Task<Void, Never>?","","    var body: some View {","        VStack {","            \/\/ Channel selection","            if let firstChannel = cxrSession.availableMessageChannels.first {","                Button(\"Open Channel\") {","                    openChannel(firstChannel)","                }","            }","","            \/\/ Send message","            if currentChannel?.status == .ready {","                Button(\"Send Hello\") {","                    sendMessage(\"Hello from client!\")","                }","            }","","            \/\/ Display received messages","            List(receivedMessages, id: \\.self) { message in","                Text(message)","            }","        }","        .onDisappear {","            \/\/ Clean up","            readerTask?.cancel()","            currentChannel?.disconnect()","        }","    }","","    func openChannel(_ channelInfo: ChannelInfo) {","        guard let channel = cxrSession.getMessageChannel(channelInfo) else {","            print(\"Failed to open channel\")","            return","        }","","        currentChannel = channel","","        \/\/ Start receiving messages","        readerTask = Task {","            for await data in channel.receivedMessageStream {","                if let message = String(data: data, encoding: .utf8) {","                    await MainActor.run {","                        receivedMessages.append(message)","                    }","                }","            }","        }","    }","","    func sendMessage(_ text: String) {","        guard let data = text.data(using: .utf8),","              let channel = currentChannel else { return }","","        _ = channel.sendServerMessage(data)","    }","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Best-Practices","level":2,"text":"Best Practices","type":"heading"},{"anchor":"1-Error-Handling","level":3,"text":"1. Error Handling","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Always check if "},{"code":"getMessageChannel()","type":"codeVoice"},{"type":"text","text":" returns a valid channel"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify "},{"code":"sendServerMessage()","type":"codeVoice"},{"type":"text","text":" return value for send confirmation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Handle channel closure gracefully in your receive loop"}]}]}],"type":"unorderedList"},{"anchor":"2-Data-Encoding","level":3,"text":"2. Data Encoding","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use consistent encoding between client and server (e.g., UTF-8 for text)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Consider using structured formats (JSON, Protocol Buffers) for complex data"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Handle binary data appropriately"}]}]}],"type":"unorderedList"},{"anchor":"3-Resource-Management","level":3,"text":"3. Resource Management","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cancel reader tasks when no longer needed"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Disconnect channels explicitly when done"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Monitor channel status changes"}]}]}],"type":"unorderedList"},{"anchor":"4-Performance-Considerations","level":3,"text":"4. Performance Considerations","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Message channels share bandwidth with video\/audio streaming"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Avoid sending large amounts of data frequently"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Consider batching small messages"}]}]}],"type":"unorderedList"},{"anchor":"Advanced-Usage","level":2,"text":"Advanced Usage","type":"heading"},{"anchor":"Custom-Data-Formats","level":3,"text":"Custom Data Formats","type":"heading"},{"inlineContent":[{"text":"For structured data, consider using JSON:","type":"text"}],"type":"paragraph"},{"code":["struct GameState: Codable {","    let playerPosition: SIMD3<Float>","    let score: Int","}","","\/\/ Sending","let gameState = GameState(playerPosition: [1, 2, 3], score: 100)","if let jsonData = try? JSONEncoder().encode(gameState) {","    channel.sendServerMessage(jsonData)","}","","\/\/ Receiving","for await data in channel.receivedMessageStream {","    if let gameState = try? JSONDecoder().decode(GameState.self, from: data) {","        print(\"Player at: \\(gameState.playerPosition), Score: \\(gameState.score)\")","    }","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Multiple-Channels","level":3,"text":"Multiple Channels","type":"heading"},{"inlineContent":[{"type":"text","text":"You can manage multiple channels simultaneously:"}],"type":"paragraph"},{"code":["var activeChannels: [ChannelInfo: MessageChannel] = [:]","","\/\/ Open multiple channels","for channelInfo in cxrSession.availableMessageChannels {","    if let channel = cxrSession.getMessageChannel(channelInfo) {","        activeChannels[channelInfo] = channel","        \/\/ Set up individual receivers for each channel","    }","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Troubleshooting","level":2,"text":"Troubleshooting","type":"heading"},{"anchor":"Channel-Not-Available","level":3,"text":"Channel Not Available","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensure the server has announced the channel"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Check that the session is in connected state"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify the channel UUID matches between client and server"}]}]}],"type":"unorderedList"},{"anchor":"Messages-Not-Received","level":3,"text":"Messages Not Received","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Confirm the channel status is "},{"type":"codeVoice","code":".ready"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Check that the receive task is running"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify data encoding matches between sender and receiver"}]}]}],"type":"unorderedList"},{"anchor":"Channel-Closes-Unexpectedly","level":3,"text":"Channel Closes Unexpectedly","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Monitor server-side logs for errors"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Check network connectivity"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensure proper error handling in message processing"}]}]}],"type":"unorderedList"},{"anchor":"Server-Side-Implementation","level":2,"text":"Server-Side Implementation","type":"heading"},{"inlineContent":[{"type":"text","text":"The server implements the XR_NV_opaque_data_channel OpenXR extension, which maps to the client’s MessageChannel API:"}],"type":"paragraph"},{"anchor":"How-Server-and-Client-Connect","level":3,"text":"How Server and Client Connect","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Server creates channel","type":"text"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"xrCreateOpaqueDataChannelNV()"},{"type":"text","text":" with a UUID"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Client discovers channel","type":"text"}]},{"type":"text","text":": Appears in "},{"type":"codeVoice","code":"availableMessageChannels"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Client opens channel","type":"text"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"getMessageChannel()"},{"type":"text","text":" initiates connection"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Both wait for ready state","type":"text"}]},{"type":"text","text":": Server polls for CONNECTED, client for ready"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Exchange messages","type":"text"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"xrSend\/ReceiveOpaqueDataChannelNV"},{"type":"text","text":" ↔ "},{"type":"codeVoice","code":"sendServerMessage\/receivedMessageStream"}]}]}],"type":"orderedList"},{"anchor":"Key-Differences","level":3,"text":"Key Differences","type":"heading"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Shutdown vs Destroy"}]},{"type":"text","text":":"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"xrShutdownOpaqueDataChannelNV"},{"type":"text","text":": Gracefully closes connection (client sees “closed”)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"xrDestroyOpaqueDataChannelNV"},{"type":"text","text":": Frees resources (must call after shutdown)"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Why Server Waits"}]},{"type":"text","text":": Although server creates the channel, it must wait for client connection due to announcement propagation and handshaking."}],"type":"paragraph"},{"anchor":"Example-Pairing","level":3,"text":"Example Pairing","type":"heading"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Server (C++)"}]},{"type":"text","text":":"}],"type":"paragraph"},{"code":["\/\/ Create with known UUID","xrCreateOpaqueDataChannelNV(instance, &createInfo, &channel);","WaitForConnection(channel);  \/\/ Poll until CONNECTED","xrSendOpaqueDataChannelNV(channel, len, data);"],"syntax":"c++","type":"codeListing"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Client (Swift)"}]},{"type":"text","text":":"}],"type":"paragraph"},{"code":["\/\/ Find matching UUID","let channel = cxrSession.getMessageChannel(channelInfo)!","channel.sendServerMessage(responseData)"],"syntax":"swift","type":"codeListing"},{"anchor":"Summary","level":2,"text":"Summary","type":"heading"},{"inlineContent":[{"type":"text","text":"The CloudXR Message Channel API provides a flexible way to extend CloudXR applications with custom communication. By following this guide, you can implement robust bi-directional messaging between your client and server applications."}],"type":"paragraph"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.nvidia.CloudXRKit\/documentation\/CloudXRKit\/OpaqueDataChannel"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/cloudxrkit\/opaquedatachannel"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/cloudxrkit\/opaquedatachannel"]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/com.nvidia.CloudXRKit\/documentation\/CloudXRKit"]]},"metadata":{"roleHeading":"Article","title":"CloudXR Opaque Data (Message Channel) API User Guide","role":"article","modules":[{"name":"CloudXRKit"}]},"references":{"doc://com.nvidia.CloudXRKit/documentation/CloudXRKit":{"role":"collection","abstract":[{"type":"text","text":"Stream immersive applications."}],"type":"topic","title":"CloudXRKit","kind":"symbol","identifier":"doc:\/\/com.nvidia.CloudXRKit\/documentation\/CloudXRKit","url":"\/documentation\/cloudxrkit"}},"variantOverrides":[{"patch":[{"value":"occ","op":"replace","path":"\/identifier\/interfaceLanguage"},{"path":"\/topicSections","value":null,"op":"add"},{"path":"\/seeAlsoSections","value":null,"op":"add"}],"traits":[{"interfaceLanguage":"occ"}]}]}