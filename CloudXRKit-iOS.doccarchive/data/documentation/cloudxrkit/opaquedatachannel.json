{"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/com.nvidia.CloudXRKit\/documentation\/CloudXRKit"]]},"kind":"article","identifier":{"url":"doc:\/\/com.nvidia.CloudXRKit\/documentation\/CloudXRKit\/OpaqueDataChannel","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The CloudXR Message Channel API provides a bi-directional communication mechanism between the CloudXR client and server applications. This allows you to send custom data alongside the video\/audio streaming, enabling rich interactions between client and server.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On the server-side, this requires the app to implement the XR_NV_opaque_data_channel extension. On the client side, the name used for the API is MessageChannel."}]},{"type":"heading","level":2,"anchor":"Key-Concepts","text":"Key Concepts"},{"type":"heading","level":3,"anchor":"Message-Channels","text":"Message Channels"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Channel","type":"text"}],"type":"strong"},{"text":": A bi-directional communication pipe identified by a unique UUID","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Channel Info"}]},{"type":"text","text":": Contains channel metadata (ID and UUID)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Channel Status","type":"text"}],"type":"strong"},{"text":": Tracks the state of a channel (Not Initialized, Ready, or Closed)","type":"text"}]}]}]},{"type":"heading","level":3,"anchor":"Components","text":"Components"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"CloudXRKit.Session","type":"text"}]},{"text":": Manages available channels and provides access to them","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"MessageChannel"}],"type":"strong"},{"type":"text","text":": Represents an individual communication channel"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"MessageChannelManager"}],"type":"strong"},{"type":"text","text":": Internal component that handles channel lifecycle"}],"type":"paragraph"}]}]},{"type":"heading","level":2,"anchor":"API-Usage","text":"API Usage"},{"type":"heading","level":3,"anchor":"1-Discovering-Available-Channels","text":"1. Discovering Available Channels"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Channels are announced by the server. Monitor the session’s "},{"code":"availableMessageChannels","type":"codeVoice"},{"type":"text","text":" property:"}]},{"code":["\/\/ Access available channels from your CloudXRKit.Session instance","let availableChannels = cxrSession.availableMessageChannels","","\/\/ Each ChannelInfo contains:","\/\/ - channelId: Internal numeric identifier","\/\/ - uuid: Unique identifier as Data (can be converted to string)"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":3,"anchor":"2-Opening-a-Channel","text":"2. Opening a Channel"},{"type":"paragraph","inlineContent":[{"text":"To start using a channel, retrieve it from the session:","type":"text"}]},{"code":["\/\/ Select a channel from available channels","let channelInfo = cxrSession.availableMessageChannels.first","","\/\/ Get the MessageChannel object","if let channel = cxrSession.getMessageChannel(channelInfo) {","    \/\/ Channel is now ready to use","    print(\"Channel status: \\(channel.status)\")","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":3,"anchor":"3-Sending-Messages","text":"3. Sending Messages"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Send data to the server using the channel:"}]},{"code":["\/\/ Convert your data to Data format","let message = \"Hello Server\"","if let data = message.data(using: .utf8) {","    let success = channel.sendServerMessage(data)","    if success {","        print(\"Message sent successfully\")","    }","}","","\/\/ You can send any binary data","let binaryData = Data([0x01, 0x02, 0x03, 0x04])","channel.sendServerMessage(binaryData)"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":3,"anchor":"4-Receiving-Messages","text":"4. Receiving Messages"},{"type":"paragraph","inlineContent":[{"text":"Messages from the server are delivered through an AsyncStream:","type":"text"}]},{"code":["\/\/ Set up a task to receive messages","Task {","    for await messageData in channel.receivedMessageStream {","        \/\/ Process received data","        if let message = String(data: messageData, encoding: .utf8) {","            print(\"Received: \\(message)\")","        } else {","            \/\/ Handle binary data","            print(\"Received \\(messageData.count) bytes\")","        }","    }","    \/\/ Stream ended - channel is closed","    print(\"Channel closed\")","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":3,"anchor":"5-Channel-Status","text":"5. Channel Status"},{"type":"paragraph","inlineContent":[{"text":"Monitor the channel status to ensure proper operation:","type":"text"}]},{"code":["switch channel.status {","case .notInitialized:","    print(\"Channel not yet initialized\")","case .ready:","    print(\"Channel ready for communication\")","case .closed:","    print(\"Channel has been closed\")","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":3,"anchor":"6-Closing-a-Channel","text":"6. Closing a Channel"},{"type":"paragraph","inlineContent":[{"text":"Explicitly close a channel when done:","type":"text"}]},{"code":["channel.disconnect()"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":2,"anchor":"Complete-Example","text":"Complete Example"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Here’s a complete example showing typical usage:"}]},{"code":["import CloudXRKit","import SwiftUI","","struct MessageChannelExample: View {","    let cxrSession: CloudXRKit.Session","    @State private var currentChannel: MessageChannel?","    @State private var receivedMessages: [String] = []","    @State private var readerTask: Task<Void, Never>?","","    var body: some View {","        VStack {","            \/\/ Channel selection","            if let firstChannel = cxrSession.availableMessageChannels.first {","                Button(\"Open Channel\") {","                    openChannel(firstChannel)","                }","            }","","            \/\/ Send message","            if currentChannel?.status == .ready {","                Button(\"Send Hello\") {","                    sendMessage(\"Hello from client!\")","                }","            }","","            \/\/ Display received messages","            List(receivedMessages, id: \\.self) { message in","                Text(message)","            }","        }","        .onDisappear {","            \/\/ Clean up","            readerTask?.cancel()","            currentChannel?.disconnect()","        }","    }","","    func openChannel(_ channelInfo: ChannelInfo) {","        guard let channel = cxrSession.getMessageChannel(channelInfo) else {","            print(\"Failed to open channel\")","            return","        }","","        currentChannel = channel","","        \/\/ Start receiving messages","        readerTask = Task {","            for await data in channel.receivedMessageStream {","                if let message = String(data: data, encoding: .utf8) {","                    await MainActor.run {","                        receivedMessages.append(message)","                    }","                }","            }","        }","    }","","    func sendMessage(_ text: String) {","        guard let data = text.data(using: .utf8),","              let channel = currentChannel else { return }","","        _ = channel.sendServerMessage(data)","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":2,"anchor":"Best-Practices","text":"Best Practices"},{"type":"heading","level":3,"anchor":"1-Error-Handling","text":"1. Error Handling"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Always check if "},{"type":"codeVoice","code":"getMessageChannel()"},{"type":"text","text":" returns a valid channel"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Verify ","type":"text"},{"code":"sendServerMessage()","type":"codeVoice"},{"text":" return value for send confirmation","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Handle channel closure gracefully in your receive loop"}]}]}]},{"type":"heading","level":3,"anchor":"2-Data-Encoding","text":"2. Data Encoding"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Use consistent encoding between client and server (e.g., UTF-8 for text)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Consider using structured formats (JSON, Protocol Buffers) for complex data","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Handle binary data appropriately","type":"text"}]}]}]},{"type":"heading","level":3,"anchor":"3-Resource-Management","text":"3. Resource Management"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Cancel reader tasks when no longer needed"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Disconnect channels explicitly when done","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Monitor channel status changes"}],"type":"paragraph"}]}]},{"type":"heading","level":3,"anchor":"4-Performance-Considerations","text":"4. Performance Considerations"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Message channels share bandwidth with video\/audio streaming"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Avoid sending large amounts of data frequently"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Consider batching small messages","type":"text"}]}]}]},{"anchor":"Advanced-Usage","type":"heading","text":"Advanced Usage","level":2},{"anchor":"Custom-Data-Formats","type":"heading","text":"Custom Data Formats","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"For structured data, consider using JSON:"}]},{"syntax":"swift","code":["struct GameState: Codable {","    let playerPosition: SIMD3<Float>","    let score: Int","}","","\/\/ Sending","let gameState = GameState(playerPosition: [1, 2, 3], score: 100)","if let jsonData = try? JSONEncoder().encode(gameState) {","    channel.sendServerMessage(jsonData)","}","","\/\/ Receiving","for await data in channel.receivedMessageStream {","    if let gameState = try? JSONDecoder().decode(GameState.self, from: data) {","        print(\"Player at: \\(gameState.playerPosition), Score: \\(gameState.score)\")","    }","}"],"type":"codeListing"},{"anchor":"Multiple-Channels","type":"heading","text":"Multiple Channels","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can manage multiple channels simultaneously:"}]},{"syntax":"swift","code":["var activeChannels: [ChannelInfo: MessageChannel] = [:]","","\/\/ Open multiple channels","for channelInfo in cxrSession.availableMessageChannels {","    if let channel = cxrSession.getMessageChannel(channelInfo) {","        activeChannels[channelInfo] = channel","        \/\/ Set up individual receivers for each channel","    }","}"],"type":"codeListing"},{"anchor":"Troubleshooting","type":"heading","text":"Troubleshooting","level":2},{"anchor":"Channel-Not-Available","type":"heading","text":"Channel Not Available","level":3},{"items":[{"content":[{"inlineContent":[{"text":"Ensure the server has announced the channel","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Check that the session is in connected state"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify the channel UUID matches between client and server"}]}]}],"type":"unorderedList"},{"anchor":"Messages-Not-Received","type":"heading","text":"Messages Not Received","level":3},{"items":[{"content":[{"inlineContent":[{"text":"Confirm the channel status is ","type":"text"},{"code":".ready","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Check that the receive task is running"}]}]},{"content":[{"inlineContent":[{"text":"Verify data encoding matches between sender and receiver","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Channel-Closes-Unexpectedly","type":"heading","text":"Channel Closes Unexpectedly","level":3},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Monitor server-side logs for errors"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Check network connectivity","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Ensure proper error handling in message processing","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Server-Side-Implementation","type":"heading","text":"Server-Side Implementation","level":2},{"type":"paragraph","inlineContent":[{"text":"The server implements the XR_NV_opaque_data_channel OpenXR extension, which maps to the client’s MessageChannel API:","type":"text"}]},{"anchor":"How-Server-and-Client-Connect","type":"heading","text":"How Server and Client Connect","level":3},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Server creates channel"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"xrCreateOpaqueDataChannelNV()"},{"type":"text","text":" with a UUID"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Client discovers channel"}]},{"type":"text","text":": Appears in "},{"type":"codeVoice","code":"availableMessageChannels"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Client opens channel"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"getMessageChannel()"},{"type":"text","text":" initiates connection"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Both wait for ready state","type":"text"}],"type":"strong"},{"text":": Server polls for CONNECTED, client for ready","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Exchange messages"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"xrSend\/ReceiveOpaqueDataChannelNV"},{"type":"text","text":" ↔ "},{"type":"codeVoice","code":"sendServerMessage\/receivedMessageStream"}]}]}],"type":"orderedList"},{"anchor":"Key-Differences","type":"heading","text":"Key Differences","level":3},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Shutdown vs Destroy","type":"text"}]},{"type":"text","text":":"}]},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"xrShutdownOpaqueDataChannelNV"},{"type":"text","text":": Gracefully closes connection (client sees “closed”)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"xrDestroyOpaqueDataChannelNV"},{"type":"text","text":": Frees resources (must call after shutdown)"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Why Server Waits","type":"text"}],"type":"strong"},{"type":"text","text":": Although server creates the channel, it must wait for client connection due to announcement propagation and handshaking."}]},{"anchor":"Example-Pairing","type":"heading","text":"Example Pairing","level":3},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Server (C++)","type":"text"}]},{"text":":","type":"text"}]},{"syntax":"c++","code":["\/\/ Create with known UUID","xrCreateOpaqueDataChannelNV(instance, &createInfo, &channel);","WaitForConnection(channel);  \/\/ Poll until CONNECTED","xrSendOpaqueDataChannelNV(channel, len, data);"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Client (Swift)","type":"text"}]},{"type":"text","text":":"}]},{"syntax":"swift","code":["\/\/ Find matching UUID","let channel = cxrSession.getMessageChannel(channelInfo)!","channel.sendServerMessage(responseData)"],"type":"codeListing"},{"anchor":"Summary","type":"heading","text":"Summary","level":2},{"type":"paragraph","inlineContent":[{"text":"The CloudXR Message Channel API provides a flexible way to extend CloudXR applications with custom communication. By following this guide, you can implement robust bi-directional messaging between your client and server applications.","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/cloudxrkit\/opaquedatachannel"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/cloudxrkit\/opaquedatachannel"]}],"metadata":{"modules":[{"name":"CloudXRKit"}],"title":"CloudXR Opaque Data (Message Channel) API User Guide","roleHeading":"Article","role":"article"},"references":{"doc://com.nvidia.CloudXRKit/documentation/CloudXRKit":{"role":"collection","type":"topic","url":"\/documentation\/cloudxrkit","kind":"symbol","abstract":[{"type":"text","text":"Stream immersive applications."}],"title":"CloudXRKit","identifier":"doc:\/\/com.nvidia.CloudXRKit\/documentation\/CloudXRKit"}},"variantOverrides":[{"patch":[{"op":"replace","value":"occ","path":"\/identifier\/interfaceLanguage"},{"op":"add","value":null,"path":"\/topicSections"},{"op":"add","value":null,"path":"\/seeAlsoSections"}],"traits":[{"interfaceLanguage":"occ"}]}]}