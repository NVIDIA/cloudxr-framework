{"identifier":{"url":"doc:\/\/com.nvidia.CloudXRKit\/documentation\/CloudXRKit\/WindowManagement","interfaceLanguage":"swift"},"metadata":{"title":"Window State Manager Implementation Guide for CloudXRKit Apps","modules":[{"name":"CloudXRKit"}],"roleHeading":"Article","role":"article"},"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"This guide provides technical instructions for implementing a Window State Manager in visionOS applications using CloudXRKit. The Window State Manager ensures users can always recover the UI if accidentally dismissed during immersive CloudXR sessions.","type":"text"}]},{"type":"heading","text":"Prerequisites","level":2,"anchor":"Prerequisites"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To use this implementation, you’ll need:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A visionOS app using CloudXRKit"}]}]},{"content":[{"inlineContent":[{"text":"SwiftUI-based UI with WindowGroup and ImmersiveSpace scenes","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A CloudXRKit.Session instance for streaming","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Your own content view and streaming view implementations","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","text":"Architecture Overview","level":2,"anchor":"Architecture-Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Window State Manager coordinates between:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"SwiftUI Window lifecycle events"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"ImmersiveSpace lifecycle events"}]}]},{"content":[{"inlineContent":[{"text":"CloudXRKit session state changes (using CloudXRKit.SessionState)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"User interactions (gestures, system controls)","type":"text"}]}]}]},{"code":["┌─────────────────────────────────────────────────────────────────────────┐","│                              Your visionOS App                          │","├─────────────────────────────────────────────────────────────────────────┤","│                                                                         │","│  ┌─────────────────┐                           ┌────────────────────┐   │","│  │   WindowGroup   │                           │  ImmersiveSpace    │   │","│  │                 │                           │                    │   │","│  │  ┌───────────┐  │                           │  ┌──────────────┐  │   │","│  │  │ onAppear  │  │                           │  │  onAppear    │  │   │","│  │  │onDisappear│  │                           │  │ onDisappear  │  │   │","│  │  └─────┬─────┘  │                           │  └──────┬───────┘  │   │","│  └────────┼────────┘                           └─────────┼──────────┘   │","│           │                                              │              │","│           │         ┌──────────────────────────┐         │              │","│           └────────▶│                          │◀────────┘              │","│                     │   WindowStateManager     │                        │","│                     │                          │                        │","│  ┌─────────────┐    │  • windowVisible         │    ┌───────────────┐   │","│  │   Scene     │───▶│  • immersiveSpaceActive  │◀───│ User Gestures │   │","│  │   Phase     │    │  • sessionState          │    │ (Triple-tap)  │   │","│  └─────────────┘    │  • configured            │    └───────────────┘   │","│                     │                          │                        │","│  ┌─────────────┐    │  Recovery Logic:         │    ┌───────────────┐   │","│  │ CloudXRKit  │───▶│  • Crown press           │◀───│ System Events │   │","│  │   Session   │    │  • Disconnection         │    │ (Crown press) │   │","│  │   State     │    │  • Scene changes         │    └───────────────┘   │","│  └─────────────┘    └──────────────────────────┘                        │","│                                                                         │","└─────────────────────────────────────────────────────────────────────────┘"],"type":"codeListing","syntax":null},{"type":"heading","text":"Core Components","level":2,"anchor":"Core-Components"},{"type":"heading","text":"1. Window State Manager Class","level":3,"anchor":"1-Window-State-Manager-Class"},{"code":["import SwiftUI","import CloudXRKit","import os.log","","#if os(visionOS)","class WindowStateManager: ObservableObject {","    \/\/ Window state tracking","    private var windowVisible = false","    private var immersiveSpaceActive = false","    private var configured = false","","    \/\/ Session state tracking (using CloudXRKit.SessionState)","    @Published private(set) var sessionState: CloudXRKit.SessionState = .disconnected","    private var pauseOnImmersiveSpaceDismissed = true","","    \/\/ Configuration options","    var debugHideWindowAtConnection = false","","    \/\/ SwiftUI Actions","    private var openImmersiveSpace: OpenImmersiveSpaceAction!","    private var dismissImmersiveSpace: DismissImmersiveSpaceAction!","    private var openWindow: OpenWindowAction!","    private var dismissWindow: DismissWindowAction!","","    \/\/ Callbacks for session control","    var onSessionPauseRequested: (() -> Void)?","    var onSessionResumeRequested: (() async throws -> Void)?","","    \/\/ Thread safety","    private var lock = OSAllocatedUnfairLock()","    private static let logger = Logger()","","    \/\/ Window IDs","    private let launchWindowId = \"LaunchWindow\"","    private let immersiveSpaceId = \"ImmersiveSpace\"","}","#endif"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"1.1 Complete WindowStateManager Implementation","level":3,"anchor":"11-Complete-WindowStateManager-Implementation"},{"type":"paragraph","inlineContent":[{"text":"Here’s the full implementation that can be used in any CloudXRKit-based application:","type":"text"}]},{"code":["extension WindowStateManager {","    \/\/ MARK: - Window Lifecycle","","    func windowOnAppear(openImmersiveSpace: OpenImmersiveSpaceAction,","                        dismissImmersiveSpace: DismissImmersiveSpaceAction,","                        openWindow: OpenWindowAction,","                        dismissWindow: DismissWindowAction) {","        guard !windowVisible else {","            Self.logger.error(\"windowOnAppear called while window already open\")","            return","        }","","        if !configured {","            self.openImmersiveSpace = openImmersiveSpace","            self.dismissImmersiveSpace = dismissImmersiveSpace","            self.openWindow = openWindow","            self.dismissWindow = dismissWindow","            configured = true","        }","","        windowVisible = true","    }","","    func windowOnDisappear() {","        guard windowVisible else {","            Self.logger.error(\"windowOnDisappear called when window is already dismissed\")","            return","        }","        windowVisible = false","    }","","    \/\/ MARK: - Scene Phase Management","","    func windowOnScenePhaseChange(scenePhase: ScenePhase) {","        guard configured else {","            Self.logger.error(\"Window manager not configured when scene phase changed\")","            return","        }","","        switch scenePhase {","        case .inactive:","            if windowVisible {","                dismissWindow(id: launchWindowId)","            }","        case .active:","            if sessionState == .paused {","                Task { @MainActor in","                    try? await onSessionResumeRequested?()","                    if !immersiveSpaceActive {","                        await openImmersiveSpace(id: immersiveSpaceId)","                    }","                }","            }","        case .background:","            dismissImmersiveSpaceIfOpen()","        @unknown default:","            break","        }","    }","","    \/\/ MARK: - Immersive Space Lifecycle","","    func immersiveSpaceOnAppear() {","        guard !immersiveSpaceActive else {","            Self.logger.error(\"Immersive space was already active when onAppear was called\")","            return","        }","        immersiveSpaceActive = true","    }","","    func immersiveSpaceOnDisappear() {","        guard immersiveSpaceActive else {","            Self.logger.error(\"Immersive space state incorrect on disappear\")","            return","        }","","        guard configured else {","            Self.logger.error(\"Window manager not configured when immersive space disappeared\")","            return","        }","","        immersiveSpaceActive = false","","        \/\/ RECOVERY MECHANISM: Restore window when exiting immersive space","        if windowVisible == false {","            openWindow(id: launchWindowId)","        }","","        \/\/ Handle session state","        switch sessionState {","        case .disconnecting, .disconnected, .initialized, .pausing, .paused:","            return","        default:","            if pauseOnImmersiveSpaceDismissed {","                onSessionPauseRequested?()","            }","        }","    }","","    \/\/ MARK: - Session State Management","","    func onSessionStateChanged(oldState: CloudXRKit.SessionState, newState: CloudXRKit.SessionState) async {","        sessionState = newState","","        switch newState {","        case .connected:","            await handleConnectionEstablished()","        case .disconnected:","            await handleDisconnection()","        default:","            return","        }","    }","","    \/\/ MARK: - Window Control","","    func toggleWindow() {","        guard configured else {","            Self.logger.error(\"Window manager is not configured when toggling the window\")","            return","        }","","        if windowVisible {","            dismissWindow(id: launchWindowId)","        } else {","            openWindow(id: launchWindowId)","        }","    }","","    func dismissImmersiveSpaceIfOpen() {","        if immersiveSpaceActive {","            Task { @MainActor in","                await dismissImmersiveSpace()","            }","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"2. SwiftUI Event Hookup Points","level":3,"anchor":"2-SwiftUI-Event-Hookup-Points"},{"type":"heading","text":"2.1 App Entry Point Configuration","level":4,"anchor":"21-App-Entry-Point-Configuration"},{"type":"paragraph","inlineContent":[{"text":"In your app’s main ","type":"text"},{"type":"codeVoice","code":"App"},{"text":" struct:","type":"text"}]},{"code":["@main","struct YourApp: App {","    @StateObject private var windowManager = WindowStateManager()","    @State private var cxrSession = CloudXRKit.Session(config: CloudXRKit.Config())","    @Environment(\\.openWindow) var openWindow","    @Environment(\\.dismissWindow) var dismissWindow","    @Environment(\\.openImmersiveSpace) var openImmersiveSpace","    @Environment(\\.dismissImmersiveSpace) var dismissImmersiveSpace","    @Environment(\\.scenePhase) var scenePhase","","    var body: some Scene {","        WindowGroup(id: \"LaunchWindow\") {","            YourContentView() \/\/ Your app's main UI","                .onAppear {","                    \/\/ Configure window manager with SwiftUI actions","                    windowManager.windowOnAppear(","                        openImmersiveSpace: openImmersiveSpace,","                        dismissImmersiveSpace: dismissImmersiveSpace,","                        openWindow: openWindow,","                        dismissWindow: dismissWindow","                    )","","                    \/\/ Set up session callbacks","                    windowManager.onSessionPauseRequested = {","                        cxrSession.pause()","                    }","","                    windowManager.onSessionResumeRequested = {","                        try await cxrSession.resume()","                    }","                }","                .onDisappear {","                    windowManager.windowOnDisappear()","                }","                .onChange(of: scenePhase) { _, newPhase in","                    windowManager.windowOnScenePhaseChange(scenePhase: newPhase)","                }","                .onChange(of: cxrSession.state) { oldState, newState in","                    Task {","                        await windowManager.onSessionStateChanged(","                            oldState: oldState,","                            newState: newState","                        )","                    }","                }","        }","        .environmentObject(windowManager)","","        ImmersiveSpace(id: \"ImmersiveSpace\") {","            YourStreamingView(cxrSession: cxrSession) \/\/ Your CloudXR streaming view","                .onAppear {","                    windowManager.immersiveSpaceOnAppear()","                }","                .onDisappear {","                    windowManager.immersiveSpaceOnDisappear()","                }","                .onTapGesture(count: 3) {","                    \/\/ RECOVERY MECHANISM: Triple-tap to toggle window","                    windowManager.toggleWindow()","                }","        }","        .environmentObject(windowManager)","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Note"}],"type":"strong"},{"text":": ","type":"text"},{"type":"codeVoice","code":"YourStreamingView"},{"text":" should be your implementation that displays CloudXR content using the CloudXRKit session. This typically involves creating a RealityKit view that renders the streamed content.","type":"text"}],"type":"paragraph"}]},{"type":"heading","text":"Event Flow and Handling","level":2,"anchor":"Event-Flow-and-Handling"},{"type":"heading","text":"3. Window Lifecycle Events","level":3,"anchor":"3-Window-Lifecycle-Events"},{"type":"heading","text":"3.1 Window Appearance","level":4,"anchor":"31-Window-Appearance"},{"code":["func windowOnAppear(openImmersiveSpace: OpenImmersiveSpaceAction,","                    dismissImmersiveSpace: DismissImmersiveSpaceAction,","                    openWindow: OpenWindowAction,","                    dismissWindow: DismissWindowAction) {","    \/\/ Step 1: Validate state","    guard !windowVisible else {","        Self.logger.error(\"windowOnAppear called while window already open\")","        return","    }","","    \/\/ Step 2: Configure dependencies (first time only)","    if !configured {","        self.openImmersiveSpace = openImmersiveSpace","        self.dismissImmersiveSpace = dismissImmersiveSpace","        self.openWindow = openWindow","        self.dismissWindow = dismissWindow","        configured = true","    }","","    \/\/ Step 3: Update state","    windowVisible = true","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"3.2 Window Disappearance","level":4,"anchor":"32-Window-Disappearance"},{"code":["func windowOnDisappear() {","    guard windowVisible else {","        fatalError(\"windowOnDisappear called when window is already dismissed\")","    }","    windowVisible = false","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"4. Scene Phase Changes","level":3,"anchor":"4-Scene-Phase-Changes"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The scene phase handler manages app lifecycle transitions:"}]},{"code":["func windowOnScenePhaseChange(scenePhase: ScenePhase) {","    guard configured else {","        fatalError(\"Window manager not configured when scene phase changed\")","    }","","    switch scenePhase {","    case .inactive:","        \/\/ App is becoming inactive (e.g., another app is in focus)","        if windowVisible {","            dismissWindow(id: launchWindowId)","        }","","    case .active:","        \/\/ App is becoming active","        if sessionState == .paused {","            Task { @MainActor in","                try? await onSessionResumeRequested?()","                if !immersiveSpaceActive {","                    await openImmersiveSpace(id: immersiveSpaceId)","                }","            }","        }","","    case .background:","        \/\/ App is in background (handle in ImmersiveSpace)","        break","","    @unknown default:","        break","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"5. Immersive Space Events","level":3,"anchor":"5-Immersive-Space-Events"},{"type":"heading","text":"5.1 Immersive Space Appearance","level":4,"anchor":"51-Immersive-Space-Appearance"},{"code":["func immersiveSpaceOnAppear() {","    guard !immersiveSpaceActive else {","        fatalError(\"Immersive space was already active when onAppear was called\")","    }","    immersiveSpaceActive = true","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"5.2 Immersive Space Disappearance (Crown Press Recovery)","level":4,"anchor":"52-Immersive-Space-Disappearance-Crown-Press-Recovery"},{"code":["func immersiveSpaceOnDisappear() {","    guard immersiveSpaceActive else {","        fatalError(\"Immersive space state incorrect on disappear\")","    }","","    guard configured else {","        fatalError(\"Window manager not configured when immersive space disappeared\")","    }","","    immersiveSpaceActive = false","","    \/\/ RECOVERY MECHANISM: Automatically restore window when exiting immersive space","    if windowVisible == false {","        openWindow(id: \"LaunchWindow\")","    }","","    \/\/ Handle session state","    switch sessionState {","    case .disconnecting, .disconnected, .initialized, .pausing, .paused:","        return","    default:","        if pauseOnImmersiveSpaceDismissed {","            onSessionPauseRequested?()","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Recovery Mechanisms Implementation","level":2,"anchor":"Recovery-Mechanisms-Implementation"},{"type":"heading","text":"6. Triple-Tap Gesture Recovery","level":3,"anchor":"6-Triple-Tap-Gesture-Recovery"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Implementation in the ImmersiveSpace view:"}]},{"code":["ImmersiveSpace(id: \"ImmersiveSpace\") {","    StreamingView(cxrSession: cxrSession)","        .onTapGesture(count: 3) {","            windowManager.toggleWindow()","        }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Toggle window implementation:"}]},{"code":["func toggleWindow() {","    guard configured else {","        Self.logger.error(\"Window manager is not configured when toggling the window\")","        return","    }","","    if windowVisible {","        dismissWindow(id: launchWindowId)","    } else {","        openWindow(id: launchWindowId)","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"7. Connection State Recovery","level":3,"anchor":"7-Connection-State-Recovery"},{"type":"paragraph","inlineContent":[{"text":"Hook up session state changes:","type":"text"}]},{"code":["\/\/ Session state changes are handled via onChange modifier",".onChange(of: cxrSession.state) { oldState, newState in","    Task { @MainActor in","        await windowManager.onSessionStateChanged(","            oldState: oldState,","            newState: newState","        )","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Implementation:"}]},{"code":["func onSessionStateChanged(oldState: SessionState, newState: SessionState) async {","    \/\/ Update internal session state","    sessionState = newState","","    switch newState {","    case .connected:","        await handleConnectionEstablished()","    case .disconnected:","        await handleDisconnection()","    default:","        return","    }","}","","private func handleDisconnection() async {","    guard configured else {","        Self.logger.error(\"Disconnection before window manager was configured\")","        return","    }","","    \/\/ RECOVERY MECHANISM: Restore window on disconnection","    if windowVisible == false {","        await openWindow(id: launchWindowId)","    }","","    if immersiveSpaceActive == true {","        await dismissImmersiveSpace()","    }","}","","private func handleConnectionEstablished() async {","    guard configured else {","        Self.logger.error(\"Connection established before window manager was configured\")","        return","    }","","    if !immersiveSpaceActive {","        await openImmersiveSpace(id: immersiveSpaceId)","    }","","    \/\/ Hide window based on debug settings","    #if DEBUG","    if debugHideWindowAtConnection {","        await dismissWindow(id: launchWindowId)","    }","    #else","    await dismissWindow(id: launchWindowId)","    #endif","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Usage in Your Views","level":2,"anchor":"Usage-in-Your-Views"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When using the WindowStateManager in your views, access it via @EnvironmentObject:"}]},{"code":["struct YourView: View {","    @EnvironmentObject var windowManager: WindowStateManager","","    var body: some View {","        \/\/ Your view implementation","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Testing and Validation","level":2,"anchor":"Testing-and-Validation"},{"type":"heading","text":"8. Test Scenarios","level":3,"anchor":"8-Test-Scenarios"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Normal Flow"}]}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Launch app → Window appears","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Connect → Window dismisses, immersive space opens"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Triple-tap → Window toggles"}],"type":"paragraph"}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Crown Press Recovery","type":"text"}]}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"In immersive space → Press crown","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Verify: Window automatically reopens","type":"text"}]}]}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Disconnection Recovery"}]}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Hide window → Disconnect session"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Verify: Window automatically reopens"}],"type":"paragraph"}]}],"type":"unorderedList"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Rapid Toggle Test","type":"text"}],"type":"strong"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["func testRapidToggle() async {","    for _ in 0..<10 {","        windowManager.toggleWindow()","        try? await Task.sleep(nanoseconds: 100_000_000) \/\/ 0.1s","    }","    \/\/ Verify final state is consistent","}"]}]}]},{"type":"heading","text":"9. State Validation","level":3,"anchor":"9-State-Validation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add debug assertions:"}]},{"code":["#if DEBUG","extension WindowStateManager {","    func validateState() {","        assert(!(windowVisible && !configured), \"Window visible but manager not configured\")","        assert(!(immersiveSpaceActive && !configured), \"Immersive space active but manager not configured\")","    }","}","#endif"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Best Practices","level":2,"anchor":"Best-Practices"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Always validate state before operations"}]}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Use @MainActor for UI operations","type":"text"}],"type":"strong"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Handle all error cases gracefully","type":"text"}]}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Provide multiple recovery paths"}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Test edge cases thoroughly"}]}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Document recovery methods for users"}]}],"type":"paragraph"}]}]},{"type":"heading","text":"Common Pitfalls","level":2,"anchor":"Common-Pitfalls"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Race Conditions"}]},{"type":"text","text":": Use proper state management and locks"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Missing Configuration"}]},{"type":"text","text":": Ensure window manager is configured before use"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Async\/Await Misuse"}],"type":"strong"},{"text":": Always await async operations properly","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"State Inconsistency","type":"text"}],"type":"strong"},{"type":"text","text":": Validate state transitions"}]}]}]},{"type":"heading","text":"Integration Example","level":2,"anchor":"Integration-Example"},{"type":"paragraph","inlineContent":[{"text":"Here’s how to integrate the window manager into your CloudXRKit application:","type":"text"}]},{"code":["\/\/ WindowStateManager+Extensions.swift","extension WindowStateManager {","    \/\/ Public method to update session state from outside","    func updateSessionState(_ newState: SessionState) {","        lock.withLock {","            sessionState = newState","        }","    }","","    \/\/ Configuration options","    func configure(debugHideWindow: Bool = false,","                   pauseOnDismiss: Bool = true) {","        debugHideWindowAtConnection = debugHideWindow","        pauseOnImmersiveSpaceDismissed = pauseOnDismiss","    }","}","","\/\/ In your app initialization","let windowManager = WindowStateManager()","windowManager.configure(","    debugHideWindow: false,","    pauseOnDismiss: true",")"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","hierarchy":{"paths":[["doc:\/\/com.nvidia.CloudXRKit\/documentation\/CloudXRKit"]]},"sections":[],"variants":[{"paths":["\/documentation\/cloudxrkit\/windowmanagement"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/cloudxrkit\/windowmanagement"],"traits":[{"interfaceLanguage":"occ"}]}],"references":{"doc://com.nvidia.CloudXRKit/documentation/CloudXRKit":{"role":"collection","type":"topic","url":"\/documentation\/cloudxrkit","kind":"symbol","abstract":[{"type":"text","text":"Stream immersive applications."}],"title":"CloudXRKit","identifier":"doc:\/\/com.nvidia.CloudXRKit\/documentation\/CloudXRKit"}},"variantOverrides":[{"traits":[{"interfaceLanguage":"occ"}],"patch":[{"path":"\/identifier\/interfaceLanguage","op":"replace","value":"occ"},{"path":"\/topicSections","op":"add","value":null},{"path":"\/seeAlsoSections","op":"add","value":null}]}]}