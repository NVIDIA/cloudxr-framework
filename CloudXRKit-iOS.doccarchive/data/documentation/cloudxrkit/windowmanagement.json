{"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"title":"Window State Manager Implementation Guide for CloudXRKit Apps","roleHeading":"Article","modules":[{"name":"CloudXRKit"}],"role":"article"},"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"This guide provides technical instructions for implementing a Window State Manager in visionOS applications using CloudXRKit. The Window State Manager ensures users can always recover the UI if accidentally dismissed during immersive CloudXR sessions.","type":"text"}]},{"level":2,"type":"heading","text":"Prerequisites","anchor":"Prerequisites"},{"type":"paragraph","inlineContent":[{"text":"To use this implementation, you’ll need:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A visionOS app using CloudXRKit"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"SwiftUI-based UI with WindowGroup and ImmersiveSpace scenes"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A CloudXRKit.Session instance for streaming"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Your own content view and streaming view implementations"}]}]}]},{"level":2,"type":"heading","text":"Architecture Overview","anchor":"Architecture-Overview"},{"type":"paragraph","inlineContent":[{"text":"The Window State Manager coordinates between:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"SwiftUI Window lifecycle events"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"ImmersiveSpace lifecycle events"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"CloudXRKit session state changes (using CloudXRKit.SessionState)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"User interactions (gestures, system controls)"}]}]}]},{"type":"codeListing","code":["┌─────────────────────────────────────────────────────────────────────────┐","│                              Your visionOS App                          │","├─────────────────────────────────────────────────────────────────────────┤","│                                                                         │","│  ┌─────────────────┐                           ┌────────────────────┐   │","│  │   WindowGroup   │                           │  ImmersiveSpace    │   │","│  │                 │                           │                    │   │","│  │  ┌───────────┐  │                           │  ┌──────────────┐  │   │","│  │  │ onAppear  │  │                           │  │  onAppear    │  │   │","│  │  │onDisappear│  │                           │  │ onDisappear  │  │   │","│  │  └─────┬─────┘  │                           │  └──────┬───────┘  │   │","│  └────────┼────────┘                           └─────────┼──────────┘   │","│           │                                              │              │","│           │         ┌──────────────────────────┐         │              │","│           └────────▶│                          │◀────────┘              │","│                     │   WindowStateManager     │                        │","│                     │                          │                        │","│  ┌─────────────┐    │  • windowVisible         │    ┌───────────────┐   │","│  │   Scene     │───▶│  • immersiveSpaceActive  │◀───│ User Gestures │   │","│  │   Phase     │    │  • sessionState          │    │ (Triple-tap)  │   │","│  └─────────────┘    │  • configured            │    └───────────────┘   │","│                     │                          │                        │","│  ┌─────────────┐    │  Recovery Logic:         │    ┌───────────────┐   │","│  │ CloudXRKit  │───▶│  • Crown press           │◀───│ System Events │   │","│  │   Session   │    │  • Disconnection         │    │ (Crown press) │   │","│  │   State     │    │  • Scene changes         │    └───────────────┘   │","│  └─────────────┘    └──────────────────────────┘                        │","│                                                                         │","└─────────────────────────────────────────────────────────────────────────┘"],"syntax":null},{"level":2,"type":"heading","text":"Core Components","anchor":"Core-Components"},{"level":3,"type":"heading","text":"1. Window State Manager Class","anchor":"1-Window-State-Manager-Class"},{"type":"codeListing","code":["import SwiftUI","import CloudXRKit","import os.log","","#if os(visionOS)","class WindowStateManager: ObservableObject {","    \/\/ Window state tracking","    private var windowVisible = false","    private var immersiveSpaceActive = false","    private var configured = false","","    \/\/ Session state tracking (using CloudXRKit.SessionState)","    @Published private(set) var sessionState: CloudXRKit.SessionState = .disconnected","    private var pauseOnImmersiveSpaceDismissed = true","","    \/\/ Configuration options","    var debugHideWindowAtConnection = false","","    \/\/ SwiftUI Actions","    private var openImmersiveSpace: OpenImmersiveSpaceAction!","    private var dismissImmersiveSpace: DismissImmersiveSpaceAction!","    private var openWindow: OpenWindowAction!","    private var dismissWindow: DismissWindowAction!","","    \/\/ Callbacks for session control","    var onSessionPauseRequested: (() -> Void)?","    var onSessionResumeRequested: (() async throws -> Void)?","","    \/\/ Thread safety","    private var lock = OSAllocatedUnfairLock()","    private static let logger = Logger()","","    \/\/ Window IDs","    private let launchWindowId = \"LaunchWindow\"","    private let immersiveSpaceId = \"ImmersiveSpace\"","}","#endif"],"syntax":"swift"},{"level":3,"type":"heading","text":"1.1 Complete WindowStateManager Implementation","anchor":"11-Complete-WindowStateManager-Implementation"},{"type":"paragraph","inlineContent":[{"text":"Here’s the full implementation that can be used in any CloudXRKit-based application:","type":"text"}]},{"type":"codeListing","code":["extension WindowStateManager {","    \/\/ MARK: - Window Lifecycle","","    func windowOnAppear(openImmersiveSpace: OpenImmersiveSpaceAction,","                        dismissImmersiveSpace: DismissImmersiveSpaceAction,","                        openWindow: OpenWindowAction,","                        dismissWindow: DismissWindowAction) {","        guard !windowVisible else {","            Self.logger.error(\"windowOnAppear called while window already open\")","            return","        }","","        if !configured {","            self.openImmersiveSpace = openImmersiveSpace","            self.dismissImmersiveSpace = dismissImmersiveSpace","            self.openWindow = openWindow","            self.dismissWindow = dismissWindow","            configured = true","        }","","        windowVisible = true","    }","","    func windowOnDisappear() {","        guard windowVisible else {","            Self.logger.error(\"windowOnDisappear called when window is already dismissed\")","            return","        }","        windowVisible = false","    }","","    \/\/ MARK: - Scene Phase Management","","    func windowOnScenePhaseChange(scenePhase: ScenePhase) {","        guard configured else {","            Self.logger.error(\"Window manager not configured when scene phase changed\")","            return","        }","","        switch scenePhase {","        case .inactive:","            if windowVisible {","                dismissWindow(id: launchWindowId)","            }","        case .active:","            if sessionState == .paused {","                Task { @MainActor in","                    try? await onSessionResumeRequested?()","                    if !immersiveSpaceActive {","                        await openImmersiveSpace(id: immersiveSpaceId)","                    }","                }","            }","        case .background:","            dismissImmersiveSpaceIfOpen()","        @unknown default:","            break","        }","    }","","    \/\/ MARK: - Immersive Space Lifecycle","","    func immersiveSpaceOnAppear() {","        guard !immersiveSpaceActive else {","            Self.logger.error(\"Immersive space was already active when onAppear was called\")","            return","        }","        immersiveSpaceActive = true","    }","","    func immersiveSpaceOnDisappear() {","        guard immersiveSpaceActive else {","            Self.logger.error(\"Immersive space state incorrect on disappear\")","            return","        }","","        guard configured else {","            Self.logger.error(\"Window manager not configured when immersive space disappeared\")","            return","        }","","        immersiveSpaceActive = false","","        \/\/ RECOVERY MECHANISM: Restore window when exiting immersive space","        if windowVisible == false {","            openWindow(id: launchWindowId)","        }","","        \/\/ Handle session state","        switch sessionState {","        case .disconnecting, .disconnected, .initialized, .pausing, .paused:","            return","        default:","            if pauseOnImmersiveSpaceDismissed {","                onSessionPauseRequested?()","            }","        }","    }","","    \/\/ MARK: - Session State Management","","    func onSessionStateChanged(oldState: CloudXRKit.SessionState, newState: CloudXRKit.SessionState) async {","        sessionState = newState","","        switch newState {","        case .connected:","            await handleConnectionEstablished()","        case .disconnected:","            await handleDisconnection()","        default:","            return","        }","    }","","    \/\/ MARK: - Window Control","","    func toggleWindow() {","        guard configured else {","            Self.logger.error(\"Window manager is not configured when toggling the window\")","            return","        }","","        if windowVisible {","            dismissWindow(id: launchWindowId)","        } else {","            openWindow(id: launchWindowId)","        }","    }","","    func dismissImmersiveSpaceIfOpen() {","        if immersiveSpaceActive {","            Task { @MainActor in","                await dismissImmersiveSpace()","            }","        }","    }","}"],"syntax":"swift"},{"level":3,"type":"heading","text":"2. SwiftUI Event Hookup Points","anchor":"2-SwiftUI-Event-Hookup-Points"},{"level":4,"type":"heading","text":"2.1 App Entry Point Configuration","anchor":"21-App-Entry-Point-Configuration"},{"type":"paragraph","inlineContent":[{"text":"In your app’s main ","type":"text"},{"type":"codeVoice","code":"App"},{"text":" struct:","type":"text"}]},{"type":"codeListing","code":["@main","struct YourApp: App {","    @StateObject private var windowManager = WindowStateManager()","    @State private var cxrSession = CloudXRKit.Session(config: CloudXRKit.Config())","    @Environment(\\.openWindow) var openWindow","    @Environment(\\.dismissWindow) var dismissWindow","    @Environment(\\.openImmersiveSpace) var openImmersiveSpace","    @Environment(\\.dismissImmersiveSpace) var dismissImmersiveSpace","    @Environment(\\.scenePhase) var scenePhase","","    var body: some Scene {","        WindowGroup(id: \"LaunchWindow\") {","            YourContentView() \/\/ Your app's main UI","                .onAppear {","                    \/\/ Configure window manager with SwiftUI actions","                    windowManager.windowOnAppear(","                        openImmersiveSpace: openImmersiveSpace,","                        dismissImmersiveSpace: dismissImmersiveSpace,","                        openWindow: openWindow,","                        dismissWindow: dismissWindow","                    )","","                    \/\/ Set up session callbacks","                    windowManager.onSessionPauseRequested = {","                        cxrSession.pause()","                    }","","                    windowManager.onSessionResumeRequested = {","                        try await cxrSession.resume()","                    }","                }","                .onDisappear {","                    windowManager.windowOnDisappear()","                }","                .onChange(of: scenePhase) { _, newPhase in","                    windowManager.windowOnScenePhaseChange(scenePhase: newPhase)","                }","                .onChange(of: cxrSession.state) { oldState, newState in","                    Task {","                        await windowManager.onSessionStateChanged(","                            oldState: oldState,","                            newState: newState","                        )","                    }","                }","        }","        .environmentObject(windowManager)","","        ImmersiveSpace(id: \"ImmersiveSpace\") {","            YourStreamingView(cxrSession: cxrSession) \/\/ Your CloudXR streaming view","                .onAppear {","                    windowManager.immersiveSpaceOnAppear()","                }","                .onDisappear {","                    windowManager.immersiveSpaceOnDisappear()","                }","                .onTapGesture(count: 3) {","                    \/\/ RECOVERY MECHANISM: Triple-tap to toggle window","                    windowManager.toggleWindow()","                }","        }","        .environmentObject(windowManager)","    }","}"],"syntax":"swift"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Note"}]},{"text":": ","type":"text"},{"type":"codeVoice","code":"YourStreamingView"},{"text":" should be your implementation that displays CloudXR content using the CloudXRKit session. This typically involves creating a RealityKit view that renders the streamed content.","type":"text"}]}],"style":"note","name":"Note"},{"level":2,"type":"heading","text":"Event Flow and Handling","anchor":"Event-Flow-and-Handling"},{"level":3,"type":"heading","text":"3. Window Lifecycle Events","anchor":"3-Window-Lifecycle-Events"},{"level":4,"type":"heading","text":"3.1 Window Appearance","anchor":"31-Window-Appearance"},{"type":"codeListing","code":["func windowOnAppear(openImmersiveSpace: OpenImmersiveSpaceAction,","                    dismissImmersiveSpace: DismissImmersiveSpaceAction,","                    openWindow: OpenWindowAction,","                    dismissWindow: DismissWindowAction) {","    \/\/ Step 1: Validate state","    guard !windowVisible else {","        Self.logger.error(\"windowOnAppear called while window already open\")","        return","    }","","    \/\/ Step 2: Configure dependencies (first time only)","    if !configured {","        self.openImmersiveSpace = openImmersiveSpace","        self.dismissImmersiveSpace = dismissImmersiveSpace","        self.openWindow = openWindow","        self.dismissWindow = dismissWindow","        configured = true","    }","","    \/\/ Step 3: Update state","    windowVisible = true","}"],"syntax":"swift"},{"level":4,"type":"heading","text":"3.2 Window Disappearance","anchor":"32-Window-Disappearance"},{"type":"codeListing","code":["func windowOnDisappear() {","    guard windowVisible else {","        fatalError(\"windowOnDisappear called when window is already dismissed\")","    }","    windowVisible = false","}"],"syntax":"swift"},{"level":3,"type":"heading","text":"4. Scene Phase Changes","anchor":"4-Scene-Phase-Changes"},{"type":"paragraph","inlineContent":[{"text":"The scene phase handler manages app lifecycle transitions:","type":"text"}]},{"type":"codeListing","code":["func windowOnScenePhaseChange(scenePhase: ScenePhase) {","    guard configured else {","        fatalError(\"Window manager not configured when scene phase changed\")","    }","","    switch scenePhase {","    case .inactive:","        \/\/ App is becoming inactive (e.g., another app is in focus)","        if windowVisible {","            dismissWindow(id: launchWindowId)","        }","","    case .active:","        \/\/ App is becoming active","        if sessionState == .paused {","            Task { @MainActor in","                try? await onSessionResumeRequested?()","                if !immersiveSpaceActive {","                    await openImmersiveSpace(id: immersiveSpaceId)","                }","            }","        }","","    case .background:","        \/\/ App is in background (handle in ImmersiveSpace)","        break","","    @unknown default:","        break","    }","}"],"syntax":"swift"},{"level":3,"type":"heading","text":"5. Immersive Space Events","anchor":"5-Immersive-Space-Events"},{"level":4,"type":"heading","text":"5.1 Immersive Space Appearance","anchor":"51-Immersive-Space-Appearance"},{"type":"codeListing","code":["func immersiveSpaceOnAppear() {","    guard !immersiveSpaceActive else {","        fatalError(\"Immersive space was already active when onAppear was called\")","    }","    immersiveSpaceActive = true","}"],"syntax":"swift"},{"level":4,"type":"heading","text":"5.2 Immersive Space Disappearance (Crown Press Recovery)","anchor":"52-Immersive-Space-Disappearance-Crown-Press-Recovery"},{"type":"codeListing","code":["func immersiveSpaceOnDisappear() {","    guard immersiveSpaceActive else {","        fatalError(\"Immersive space state incorrect on disappear\")","    }","","    guard configured else {","        fatalError(\"Window manager not configured when immersive space disappeared\")","    }","","    immersiveSpaceActive = false","","    \/\/ RECOVERY MECHANISM: Automatically restore window when exiting immersive space","    if windowVisible == false {","        openWindow(id: \"LaunchWindow\")","    }","","    \/\/ Handle session state","    switch sessionState {","    case .disconnecting, .disconnected, .initialized, .pausing, .paused:","        return","    default:","        if pauseOnImmersiveSpaceDismissed {","            onSessionPauseRequested?()","        }","    }","}"],"syntax":"swift"},{"level":2,"type":"heading","text":"Recovery Mechanisms Implementation","anchor":"Recovery-Mechanisms-Implementation"},{"level":3,"type":"heading","text":"6. Triple-Tap Gesture Recovery","anchor":"6-Triple-Tap-Gesture-Recovery"},{"type":"paragraph","inlineContent":[{"text":"Implementation in the ImmersiveSpace view:","type":"text"}]},{"type":"codeListing","code":["ImmersiveSpace(id: \"ImmersiveSpace\") {","    StreamingView(cxrSession: cxrSession)","        .onTapGesture(count: 3) {","            windowManager.toggleWindow()","        }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Toggle window implementation:","type":"text"}]},{"type":"codeListing","code":["func toggleWindow() {","    guard configured else {","        Self.logger.error(\"Window manager is not configured when toggling the window\")","        return","    }","","    if windowVisible {","        dismissWindow(id: launchWindowId)","    } else {","        openWindow(id: launchWindowId)","    }","}"],"syntax":"swift"},{"level":3,"type":"heading","text":"7. Connection State Recovery","anchor":"7-Connection-State-Recovery"},{"type":"paragraph","inlineContent":[{"text":"Hook up session state changes:","type":"text"}]},{"type":"codeListing","code":["\/\/ Session state changes are handled via onChange modifier",".onChange(of: cxrSession.state) { oldState, newState in","    Task { @MainActor in","        await windowManager.onSessionStateChanged(","            oldState: oldState,","            newState: newState","        )","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Implementation:","type":"text"}]},{"type":"codeListing","code":["func onSessionStateChanged(oldState: SessionState, newState: SessionState) async {","    \/\/ Update internal session state","    sessionState = newState","","    switch newState {","    case .connected:","        await handleConnectionEstablished()","    case .disconnected:","        await handleDisconnection()","    default:","        return","    }","}","","private func handleDisconnection() async {","    guard configured else {","        Self.logger.error(\"Disconnection before window manager was configured\")","        return","    }","","    \/\/ RECOVERY MECHANISM: Restore window on disconnection","    if windowVisible == false {","        await openWindow(id: launchWindowId)","    }","","    if immersiveSpaceActive == true {","        await dismissImmersiveSpace()","    }","}","","private func handleConnectionEstablished() async {","    guard configured else {","        Self.logger.error(\"Connection established before window manager was configured\")","        return","    }","","    if !immersiveSpaceActive {","        await openImmersiveSpace(id: immersiveSpaceId)","    }","","    \/\/ Hide window based on debug settings","    #if DEBUG","    if debugHideWindowAtConnection {","        await dismissWindow(id: launchWindowId)","    }","    #else","    await dismissWindow(id: launchWindowId)","    #endif","}"],"syntax":"swift"},{"level":2,"type":"heading","text":"Usage in Your Views","anchor":"Usage-in-Your-Views"},{"type":"paragraph","inlineContent":[{"text":"When using the WindowStateManager in your views, access it via @EnvironmentObject:","type":"text"}]},{"type":"codeListing","code":["struct YourView: View {","    @EnvironmentObject var windowManager: WindowStateManager","","    var body: some View {","        \/\/ Your view implementation","    }","}"],"syntax":"swift"},{"level":2,"type":"heading","text":"Testing and Validation","anchor":"Testing-and-Validation"},{"level":3,"type":"heading","text":"8. Test Scenarios","anchor":"8-Test-Scenarios"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Normal Flow","type":"text"}],"type":"strong"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Launch app → Window appears"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Connect → Window dismisses, immersive space opens"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Triple-tap → Window toggles"}]}]}],"type":"unorderedList"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Crown Press Recovery","type":"text"}],"type":"strong"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In immersive space → Press crown"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify: Window automatically reopens"}]}]}],"type":"unorderedList"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Disconnection Recovery","type":"text"}],"type":"strong"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Hide window → Disconnect session"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify: Window automatically reopens"}]}]}],"type":"unorderedList"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Rapid Toggle Test","type":"text"}],"type":"strong"}]},{"type":"codeListing","syntax":"swift","code":["func testRapidToggle() async {","    for _ in 0..<10 {","        windowManager.toggleWindow()","        try? await Task.sleep(nanoseconds: 100_000_000) \/\/ 0.1s","    }","    \/\/ Verify final state is consistent","}"]}]}]},{"level":3,"type":"heading","text":"9. State Validation","anchor":"9-State-Validation"},{"type":"paragraph","inlineContent":[{"text":"Add debug assertions:","type":"text"}]},{"type":"codeListing","code":["#if DEBUG","extension WindowStateManager {","    func validateState() {","        assert(!(windowVisible && !configured), \"Window visible but manager not configured\")","        assert(!(immersiveSpaceActive && !configured), \"Immersive space active but manager not configured\")","    }","}","#endif"],"syntax":"swift"},{"level":2,"type":"heading","text":"Best Practices","anchor":"Best-Practices"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Always validate state before operations","type":"text"}],"type":"strong"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Use @MainActor for UI operations","type":"text"}],"type":"strong"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Handle all error cases gracefully","type":"text"}],"type":"strong"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Provide multiple recovery paths","type":"text"}],"type":"strong"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Test edge cases thoroughly","type":"text"}],"type":"strong"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Document recovery methods for users","type":"text"}],"type":"strong"}]}]}]},{"level":2,"type":"heading","text":"Common Pitfalls","anchor":"Common-Pitfalls"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Race Conditions","type":"text"}],"type":"strong"},{"type":"text","text":": Use proper state management and locks"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Missing Configuration","type":"text"}],"type":"strong"},{"type":"text","text":": Ensure window manager is configured before use"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Async\/Await Misuse","type":"text"}],"type":"strong"},{"type":"text","text":": Always await async operations properly"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"State Inconsistency","type":"text"}],"type":"strong"},{"type":"text","text":": Validate state transitions"}]}]}]},{"level":2,"type":"heading","text":"Integration Example","anchor":"Integration-Example"},{"type":"paragraph","inlineContent":[{"text":"Here’s how to integrate the window manager into your CloudXRKit application:","type":"text"}]},{"type":"codeListing","code":["\/\/ WindowStateManager+Extensions.swift","extension WindowStateManager {","    \/\/ Public method to update session state from outside","    func updateSessionState(_ newState: SessionState) {","        lock.withLock {","            sessionState = newState","        }","    }","","    \/\/ Configuration options","    func configure(debugHideWindow: Bool = false,","                   pauseOnDismiss: Bool = true) {","        debugHideWindowAtConnection = debugHideWindow","        pauseOnImmersiveSpaceDismissed = pauseOnDismiss","    }","}","","\/\/ In your app initialization","let windowManager = WindowStateManager()","windowManager.configure(","    debugHideWindow: false,","    pauseOnDismiss: true",")"],"syntax":"swift"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.nvidia.CloudXRKit\/documentation\/CloudXRKit"]]},"sections":[],"kind":"article","identifier":{"url":"doc:\/\/com.nvidia.CloudXRKit\/documentation\/CloudXRKit\/WindowManagement","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/cloudxrkit\/windowmanagement"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/cloudxrkit\/windowmanagement"],"traits":[{"interfaceLanguage":"occ"}]}],"references":{"doc://com.nvidia.CloudXRKit/documentation/CloudXRKit":{"role":"collection","abstract":[{"type":"text","text":"Stream immersive applications."}],"type":"topic","title":"CloudXRKit","kind":"symbol","identifier":"doc:\/\/com.nvidia.CloudXRKit\/documentation\/CloudXRKit","url":"\/documentation\/cloudxrkit"}},"variantOverrides":[{"patch":[{"path":"\/identifier\/interfaceLanguage","value":"occ","op":"replace"},{"path":"\/topicSections","value":null,"op":"add"},{"path":"\/seeAlsoSections","value":null,"op":"add"}],"traits":[{"interfaceLanguage":"occ"}]}]}