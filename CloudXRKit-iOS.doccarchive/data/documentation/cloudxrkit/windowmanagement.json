{"kind":"article","primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide provides technical instructions for implementing a Window State Manager in visionOS applications using CloudXRKit. The Window State Manager ensures users can always recover the UI if accidentally dismissed during immersive CloudXR sessions."}]},{"anchor":"Prerequisites","type":"heading","level":2,"text":"Prerequisites"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To use this implementation, you’ll need:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A visionOS app using CloudXRKit"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"SwiftUI-based UI with WindowGroup and ImmersiveSpace scenes"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A CloudXRKit.Session instance for streaming"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Your own content view and streaming view implementations"}]}]}]},{"anchor":"Architecture-Overview","type":"heading","level":2,"text":"Architecture Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Window State Manager coordinates between:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"SwiftUI Window lifecycle events"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"ImmersiveSpace lifecycle events"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"CloudXRKit session state changes (using CloudXRKit.SessionState)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"User interactions (gestures, system controls)"}]}]}]},{"syntax":null,"code":["┌─────────────────────────────────────────────────────────────────────────┐","│                              Your visionOS App                          │","├─────────────────────────────────────────────────────────────────────────┤","│                                                                         │","│  ┌─────────────────┐                           ┌────────────────────┐   │","│  │   WindowGroup   │                           │  ImmersiveSpace    │   │","│  │                 │                           │                    │   │","│  │  ┌───────────┐  │                           │  ┌──────────────┐  │   │","│  │  │ onAppear  │  │                           │  │  onAppear    │  │   │","│  │  │onDisappear│  │                           │  │ onDisappear  │  │   │","│  │  └─────┬─────┘  │                           │  └──────┬───────┘  │   │","│  └────────┼────────┘                           └─────────┼──────────┘   │","│           │                                              │              │","│           │         ┌──────────────────────────┐         │              │","│           └────────▶│                          │◀────────┘              │","│                     │   WindowStateManager     │                        │","│                     │                          │                        │","│  ┌─────────────┐    │  • windowVisible         │    ┌───────────────┐   │","│  │   Scene     │───▶│  • immersiveSpaceActive  │◀───│ User Gestures │   │","│  │   Phase     │    │  • sessionState          │    │ (Triple-tap)  │   │","│  └─────────────┘    │  • configured            │    └───────────────┘   │","│                     │                          │                        │","│  ┌─────────────┐    │  Recovery Logic:         │    ┌───────────────┐   │","│  │ CloudXRKit  │───▶│  • Crown press           │◀───│ System Events │   │","│  │   Session   │    │  • Disconnection         │    │ (Crown press) │   │","│  │   State     │    │  • Scene changes         │    └───────────────┘   │","│  └─────────────┘    └──────────────────────────┘                        │","│                                                                         │","└─────────────────────────────────────────────────────────────────────────┘"],"type":"codeListing"},{"anchor":"Core-Components","type":"heading","level":2,"text":"Core Components"},{"anchor":"1-Window-State-Manager-Class","type":"heading","level":3,"text":"1. Window State Manager Class"},{"syntax":"swift","code":["import SwiftUI","import CloudXRKit","import os.log","","#if os(visionOS)","class WindowStateManager: ObservableObject {","    \/\/ Window state tracking","    private var windowVisible = false","    private var immersiveSpaceActive = false","    private var configured = false","","    \/\/ Session state tracking (using CloudXRKit.SessionState)","    @Published private(set) var sessionState: CloudXRKit.SessionState = .disconnected","    private var pauseOnImmersiveSpaceDismissed = true","","    \/\/ Configuration options","    var debugHideWindowAtConnection = false","","    \/\/ SwiftUI Actions","    private var openImmersiveSpace: OpenImmersiveSpaceAction!","    private var dismissImmersiveSpace: DismissImmersiveSpaceAction!","    private var openWindow: OpenWindowAction!","    private var dismissWindow: DismissWindowAction!","","    \/\/ Callbacks for session control","    var onSessionPauseRequested: (() -> Void)?","    var onSessionResumeRequested: (() async throws -> Void)?","","    \/\/ Thread safety","    private var lock = OSAllocatedUnfairLock()","    private static let logger = Logger()","","    \/\/ Window IDs","    private let launchWindowId = \"LaunchWindow\"","    private let immersiveSpaceId = \"ImmersiveSpace\"","}","#endif"],"type":"codeListing"},{"anchor":"11-Complete-WindowStateManager-Implementation","type":"heading","level":3,"text":"1.1 Complete WindowStateManager Implementation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Here’s the full implementation that can be used in any CloudXRKit-based application:"}]},{"syntax":"swift","code":["extension WindowStateManager {","    \/\/ MARK: - Window Lifecycle","","    func windowOnAppear(openImmersiveSpace: OpenImmersiveSpaceAction,","                        dismissImmersiveSpace: DismissImmersiveSpaceAction,","                        openWindow: OpenWindowAction,","                        dismissWindow: DismissWindowAction) {","        guard !windowVisible else {","            Self.logger.error(\"windowOnAppear called while window already open\")","            return","        }","","        if !configured {","            self.openImmersiveSpace = openImmersiveSpace","            self.dismissImmersiveSpace = dismissImmersiveSpace","            self.openWindow = openWindow","            self.dismissWindow = dismissWindow","            configured = true","        }","","        windowVisible = true","    }","","    func windowOnDisappear() {","        guard windowVisible else {","            Self.logger.error(\"windowOnDisappear called when window is already dismissed\")","            return","        }","        windowVisible = false","    }","","    \/\/ MARK: - Scene Phase Management","","    func windowOnScenePhaseChange(scenePhase: ScenePhase) {","        guard configured else {","            Self.logger.error(\"Window manager not configured when scene phase changed\")","            return","        }","","        switch scenePhase {","        case .inactive:","            if windowVisible {","                dismissWindow(id: launchWindowId)","            }","        case .active:","            if sessionState == .paused {","                Task { @MainActor in","                    try? await onSessionResumeRequested?()","                    if !immersiveSpaceActive {","                        await openImmersiveSpace(id: immersiveSpaceId)","                    }","                }","            }","        case .background:","            dismissImmersiveSpaceIfOpen()","        @unknown default:","            break","        }","    }","","    \/\/ MARK: - Immersive Space Lifecycle","","    func immersiveSpaceOnAppear() {","        guard !immersiveSpaceActive else {","            Self.logger.error(\"Immersive space was already active when onAppear was called\")","            return","        }","        immersiveSpaceActive = true","    }","","    func immersiveSpaceOnDisappear() {","        guard immersiveSpaceActive else {","            Self.logger.error(\"Immersive space state incorrect on disappear\")","            return","        }","","        guard configured else {","            Self.logger.error(\"Window manager not configured when immersive space disappeared\")","            return","        }","","        immersiveSpaceActive = false","","        \/\/ RECOVERY MECHANISM: Restore window when exiting immersive space","        if windowVisible == false {","            openWindow(id: launchWindowId)","        }","","        \/\/ Handle session state","        switch sessionState {","        case .disconnecting, .disconnected, .initialized, .pausing, .paused:","            return","        default:","            if pauseOnImmersiveSpaceDismissed {","                onSessionPauseRequested?()","            }","        }","    }","","    \/\/ MARK: - Session State Management","","    func onSessionStateChanged(oldState: CloudXRKit.SessionState, newState: CloudXRKit.SessionState) async {","        sessionState = newState","","        switch newState {","        case .connected:","            await handleConnectionEstablished()","        case .disconnected:","            await handleDisconnection()","        default:","            return","        }","    }","","    \/\/ MARK: - Window Control","","    func toggleWindow() {","        guard configured else {","            Self.logger.error(\"Window manager is not configured when toggling the window\")","            return","        }","","        if windowVisible {","            dismissWindow(id: launchWindowId)","        } else {","            openWindow(id: launchWindowId)","        }","    }","","    func dismissImmersiveSpaceIfOpen() {","        if immersiveSpaceActive {","            Task { @MainActor in","                await dismissImmersiveSpace()","            }","        }","    }","}"],"type":"codeListing"},{"anchor":"2-SwiftUI-Event-Hookup-Points","type":"heading","level":3,"text":"2. SwiftUI Event Hookup Points"},{"anchor":"21-App-Entry-Point-Configuration","type":"heading","level":4,"text":"2.1 App Entry Point Configuration"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In your app’s main "},{"type":"codeVoice","code":"App"},{"type":"text","text":" struct:"}]},{"syntax":"swift","code":["@main","struct YourApp: App {","    @StateObject private var windowManager = WindowStateManager()","    @State private var cxrSession = CloudXRKit.Session(config: CloudXRKit.Config())","    @Environment(\\.openWindow) var openWindow","    @Environment(\\.dismissWindow) var dismissWindow","    @Environment(\\.openImmersiveSpace) var openImmersiveSpace","    @Environment(\\.dismissImmersiveSpace) var dismissImmersiveSpace","    @Environment(\\.scenePhase) var scenePhase","","    var body: some Scene {","        WindowGroup(id: \"LaunchWindow\") {","            YourContentView() \/\/ Your app's main UI","                .onAppear {","                    \/\/ Configure window manager with SwiftUI actions","                    windowManager.windowOnAppear(","                        openImmersiveSpace: openImmersiveSpace,","                        dismissImmersiveSpace: dismissImmersiveSpace,","                        openWindow: openWindow,","                        dismissWindow: dismissWindow","                    )","","                    \/\/ Set up session callbacks","                    windowManager.onSessionPauseRequested = {","                        cxrSession.pause()","                    }","","                    windowManager.onSessionResumeRequested = {","                        try await cxrSession.resume()","                    }","                }","                .onDisappear {","                    windowManager.windowOnDisappear()","                }","                .onChange(of: scenePhase) { _, newPhase in","                    windowManager.windowOnScenePhaseChange(scenePhase: newPhase)","                }","                .onChange(of: cxrSession.state) { oldState, newState in","                    Task {","                        await windowManager.onSessionStateChanged(","                            oldState: oldState,","                            newState: newState","                        )","                    }","                }","        }","        .environmentObject(windowManager)","","        ImmersiveSpace(id: \"ImmersiveSpace\") {","            YourStreamingView(cxrSession: cxrSession) \/\/ Your CloudXR streaming view","                .onAppear {","                    windowManager.immersiveSpaceOnAppear()","                }","                .onDisappear {","                    windowManager.immersiveSpaceOnDisappear()","                }","                .onTapGesture(count: 3) {","                    \/\/ RECOVERY MECHANISM: Triple-tap to toggle window","                    windowManager.toggleWindow()","                }","        }","        .environmentObject(windowManager)","    }","}"],"type":"codeListing"},{"style":"note","name":"Note","type":"aside","content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Note"}]},{"text":": ","type":"text"},{"code":"YourStreamingView","type":"codeVoice"},{"text":" should be your implementation that displays CloudXR content using the CloudXRKit session. This typically involves creating a RealityKit view that renders the streamed content.","type":"text"}],"type":"paragraph"}]},{"anchor":"Event-Flow-and-Handling","type":"heading","level":2,"text":"Event Flow and Handling"},{"anchor":"3-Window-Lifecycle-Events","type":"heading","level":3,"text":"3. Window Lifecycle Events"},{"anchor":"31-Window-Appearance","type":"heading","level":4,"text":"3.1 Window Appearance"},{"syntax":"swift","code":["func windowOnAppear(openImmersiveSpace: OpenImmersiveSpaceAction,","                    dismissImmersiveSpace: DismissImmersiveSpaceAction,","                    openWindow: OpenWindowAction,","                    dismissWindow: DismissWindowAction) {","    \/\/ Step 1: Validate state","    guard !windowVisible else {","        Self.logger.error(\"windowOnAppear called while window already open\")","        return","    }","","    \/\/ Step 2: Configure dependencies (first time only)","    if !configured {","        self.openImmersiveSpace = openImmersiveSpace","        self.dismissImmersiveSpace = dismissImmersiveSpace","        self.openWindow = openWindow","        self.dismissWindow = dismissWindow","        configured = true","    }","","    \/\/ Step 3: Update state","    windowVisible = true","}"],"type":"codeListing"},{"anchor":"32-Window-Disappearance","type":"heading","level":4,"text":"3.2 Window Disappearance"},{"syntax":"swift","code":["func windowOnDisappear() {","    guard windowVisible else {","        fatalError(\"windowOnDisappear called when window is already dismissed\")","    }","    windowVisible = false","}"],"type":"codeListing"},{"anchor":"4-Scene-Phase-Changes","type":"heading","level":3,"text":"4. Scene Phase Changes"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The scene phase handler manages app lifecycle transitions:"}]},{"syntax":"swift","code":["func windowOnScenePhaseChange(scenePhase: ScenePhase) {","    guard configured else {","        fatalError(\"Window manager not configured when scene phase changed\")","    }","","    switch scenePhase {","    case .inactive:","        \/\/ App is becoming inactive (e.g., another app is in focus)","        if windowVisible {","            dismissWindow(id: launchWindowId)","        }","","    case .active:","        \/\/ App is becoming active","        if sessionState == .paused {","            Task { @MainActor in","                try? await onSessionResumeRequested?()","                if !immersiveSpaceActive {","                    await openImmersiveSpace(id: immersiveSpaceId)","                }","            }","        }","","    case .background:","        \/\/ App is in background (handle in ImmersiveSpace)","        break","","    @unknown default:","        break","    }","}"],"type":"codeListing"},{"anchor":"5-Immersive-Space-Events","type":"heading","level":3,"text":"5. Immersive Space Events"},{"anchor":"51-Immersive-Space-Appearance","type":"heading","level":4,"text":"5.1 Immersive Space Appearance"},{"syntax":"swift","code":["func immersiveSpaceOnAppear() {","    guard !immersiveSpaceActive else {","        fatalError(\"Immersive space was already active when onAppear was called\")","    }","    immersiveSpaceActive = true","}"],"type":"codeListing"},{"anchor":"52-Immersive-Space-Disappearance-Crown-Press-Recovery","type":"heading","level":4,"text":"5.2 Immersive Space Disappearance (Crown Press Recovery)"},{"syntax":"swift","code":["func immersiveSpaceOnDisappear() {","    guard immersiveSpaceActive else {","        fatalError(\"Immersive space state incorrect on disappear\")","    }","","    guard configured else {","        fatalError(\"Window manager not configured when immersive space disappeared\")","    }","","    immersiveSpaceActive = false","","    \/\/ RECOVERY MECHANISM: Automatically restore window when exiting immersive space","    if windowVisible == false {","        openWindow(id: \"LaunchWindow\")","    }","","    \/\/ Handle session state","    switch sessionState {","    case .disconnecting, .disconnected, .initialized, .pausing, .paused:","        return","    default:","        if pauseOnImmersiveSpaceDismissed {","            onSessionPauseRequested?()","        }","    }","}"],"type":"codeListing"},{"anchor":"Recovery-Mechanisms-Implementation","type":"heading","level":2,"text":"Recovery Mechanisms Implementation"},{"anchor":"6-Triple-Tap-Gesture-Recovery","type":"heading","level":3,"text":"6. Triple-Tap Gesture Recovery"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Implementation in the ImmersiveSpace view:"}]},{"syntax":"swift","code":["ImmersiveSpace(id: \"ImmersiveSpace\") {","    StreamingView(cxrSession: cxrSession)","        .onTapGesture(count: 3) {","            windowManager.toggleWindow()","        }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Toggle window implementation:"}]},{"syntax":"swift","code":["func toggleWindow() {","    guard configured else {","        Self.logger.error(\"Window manager is not configured when toggling the window\")","        return","    }","","    if windowVisible {","        dismissWindow(id: launchWindowId)","    } else {","        openWindow(id: launchWindowId)","    }","}"],"type":"codeListing"},{"anchor":"7-Connection-State-Recovery","type":"heading","level":3,"text":"7. Connection State Recovery"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Hook up session state changes:"}]},{"syntax":"swift","code":["\/\/ Session state changes are handled via onChange modifier",".onChange(of: cxrSession.state) { oldState, newState in","    Task { @MainActor in","        await windowManager.onSessionStateChanged(","            oldState: oldState,","            newState: newState","        )","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Implementation:"}]},{"syntax":"swift","code":["func onSessionStateChanged(oldState: SessionState, newState: SessionState) async {","    \/\/ Update internal session state","    sessionState = newState","","    switch newState {","    case .connected:","        await handleConnectionEstablished()","    case .disconnected:","        await handleDisconnection()","    default:","        return","    }","}","","private func handleDisconnection() async {","    guard configured else {","        Self.logger.error(\"Disconnection before window manager was configured\")","        return","    }","","    \/\/ RECOVERY MECHANISM: Restore window on disconnection","    if windowVisible == false {","        await openWindow(id: launchWindowId)","    }","","    if immersiveSpaceActive == true {","        await dismissImmersiveSpace()","    }","}","","private func handleConnectionEstablished() async {","    guard configured else {","        Self.logger.error(\"Connection established before window manager was configured\")","        return","    }","","    if !immersiveSpaceActive {","        await openImmersiveSpace(id: immersiveSpaceId)","    }","","    \/\/ Hide window based on debug settings","    #if DEBUG","    if debugHideWindowAtConnection {","        await dismissWindow(id: launchWindowId)","    }","    #else","    await dismissWindow(id: launchWindowId)","    #endif","}"],"type":"codeListing"},{"anchor":"Usage-in-Your-Views","type":"heading","level":2,"text":"Usage in Your Views"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When using the WindowStateManager in your views, access it via @EnvironmentObject:"}]},{"syntax":"swift","code":["struct YourView: View {","    @EnvironmentObject var windowManager: WindowStateManager","","    var body: some View {","        \/\/ Your view implementation","    }","}"],"type":"codeListing"},{"anchor":"Testing-and-Validation","type":"heading","level":2,"text":"Testing and Validation"},{"anchor":"8-Test-Scenarios","type":"heading","level":3,"text":"8. Test Scenarios"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Normal Flow"}],"type":"strong"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Launch app → Window appears","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Connect → Window dismisses, immersive space opens","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Triple-tap → Window toggles","type":"text"}]}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Crown Press Recovery"}],"type":"strong"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"In immersive space → Press crown","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Verify: Window automatically reopens","type":"text"}]}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Disconnection Recovery"}],"type":"strong"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Hide window → Disconnect session","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Verify: Window automatically reopens","type":"text"}]}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Rapid Toggle Test"}],"type":"strong"}]},{"syntax":"swift","type":"codeListing","code":["func testRapidToggle() async {","    for _ in 0..<10 {","        windowManager.toggleWindow()","        try? await Task.sleep(nanoseconds: 100_000_000) \/\/ 0.1s","    }","    \/\/ Verify final state is consistent","}"]}]}]},{"anchor":"9-State-Validation","type":"heading","level":3,"text":"9. State Validation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add debug assertions:"}]},{"syntax":"swift","code":["#if DEBUG","extension WindowStateManager {","    func validateState() {","        assert(!(windowVisible && !configured), \"Window visible but manager not configured\")","        assert(!(immersiveSpaceActive && !configured), \"Immersive space active but manager not configured\")","    }","}","#endif"],"type":"codeListing"},{"anchor":"Best-Practices","type":"heading","level":2,"text":"Best Practices"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Always validate state before operations"}],"type":"strong"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Use @MainActor for UI operations"}],"type":"strong"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Handle all error cases gracefully"}],"type":"strong"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Provide multiple recovery paths"}],"type":"strong"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Test edge cases thoroughly"}],"type":"strong"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Document recovery methods for users"}],"type":"strong"}]}]}]},{"anchor":"Common-Pitfalls","type":"heading","level":2,"text":"Common Pitfalls"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Race Conditions"}],"type":"strong"},{"type":"text","text":": Use proper state management and locks"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Missing Configuration"}],"type":"strong"},{"type":"text","text":": Ensure window manager is configured before use"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Async\/Await Misuse"}],"type":"strong"},{"type":"text","text":": Always await async operations properly"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"State Inconsistency"}],"type":"strong"},{"type":"text","text":": Validate state transitions"}]}]}]},{"anchor":"Integration-Example","type":"heading","level":2,"text":"Integration Example"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Here’s how to integrate the window manager into your CloudXRKit application:"}]},{"syntax":"swift","code":["\/\/ WindowStateManager+Extensions.swift","extension WindowStateManager {","    \/\/ Public method to update session state from outside","    func updateSessionState(_ newState: SessionState) {","        lock.withLock {","            sessionState = newState","        }","    }","","    \/\/ Configuration options","    func configure(debugHideWindow: Bool = false,","                   pauseOnDismiss: Bool = true) {","        debugHideWindowAtConnection = debugHideWindow","        pauseOnImmersiveSpaceDismissed = pauseOnDismiss","    }","}","","\/\/ In your app initialization","let windowManager = WindowStateManager()","windowManager.configure(","    debugHideWindow: false,","    pauseOnDismiss: true",")"],"type":"codeListing"}],"kind":"content"}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.nvidia.CloudXRKit\/documentation\/CloudXRKit\/WindowManagement"},"metadata":{"roleHeading":"Article","modules":[{"name":"CloudXRKit"}],"role":"article","title":"Window State Manager Implementation Guide for CloudXRKit Apps"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/cloudxrkit\/windowmanagement"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/cloudxrkit\/windowmanagement"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/com.nvidia.CloudXRKit\/documentation\/CloudXRKit"]]},"references":{"doc://com.nvidia.CloudXRKit/documentation/CloudXRKit":{"url":"\/documentation\/cloudxrkit","abstract":[{"text":"Stream immersive applications.","type":"text"}],"identifier":"doc:\/\/com.nvidia.CloudXRKit\/documentation\/CloudXRKit","type":"topic","role":"collection","title":"CloudXRKit","kind":"symbol"}},"variantOverrides":[{"traits":[{"interfaceLanguage":"occ"}],"patch":[{"path":"\/identifier\/interfaceLanguage","value":"occ","op":"replace"},{"path":"\/topicSections","value":null,"op":"add"},{"path":"\/seeAlsoSections","value":null,"op":"add"}]}]}