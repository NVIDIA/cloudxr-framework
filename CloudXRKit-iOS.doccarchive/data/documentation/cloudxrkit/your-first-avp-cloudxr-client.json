           HStack {","                    Text(\"IP Address\")","                    Spacer()","                    TextField(\"0.0.0.0\", text: ContentView.$ipAddress)","                        .autocorrectionDisabled(true)","                        .keyboardType(.numbersAndPunctuation)","                        .textInputAutocapitalization(.never)","                        .searchDictationBehavior(.inline(activation: .onLook))","                        .onSubmit {","                            \/\/ strip whitespace","                            ContentView.ipAddress = ContentView.ipAddress.trimmingCharacters(","                                in: .whitespacesAndNewlines","                            )","                        }","                }","            }","            ","            Model3D(named: \"Scene\", bundle: realityKitContentBundle)","                .padding(.bottom, 50)","","            Button(\"Connect\") {","                Task { @MainActor in","                    var config = CloudXRKit.Config()","                    \/\/ Configure our IP address","                    config.connectionType = .local(ip: ContentView.ipAddress)","                    \/\/ Set the resolution preset to low-resolution for testing; normally use .standardPreset","                    config.resolutionPreset = .standardPreset","                    cxrSession.configure(config: config)","                    \/\/ Connect!","                    try await cxrSession.connect()","                }","            }.padding()","        }","        .padding()","    }","}"],"syntax":"swift","type":"codeListing"},{"level":2,"type":"heading","anchor":"Streaming-content-from-a-server","text":"Streaming content from a server"},{"inlineContent":[{"text":"In order for CloudXR to stream, it needs the current space to be a RealityKit ImmersiveSpace that is properly “hooked up”.","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Create","type":"text"}],"type":"strong"},{"text":" a new empty file (File > New > Empty File) called ","type":"text"},{"code":"ImmersiveView.swift","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"identifier":"empty-file.png","type":"image"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Let’s start with imports and the basic structure of View. ","type":"text"},{"inlineContent":[{"text":"Add","type":"text"}],"type":"strong"},{"text":" the following code to the empty file.","type":"text"}],"type":"paragraph"}]}],"start":2},{"code":["import SwiftUI","import RealityKit","","import CloudXRKit","","let streamingSpaceTitle = \"CxrStreamingImmersiveSpace\"","","struct ImmersiveView: View {","    var body: some View {","        RealityView { content in","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"This view will need to be able to see the CloudXR Session object, just like ","type":"text"},{"code":"ContentView","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Add the following code inside of ","type":"text"},{"code":"ImmersiveView","type":"codeVoice"},{"text":" and before ","type":"text"},{"code":"body","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"start":3},{"code":["@Environment(CloudXRSession.self) var cxrSession"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Here is a reference on placement:","type":"text"}],"type":"paragraph"},{"code":["...","","struct ImmersiveView: View {","    ","    \/\/ The new section","","    @Environment(CloudXRSession.self) var cxrSession","","    \/\/ end of the new Section","    ","    var body: some View {","        ...","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"CloudXR also needs know about the scene and this session, so we need an ","type":"text"},{"code":"Entity","type":"codeVoice"},{"text":" to glue it all together. Add the following code after ","type":"text"},{"code":"cxrSession","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"start":4},{"code":["@State private var sessionEntity = Entity()    "],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Here is a reference on placement:","type":"text"}],"type":"paragraph"},{"code":["...","","struct ImmersiveView: View {","    ","    @Environment(CloudXRSession.self) var cxrSession","","    \/\/ The new section","","    @State private var sessionEntity = Entity()","","    \/\/ end of the new section","    ","    var body: some View {","        ...","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Next, we need to create a ","type":"text"},{"code":"CloudXRSessionComponent","type":"codeVoice"},{"text":" in the (at this point, active) scene that knows about the connected ","type":"text"},{"code":"CloudXRSession","type":"codeVoice"},{"text":". Add the following code inside of ","type":"text"},{"code":"RealityView","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"start":5},{"code":["sessionEntity.name = \"Session\"","","\/\/ Just a quick check; this View shouldn't be opened unless we're connected.","if cxrSession.state != .connected {","    print(\"Oops, we shouldn't be trying to render CloudXR without being connected!\")","}","","sessionEntity.components[CloudXRSessionComponent.self] = .init(session: cxrSession)","sessionEntity.transform = .init()","content.add(sessionEntity)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"This new View is not (yet) being opened. To do that, we need to go back to the main app file (","type":"text"},{"code":"My_First_AVP_CloudXR_ClientApp.swift","type":"codeVoice"},{"text":" or similar) and add it to the end of our Sc