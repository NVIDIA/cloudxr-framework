ent","","import CloudXRKit","","struct ContentView: View {","    ","    @Environment(CloudXRSession.self) var cxrSession","    ","    \/\/ Configurable session settings.","    @AppStorage(\"ipAddress\") static var ipAddress: String = \"\"","    @AppStorage(\"resolutionPreset\") private var resolutionPreset: ResolutionPreset = .standardPreset","    ","    var body: some View {","        VStack {","            ","            Form {","                HStack {","                    Text(\"IP Address\")","                    Spacer()","                    TextField(\"0.0.0.0\", text: ContentView.$ipAddress)","                        .autocorrectionDisabled(true)","                        .keyboardType(.numbersAndPunctuation)","                        .textInputAutocapitalization(.never)","                        .searchDictationBehavior(.inline(activation: .onLook))","                        .onSubmit {","                            \/\/ strip whitespace","                            ContentView.ipAddress = ContentView.ipAddress.trimmingCharacters(","                                in: .whitespacesAndNewlines","                            )","                        }","                }","            }","            ","            Model3D(named: \"Scene\", bundle: realityKitContentBundle)","                .padding(.bottom, 50)","","            Button(\"Connect\") {","                Task { @MainActor in","                    var config = CloudXRKit.Config()","                    \/\/ Configure our IP address","                    config.connectionType = .local(ip: ContentView.ipAddress)","                    \/\/ Set the resolution preset to low-resolution for testing; normally use .standardPreset","                    config.resolutionPreset = .standardPreset","                    cxrSession.configure(config: config)","                    \/\/ Connect!","                    try await cxrSession.connect()","                }","            }.padding()","        }","        .padding()","    }","}"]},{"anchor":"Streaming-content-from-a-server","level":2,"text":"Streaming content from a server","type":"heading"},{"inlineContent":[{"text":"In order for CloudXR to stream, it needs the current space to be a RealityKit ImmersiveSpace that is properly “hooked up”.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Create","type":"text"}],"type":"strong"},{"type":"text","text":" a new empty file (File > New > Empty File) called "},{"type":"codeVoice","code":"ImmersiveView.swift"},{"type":"text","text":"."}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"identifier":"empty-file.png","type":"image"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Let’s start with imports and the basic structure of View. ","type":"text"},{"inlineContent":[{"type":"text","text":"Add"}],"type":"strong"},{"text":" the following code to the empty file.","type":"text"}]}]}],"start":2,"type":"orderedList"},{"syntax":"swift","code":["import SwiftUI","import RealityKit","","import CloudXRKit","","let streamingSpaceTitle = \"CxrStreamingImmersiveSpace\"","","struct ImmersiveView: View {","    var body: some View {","        RealityView { content in","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"This view will need to be able to see the CloudXR Session object, just like "},{"type":"codeVoice","code":"ContentView"},{"type":"text","text":"."}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Add the following code inside of ","type":"text"},{"code":"ImmersiveView","type":"codeVoice"},{"text":" and before ","type":"text"},{"code":"body","type":"codeVoice"},{"text":".","type":"text"}]}]}],"start":3,"type":"orderedList"},{"syntax":"swift","code":["@Environment(CloudXRSession.self) var cxrSession"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Here is a reference on placement:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["...","","struct ImmersiveView: View {","    ","    \/\/ The new section","","    @Environment(CloudXRSession.self) var cxrSession","","    \/\/ end of the new Section","    ","    var body: some View {","        ...","    }","}"]},{"type":"orderedList","start":4,"items":[{"content":[{"inlineContent":[{"type":"text","text":"CloudXR also needs know about the scene and this session, so we need an "},{"type":"codeVoice","code":"Entity"},{"type":"text","text":" to glue it all together. Add the following code after "},{"type":"codeVoice","code":"cxrSession"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"type":"codeListing","syntax":"swift","code":["@State private var sessionEntity = Entity()    "]},{"inlineContent":[{"type":"text","text":"Here is a reference on placement:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["...","","struct ImmersiveView: View {","    ","    @Environment(CloudXRSession.self) var cxrSession","","    \/\/ The new section","","    @State private var sessionEntity = Entity()","","    \/\/ end of the new section","    ","    var body: some View {","        ...","    }","}"]},{"type":"orderedList","start":5,"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Next, we need to create a "},{"code":"CloudXRSessionComponent","type":"codeVoice"},{"type":"text","text":" in the (at this point, active) scene that knows about the connected "},{"code":"CloudXRSession","type":"codeVoice"},{"type":"text","text":". Add the following code inside of "},{"code":"RealityView","type":"codeVoice"},{"type":"text","text":"."}]}]}]},{"type":"codeListing","syntax":"swift","code":["sessionEntity.name = \"Session\"","","\/\/ Just a quick check; this View shouldn't be opened unless we're connected.","if cxrSession.state != .connected {","    print(\"Oops, we shouldn't be trying to render CloudXR without being connected!\")","}","","sessionEntity.components[CloudXRSessionComponent.self] = .init(session: cxrSession)","sessionEntity.transform = .init()","content.add(sessionEntity)"]},{"inlineContent":[{"type":"text","text":"This new View is not (yet) being opened. To do that, we need to go back to the main app file ("},{"type":"codeVoice","code":"My_First_AVP_CloudXR_ClientApp.swift"},{"type":"text","text":" or similar) and add it to the end of our Scene."}],"type":"paragraph"},{"type":"orderedList","start":6,"items":[{"content":[{"inlineContent":[{"text":"Go to ","type":"text"},{"code":"My_First_AVP_CloudXR_ClientApp.swift","type":"codeVoice"},{"text":" and add the following code inside of ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" and after ","type":"text"},{"type":"codeVoice","code":"WindowGroup"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"syntax":"swift","type":"codeListing","code":["ImmersiveSpace(id: streamingSpaceTitle) {","    ImmersiveView()","}",".environment(cxrSession)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Here is a reference on placement:"}]},{"syntax":"swift","type":"codeListing","code":["...","","@main","struct My_First_AVP_CloudXR_ClientApp: App {","    ","    ...","    ","    var body: some Scene {","        ...","","        WindowGroup {","            ...","        }","        .environment(cxrSession)","","        \/\/ The new section","        ","        ImmersiveSpace(id: streamingSpaceTitle) {","            ImmersiveView()","        }","        .environment(cxrSession)","","        \/\/ end of the new section","    }","}",""]},{"type":"paragraph","inlineContent":[{"text":"Back in ","type":"text"},{"code":"ContentView.swift","type":"codeVoice"},{"text":", we need to ","type":"text"},{"inlineContent":[{"type":"text","text":"open"}],"type":"emphasis"},{"text":" this ImmersiveSpace once CloudXR is connected which will require us to bring in ","type":"text"},{"code":"openImmersiveSpace","type":"codeVoice"},{"text":" from the environment.","type":"text"}]},{"type":"orderedList","start":7,"items":[{"content":[{"inlineContent":[{"text":"Go to ","type":"text"},{"type":"codeVoice","code":"ContentView.swift"},{"text":", and add the following code after ","type":"text"},{"type":"codeVoice","code":"cxrSession"},{"type":"text","text":" but before "},{"type":"codeVoice","code":"ipAddress"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"syntax":"swift","type":"codeListing","code":["@Environment(\\.openImmersiveSpace) var openImmersiveSpace"]},{"inlineContent":[{"text":"Here is a reference on placement:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["...","","struct ContentView: View {","    ","    @Environment(CloudXRSession.self) var cxrSession","","    \/\/ The new section","","    @Environment(\\.openImmersiveSpace) var openImmersiveSpace","","    \/\/ end of the new section","    ","    \/\/ Configurable session settings.","    @AppStorage(\"ipAddress\") static var ipAddress: String = \"\"","    @AppStorage(\"resolutionPreset\") private var resolutionPreset: ResolutionPreset = .standardPreset","    ","    var body: some View {","        ...","    }","}"],"type":"codeListing"},{"type":"orderedList","start":8,"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the following code after "},{"code":"try await cxrSession.connect()","type":"codeVoice"},{"type":"text","text":" inside "},{"code":"Task","type":"codeVoice"},{"type":"text","text":"."}]}]}]},{"type":"codeListing","syntax":null,"code":["await openImmersiveSpace(id: streamingSpaceTitle)"]},{"inlineContent":[{"type":"text","text":"Here is a reference on placement:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["...","","struct ContentView: View {","    ","    ...","    ","    var body: some View {","        VStack {","            ","            ...","","            Button(\"Connect\") {","                Task { @MainActor in","                    ...","","                    try await cxrSession.connect()","                    ","                    \/\/ The new section","","                    await openImmersiveSpace(id: streamingSpaceTitle)","","                    \/\/ end of the new section","                }","            }.padding()","        }","        .padding()","    }","}",""]},{"type":"paragraph","inlineContent":[{"text":"Make sure your test server is running!","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"💻 Check: 🛠️ Builds, Runs, Connects, Streams!!","type":"text"}]},{"inlineContent":[{"text":"You should see streaming content that appears to be in the “room”.","type":"text"},{"text":" ","type":"text"},{"type":"image","identifier":"image-5.png"}],"type":"paragraph"},{"text":"`My_First_AVP_CloudXR_ClientApp.swift` complete","level":2,"type":"heading","anchor":"MyFirstAVPCloudXRClientAppswift-complete"},{"syntax":"swift","code":["import SwiftUI","","import CloudXRKit","","@main","struct My_First_AVP_CloudXR_ClientApp: App {","    ","    @State private var cxrSession = CloudXRSession(","        config: CloudXRKit.Config()","    )","","    init() {","        CloudXRKit.registerSystems()","    }","    ","    var body: some Scene {","        WindowGroup {","            ContentView()","        }","        .environment(cxrSession)","        ","        ImmersiveSpace(id: streamingSpaceTitle) {","            ImmersiveView()","        }","        .environment(cxrSession)","    }","}",""],"type":"codeListing"},{"level":2,"type":"heading","text":"`ContentView.swift` complete","anchor":"ContentViewswift-complete"},{"code":["import SwiftUI","import RealityKit","import RealityKitContent","","import CloudXRKit","","struct ContentView: View {","    ","    @Environment(CloudXRSession.self) var cxrSession","    @Environment(\\.openImmersiveSpace) var openImmersiveSpace","    ","    \/\/ Configurable session settings.","    @AppStorage(\"ipAddress\") static var ipAddress: String = \"\"","    @AppStorage(\"resolutionPreset\") private var resolutionPreset: ResolutionPreset = .standardPreset","    ","    var body: some View {","        VStack {","            ","            Form {","                HStack {","                    Text(\"IP Address\")","                    Spacer()","                    TextField(\"0.0.0.0\", text: ContentView.$ipAddress)","                        .autocorrectionDisabled(true)","                        .keyboardType(.numbersAndPunctuation)","                        .textInputAutocapitalization(.never)","                        .searchDictationBehavior(.inline(activation: .onLook))","                        .onSubmit {","                            \/\/ strip whitespace","                            ContentView.ipAddress = ContentView.ipAddress.trimmingCharacters(","                                in: .whitespacesAndNewlines","                            )","                        }","                }","            }","            ","            Model3D(named: \"Scene\", bundle: realityKitContentBundle)","                .padding(.bottom, 50)","","            Button(\"Connect\") {","                Task { @MainActor in","                    var config = CloudXRKit.Config()","                    \/\/ Configure our IP address","                    config.connectionType = .local(ip: ContentView.ipAddress)","                    \/\/ Set the resolution preset to low-resolution for testing; normally use .standardPreset","                    config.resolutionPreset = .standardPreset","                    cxrSession.configure(config: config)","                    \/\/ Connect!","                    try await cxrSession.connect()","                    ","                    await openImmersiveSpace(id: streamingSpaceTitle)","                }","            }.padding()","        }","        .padding()","    }","}","","#Preview(windowStyle: .automatic) {","    ContentView()","}",""],"type":"codeListing","syntax":"swift"},{"anchor":"ImmersiveViewswift-complete","leve