{"identifier":{"url":"doc:\/\/com.nvidia.CloudXRKit\/documentation\/CloudXRKit\/OpaqueDataChannel","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The CloudXR Message Channel API provides a bi-directional communication mechanism between the CloudXR client and server applications. This allows you to send custom data alongside the video\/audio streaming, enabling rich interactions between client and server."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On the server-side, this requires the app to implement the XR_NV_opaque_data_channel extension. On the client side, the name used for the API is MessageChannel."}]},{"anchor":"Key-Concepts","type":"heading","level":2,"text":"Key Concepts"},{"anchor":"Message-Channels","type":"heading","level":3,"text":"Message Channels"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Channel","type":"text"}],"type":"strong"},{"type":"text","text":": A bi-directional communication pipe identified by a unique UUID"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Channel Info"}],"type":"strong"},{"type":"text","text":": Contains channel metadata (ID and UUID)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Channel Status","type":"text"}],"type":"strong"},{"type":"text","text":": Tracks the state of a channel (Not Initialized, Ready, or Closed)"}],"type":"paragraph"}]}]},{"text":"Components","anchor":"Components","level":3,"type":"heading"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"CloudXRKit.Session","type":"text"}]},{"text":": Manages available channels and provides access to them","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"MessageChannel"}]},{"text":": Represents an individual communication channel","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"MessageChannelManager","type":"text"}]},{"type":"text","text":": Internal component that handles channel lifecycle"}],"type":"paragraph"}]}]},{"type":"heading","level":2,"text":"API Usage","anchor":"API-Usage"},{"type":"heading","anchor":"1-Discovering-Available-Channels","level":3,"text":"1. Discovering Available Channels"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Channels are announced by the server. Monitor the session’s "},{"type":"codeVoice","code":"availableMessageChannels"},{"type":"text","text":" property:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Access available channels from your CloudXRKit.Session instance","let availableChannels = cxrSession.availableMessageChannels","","\/\/ Each ChannelInfo contains:","\/\/ - channelId: Internal numeric identifier","\/\/ - uuid: Unique identifier as Data (can be converted to string)"]},{"type":"heading","anchor":"2-Opening-a-Channel","level":3,"text":"2. Opening a Channel"},{"inlineContent":[{"type":"text","text":"To start using a channel, retrieve it from the session:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Select a channel from available channels","let channelInfo = cxrSession.availableMessageChannels.first","","\/\/ Get the MessageChannel object","if let channel = cxrSession.getMessageChannel(channelInfo) {","    \/\/ Channel is now ready to use","    print(\"Channel status: \\(channel.status)\")","}"],"type":"codeListing"},{"level":3,"anchor":"3-Sending-Messages","type":"heading","text":"3. Sending Messages"},{"inlineContent":[{"text":"Send data to the server using the channel:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Convert your data to Data format","let message = \"Hello Server\"","if let data = message.data(using: .utf8) {","    let success = channel.sendServerMessage(data)","    if success {","        print(\"Message sent successfully\")","    }","}","","\/\/ You can send any binary data","let binaryData = Data([0x01, 0x02, 0x03, 0x04])","channel.sendServerMessage(binaryData)"],"type":"codeListing"},{"level":3,"anchor":"4-Receiving-Messages","type":"heading","text":"4. Receiving Messages"},{"inlineContent":[{"type":"text","text":"Messages from the server are delivered through an AsyncStream:"}],"type":"paragraph"},{"code":["\/\/ Set up a task to receive messages","Task {","    for await messageData in channel.receivedMessageStream {","        \/\/ Process received data","        if let message = String(data: messageData, encoding: .utf8) {","            print(\"Received: \\(message)\")","        } else {","            \/\/ Handle binary data","            print(\"Received \\(messageData.count) bytes\")","        }","    }","    \/\/ Stream ended - channel is closed","    print(\"Channel closed\")","}"],"syntax":"swift","type":"codeListing"},{"text":"5. Channel Status","type":"heading","level":3,"anchor":"5-Channel-Status"},{"type":"paragraph","inlineContent":[{"text":"Monitor the channel status to ensure proper operation:","type":"text"}]},{"type":"codeListing","code":["switch channel.status {","case .notInitialized:","    print(\"Channel not yet initialized\")","case .ready:","    print(\"Channel ready for communication\")","case .closed:","    print(\"Channel has been closed\")","}"],"syntax":"swift"},{"text":"6. Closing a Channel","level":3,"type":"heading","anchor":"6-Closing-a-Channel"},{"type":"paragraph","inlineContent":[{"text":"Explicitly close a channel when done:","type":"text"}]},{"type":"codeListing","code":["channel.disconnect()"],"syntax":"swift"},{"text":"Complete Example","type":"heading","level":2,"anchor":"Complete-Example"},{"type":"paragraph","inlineContent":[{"text":"Here’s a complete example showing typical usage:","type":"text"}]},{"type":"codeListing","code":["import CloudXRKit","import SwiftUI","","struct MessageChannelExample: View {","    let cxrSession: CloudXRKit.Session","    @State private var currentChannel: MessageChannel?","    @State private var receivedMessages: [String] = []","    @State private var readerTask: Task<Void, Never>?","","    var body: some View {","        VStack {","            \/\/ Channel selection","            if let firstChannel = cxrSession.availableMessageChannels.first {","                Button(\"Open Channel\") {","                    openChannel(firstChannel)","                }","            }","","            \/\/ Send message","            if currentChannel?.status == .ready {","                Button(\"Send Hello\") {","                    sendMessage(\"Hello from client!\")","                }","            }","","            \/\/ Display received messages","            List(receivedMessages, id: \\.self) { message in","                Text(message)","            }","        }","        .onDisappear {","            \/\/ Clean up","            readerTask?.cancel()","            currentChannel?.disconnect()","        }","    }","","    func openChannel(_ channelInfo: ChannelInfo) {","        guard let channel = cxrSession.getMessageChannel(channelInfo) else {","            print(\"Failed to open channel\")","            return","        }","","        currentChannel = channel","","        \/\/ Start receiving messages","        readerTask = Task {","            for await data in channel.receivedMessageStream {","                if let message = String(data: data, encoding: .utf8) {","                    await MainActor.run {","                        receivedMessages.append(message)","                    }","                }","            }","        }","    }","","    func sendMessage(_ text: String) {","        guard let data = text.data(using: .utf8),","              let channel = currentChannel else { return }","","        _ = channel.sendServerMessage(data)","    }","}"],"syntax":"swift"},{"text":"Best Practices","type":"heading","level":2,"anchor":"Best-Practices"},{"text":"1. Error Handling","type":"heading","level":3,"anchor":"1-Error-Handling"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Always check if ","type":"text"},{"type":"codeVoice","code":"getMessageChannel()"},{"text":" returns a valid channel","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Verify ","type":"text"},{"code":"sendServerMessage()","type":"codeVoice"},{"text":" return value for send confirmation","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Handle channel closure gracefully in your receive loop","type":"text"}],"type":"paragraph"}]}]},{"text":"2. Data Encoding","anchor":"2-Data-Encoding","level":3,"type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Use consistent encoding between client and server (e.g., UTF-8 for text)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Consider using structured formats (JSON, Protocol Buffers) for complex data"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Handle binary data appropriately","type":"text"}]}]}]},{"text":"3. Resource Management","anchor":"3-Resource-Management","level":3,"type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Cancel reader tasks when no longer needed","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Disconnect channels explicitly when done","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Monitor channel status changes","type":"text"}],"type":"paragraph"}]}]},{"text":"4. Performance Considerations","anchor":"4-Performance-Considerations","level":3,"type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Message channels share bandwidth with video\/audio streaming","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Avoid sending large amounts of data frequently","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Consider batching small messages","type":"text"}],"type":"paragraph"}]}]},{"text":"Advanced Usage","anchor":"Advanced-Usage","level":2,"type":"heading"},{"text":"Custom Data Formats","anchor":"Custom-Data-Formats","level":3,"type":"heading"},{"inlineContent":[{"text":"For structured data, consider using JSON:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct GameState: Codable {","    let playerPosition: SIMD3<Float>","    let score: Int","}","","\/\/ Sending","let gameState = GameState(playerPosition: [1, 2, 3], score: 100)","if let jsonData = try? JSONEncoder().encode(gameState) {","    channel.sendServerMessage(jsonData)","}","","\/\/ Receiving","for await data in channel.receivedMessageStream {","    if let gameState = try? JSONDecoder().decode(GameState.self, from: data) {","        print(\"Player at: \\(gameState.playerPosition), Score: \\(gameState.score)\")","    }","}"]},{"text":"Multiple Channels","anchor":"Multiple-Channels","level":3,"type":"heading"},{"inlineContent":[{"text":"You can manage multiple channels simultaneously:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var activeChannels: [ChannelInfo: MessageChannel] = [:]","","\/\/ Open multiple channels","for channelInfo in cxrSession.availableMessageChannels {","    if let channel = cxrSession.getMessageChannel(channelInfo) {","        activeChannels[channelInfo] = channel","        \/\/ Set up individual receivers for each channel","    }","}"]},{"text":"Troubleshooting","anchor":"Troubleshooting","level":2,"type":"heading"},{"text":"Channel Not Available","anchor":"Channel-Not-Available","level":3,"type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Ensure the server has announced the channel","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Check that the session is in connected state","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Verify the channel UUID matches between client and server","type":"text"}],"type":"paragraph"}]}]},{"text":"Messages Not Received","anchor":"Messages-Not-Received","level":3,"type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Confirm the channel status is ","type":"text"},{"code":".ready","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Check that the receive task is running","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Verify data encoding matches between sender and receiver","type":"text"}],"type":"paragraph"}]}]},{"text":"Channel Closes Unexpectedly","anchor":"Channel-Closes-Unexpectedly","level":3,"type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Monitor server-side logs for errors","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Check network connectivity","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Ensure proper error handling in message processing","type":"text"}],"type":"paragraph"}]}]},{"text":"Server-Side Implementation","anchor":"Server-Side-Implementation","level":2,"type":"heading"},{"inlineContent":[{"text":"The server implements the XR_NV_opaque_data_channel OpenXR extension, which maps to the client’s MessageChannel API:","type":"text"}],"type":"paragraph"},{"text":"How Server and Client Connect","anchor":"How-Server-and-Client-Connect","level":3,"type":"heading"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Server creates channel"}],"type":"strong"},{"text":": ","type":"text"},{"code":"xrCreateOpaqueDataChannelNV()","type":"codeVoice"},{"text":" with a UUID","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Client discovers channel"}],"type":"strong"},{"text":": Appears in ","type":"text"},{"code":"availableMessageChannels","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Client opens channel"}],"type":"strong"},{"text":": ","type":"text"},{"code":"getMessageChannel()","type":"codeVoice"},{"text":" initiates connection","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Both wait for ready state"}],"type":"strong"},{"text":": Server polls for CONNECTED, client for ready","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Exchange messages"}],"type":"strong"},{"text":": ","type":"text"},{"code":"xrSend\/ReceiveOpaqueDataChannelNV","type":"codeVoice"},{"text":" ↔ ","type":"text"},{"code":"sendServerMessage\/receivedMessageStream","type":"codeVoice"}]}]}]},{"text":"Key Differences","anchor":"Key-Differences","level":3,"type":"heading"},{"inlineContent":[{"inlineContent":[{"text":"Shutdown vs Destroy","type":"text"}],"type":"strong"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"xrShutdownOpaqueDataChannelNV","type":"codeVoice"},{"text":": Gracefully closes connection (client sees “closed”)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"xrDestroyOpaqueDataChannelNV","type":"codeVoice"},{"text":": Frees resources (must call after shutdown)","type":"text"}]}]}]},{"inlineContent":[{"inlineContent":[{"text":"Why Server Waits","type":"text"}],"type":"strong"},{"type":"text","text":": Although server creates the channel, it must wait for client connection due to announcement propagation and handshaking."}],"type":"paragraph"},{"text":"Example Pairing","anchor":"Example-Pairing","level":3,"type":"heading"},{"inlineContent":[{"inlineContent":[{"text":"Server (C++)","type":"text"}],"type":"strong"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"c++","type":"codeListing","code":["\/\/ Create with known UUID","xrCreateOpaqueDataChannelNV(instance, &createInfo, &channel);","WaitForConnection(channel);  \/\/ Poll until CONNECTED","xrSendOpaqueDataChannelNV(channel, len, data);"]},{"inlineContent":[{"inlineContent":[{"text":"Client (Swift)","type":"text"}],"type":"strong"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Find matching UUID","let channel = cxrSession.getMessageChannel(channelInfo)!","channel.sendServerMessage(responseData)"]},{"text":"Summary","anchor":"Summary","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The CloudXR Message Channel API provides a flexible way to extend CloudXR applications with custom communication. By following this guide, you can implement robust bi-directional messaging between your client and server applications."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/com.nvidia.CloudXRKit\/documentation\/CloudXRKit"]]},"kind":"article","variants":[{"paths":["\/documentation\/cloudxrkit\/opaquedatachannel"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/cloudxrkit\/opaquedatachannel"],"traits":[{"interfaceLanguage":"occ"}]}],"metadata":{"role":"article","title":"CloudXR Opaque Data (Message Channel) API User Guide","modules":[{"name":"CloudXRKit"}],"roleHeading":"Article"},"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"references":{"doc://com.nvidia.CloudXRKit/documentation/CloudXRKit":{"identifier":"doc:\/\/com.nvidia.CloudXRKit\/documentation\/CloudXRKit","type":"topic","role":"collection","kind":"symbol","title":"CloudXRKit","abstract":[{"type":"text","text":"Stream immersive applications."}],"url":"\/documentation\/cloudxrkit"}},"variantOverrides":[{"traits":[{"interfaceLanguage":"occ"}],"patch":[{"path":"\/identifier\/interfaceLanguage","value":"occ","op":"replace"},{"path":"\/topicSections","value":null,"op":"add"},{"path":"\/seeAlsoSections","value":null,"op":"add"}]}]}