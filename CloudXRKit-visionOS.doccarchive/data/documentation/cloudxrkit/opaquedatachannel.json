{"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"The CloudXR Message Channel API provides a bi-directional communication mechanism between the CloudXR client and server applications. This allows you to send custom data alongside the video\/audio streaming, enabling rich interactions between client and server."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"On the server-side, this requires the app to implement the XR_NV_opaque_data_channel extension. On the client side, the name used for the API is MessageChannel."}],"type":"paragraph"},{"level":2,"text":"Key Concepts","type":"heading","anchor":"Key-Concepts"},{"level":3,"text":"Message Channels","type":"heading","anchor":"Message-Channels"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Channel","type":"text"}],"type":"strong"},{"text":": A bi-directional communication pipe identified by a unique UUID","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Channel Info","type":"text"}]},{"type":"text","text":": Contains channel metadata (ID and UUID)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Channel Status"}]},{"type":"text","text":": Tracks the state of a channel (Not Initialized, Ready, or Closed)"}]}]}]},{"level":3,"text":"Components","type":"heading","anchor":"Components"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"CloudXRKit.Session"}]},{"type":"text","text":": Manages available channels and provides access to them"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"MessageChannel"}]},{"type":"text","text":": Represents an individual communication channel"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"MessageChannelManager"}]},{"type":"text","text":": Internal component that handles channel lifecycle"}]}]}]},{"level":2,"anchor":"API-Usage","text":"API Usage","type":"heading"},{"level":3,"anchor":"1-Discovering-Available-Channels","text":"1. Discovering Available Channels","type":"heading"},{"inlineContent":[{"type":"text","text":"Channels are announced by the server. Monitor the session’s "},{"type":"codeVoice","code":"availableMessageChannels"},{"type":"text","text":" property:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ Access available channels from your CloudXRKit.Session instance","let availableChannels = cxrSession.availableMessageChannels","","\/\/ Each ChannelInfo contains:","\/\/ - channelId: Internal numeric identifier","\/\/ - uuid: Unique identifier as Data (can be converted to string)"]},{"type":"heading","level":3,"anchor":"2-Opening-a-Channel","text":"2. Opening a Channel"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To start using a channel, retrieve it from the session:"}]},{"code":["\/\/ Select a channel from available channels","let channelInfo = cxrSession.availableMessageChannels.first","","\/\/ Get the MessageChannel object","if let channel = cxrSession.getMessageChannel(channelInfo) {","    \/\/ Channel is now ready to use","    print(\"Channel status: \\(channel.status)\")","}"],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","anchor":"3-Sending-Messages","text":"3. Sending Messages"},{"inlineContent":[{"text":"Send data to the server using the channel:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ Convert your data to Data format","let message = \"Hello Server\"","if let data = message.data(using: .utf8) {","    let success = channel.sendServerMessage(data)","    if success {","        print(\"Message sent successfully\")","    }","}","","\/\/ You can send any binary data","let binaryData = Data([0x01, 0x02, 0x03, 0x04])","channel.sendServerMessage(binaryData)"]},{"text":"4. Receiving Messages","type":"heading","level":3,"anchor":"4-Receiving-Messages"},{"type":"paragraph","inlineContent":[{"text":"Messages from the server are delivered through an AsyncStream:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Set up a task to receive messages","Task {","    for await messageData in channel.receivedMessageStream {","        \/\/ Process received data","        if let message = String(data: messageData, encoding: .utf8) {","            print(\"Received: \\(message)\")","        } else {","            \/\/ Handle binary data","            print(\"Received \\(messageData.count) bytes\")","        }","    }","    \/\/ Stream ended - channel is closed","    print(\"Channel closed\")","}"]},{"anchor":"5-Channel-Status","text":"5. Channel Status","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Monitor the channel status to ensure proper operation:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["switch channel.status {","case .notInitialized:","    print(\"Channel not yet initialized\")","case .ready:","    print(\"Channel ready for communication\")","case .closed:","    print(\"Channel has been closed\")","}"]},{"type":"heading","level":3,"text":"6. Closing a Channel","anchor":"6-Closing-a-Channel"},{"inlineContent":[{"type":"text","text":"Explicitly close a channel when done:"}],"type":"paragraph"},{"code":["channel.disconnect()"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Complete Example","type":"heading","anchor":"Complete-Example"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Here’s a complete example showing typical usage:"}]},{"type":"codeListing","syntax":"swift","code":["import CloudXRKit","import SwiftUI","","struct MessageChannelExample: View {","    let cxrSession: CloudXRKit.Session","    @State private var currentChannel: MessageChannel?","    @State private var receivedMessages: [String] = []","    @State private var readerTask: Task<Void, Never>?","","    var body: some View {","        VStack {","            \/\/ Channel selection","            if let firstChannel = cxrSession.availableMessageChannels.first {","                Button(\"Open Channel\") {","                    openChannel(firstChannel)","                }","            }","","            \/\/ Send message","            if currentChannel?.status == .ready {","                Button(\"Send Hello\") {","                    sendMessage(\"Hello from client!\")","                }","            }","","            \/\/ Display received messages","            List(receivedMessages, id: \\.self) { message in","                Text(message)","            }","        }","        .onDisappear {","            \/\/ Clean up","            readerTask?.cancel()","            currentChannel?.disconnect()","        }","    }","","    func openChannel(_ channelInfo: ChannelInfo) {","        guard let channel = cxrSession.getMessageChannel(channelInfo) else {","            print(\"Failed to open channel\")","            return","        }","","        currentChannel = channel","","        \/\/ Start receiving messages","        readerTask = Task {","            for await data in channel.receivedMessageStream {","                if let message = String(data: data, encoding: .utf8) {","                    await MainActor.run {","                        receivedMessages.append(message)","                    }","                }","            }","        }","    }","","    func sendMessage(_ text: String) {","        guard let data = text.data(using: .utf8),","              let channel = currentChannel else { return }","","        _ = channel.sendServerMessage(data)","    }","}"]},{"level":2,"type":"heading","text":"Best Practices","anchor":"Best-Practices"},{"type":"heading","level":3,"text":"1. Error Handling","anchor":"1-Error-Handling"},{"items":[{"content":[{"inlineContent":[{"text":"Always check if ","type":"text"},{"code":"getMessageChannel()","type":"codeVoice"},{"text":" returns a valid channel","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Verify ","type":"text"},{"type":"codeVoice","code":"sendServerMessage()"},{"text":" return value for send confirmation","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Handle channel closure gracefully in your receive loop"}]}]}],"type":"unorderedList"},{"type":"heading","level":3,"text":"2. Data Encoding","anchor":"2-Data-Encoding"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use consistent encoding between client and server (e.g., UTF-8 for text)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Consider using structured formats (JSON, Protocol Buffers) for complex data"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Handle binary data appropriately"}]}]}],"type":"unorderedList"},{"type":"heading","level":3,"text":"3. Resource Management","anchor":"3-Resource-Management"},{"items":[{"content":[{"inlineContent":[{"text":"Cancel reader tasks when no longer needed","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Disconnect channels explicitly when done"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Monitor channel status changes","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"4-Performance-Considerations","level":3,"type":"heading","text":"4. Performance Considerations"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Message channels share bandwidth with video\/audio streaming","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Avoid sending large amounts of data frequently","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Consider batching small messages"}]}]}],"type":"unorderedList"},{"type":"heading","text":"Advanced Usage","level":2,"anchor":"Advanced-Usage"},{"level":3,"type":"heading","text":"Custom Data Formats","anchor":"Custom-Data-Formats"},{"type":"paragraph","inlineContent":[{"text":"For structured data, consider using JSON:","type":"text"}]},{"code":["struct GameState: Codable {","    let playerPosition: SIMD3<Float>","    let score: Int","}","","\/\/ Sending","let gameState = GameState(playerPosition: [1, 2, 3], score: 100)","if let jsonData = try? JSONEncoder().encode(gameState) {","    channel.sendServerMessage(jsonData)","}","","\/\/ Receiving","for await data in channel.receivedMessageStream {","    if let gameState = try? JSONDecoder().decode(GameState.self, from: data) {","        print(\"Player at: \\(gameState.playerPosition), Score: \\(gameState.score)\")","    }","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Multiple-Channels","text":"Multiple Channels","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"You can manage multiple channels simultaneously:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var activeChannels: [ChannelInfo: MessageChannel] = [:]","","\/\/ Open multiple channels","for channelInfo in cxrSession.availableMessageChannels {","    if let channel = cxrSession.getMessageChannel(channelInfo) {","        activeChannels[channelInfo] = channel","        \/\/ Set up individual receivers for each channel","    }","}"]},{"text":"Troubleshooting","level":2,"type":"heading","anchor":"Troubleshooting"},{"text":"Channel Not Available","level":3,"type":"heading","anchor":"Channel-Not-Available"},{"items":[{"content":[{"inlineContent":[{"text":"Ensure the server has announced the channel","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Check that the session is in connected state","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Verify the channel UUID matches between client and server","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"heading","text":"Messages Not Received","anchor":"Messages-Not-Received","level":3},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Confirm the channel status is ","type":"text"},{"code":".ready","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Check that the receive task is running"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Verify data encoding matches between sender and receiver","type":"text"}]}]}],"type":"unorderedList"},{"type":"heading","level":3,"anchor":"Channel-Closes-Unexpectedly","text":"Channel Closes Unexpectedly"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Monitor server-side logs for errors"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Check network connectivity","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensure proper error handling in message processing"}]}]}]},{"type":"heading","level":2,"anchor":"Server-Side-Implementation","text":"Server-Side Implementation"},{"type":"paragraph","inlineContent":[{"text":"The server implements the XR_NV_opaque_data_channel OpenXR extension, which maps to the client’s MessageChannel API:","type":"text"}]},{"type":"heading","level":3,"anchor":"How-Server-and-Client-Connect","text":"How Server and Client Connect"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Server creates channel","type":"text"}],"type":"strong"},{"text":": ","type":"text"},{"code":"xrCreateOpaqueDataChannelNV()","type":"codeVoice"},{"text":" with a UUID","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Client discovers channel"}],"type":"strong"},{"text":": Appears in ","type":"text"},{"type":"codeVoice","code":"availableMessageChannels"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Client opens channel","type":"text"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"getMessageChannel()"},{"type":"text","text":" initiates connection"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Both wait for ready state"}]},{"text":": Server polls for CONNECTED, client for ready","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Exchange messages"}],"type":"strong"},{"text":": ","type":"text"},{"code":"xrSend\/ReceiveOpaqueDataChannelNV","type":"codeVoice"},{"text":" ↔ ","type":"text"},{"code":"sendServerMessage\/receivedMessageStream","type":"codeVoice"}]}]}]},{"text":"Key Differences","type":"heading","level":3,"anchor":"Key-Differences"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Shutdown vs Destroy","type":"text"}],"type":"strong"},{"text":":","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"xrShutdownOpaqueDataChannelNV"},{"type":"text","text":": Gracefully closes connection (client sees “closed”)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"xrDestroyOpaqueDataChannelNV"},{"type":"text","text":": Frees resources (must call after shutdown)"}]}]}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Why Server Waits","type":"text"}],"type":"strong"},{"text":": Although server creates the channel, it must wait for client connection due to announcement propagation and handshaking.","type":"text"}]},{"text":"Example Pairing","type":"heading","level":3,"anchor":"Example-Pairing"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Server (C++)","type":"text"}],"type":"strong"},{"type":"text","text":":"}]},{"code":["\/\/ Create with known UUID","xrCreateOpaqueDataChannelNV(instance, &createInfo, &channel);","WaitForConnection(channel);  \/\/ Poll until CONNECTED","xrSendOpaqueDataChannelNV(channel, len, data);"],"syntax":"c++","type":"codeListing"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Client (Swift)","type":"text"}]},{"type":"text","text":":"}],"type":"paragraph"},{"code":["\/\/ Find matching UUID","let channel = cxrSession.getMessageChannel(channelInfo)!","channel.sendServerMessage(responseData)"],"type":"codeListing","syntax":"swift"},{"anchor":"Summary","type":"heading","level":2,"text":"Summary"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The CloudXR Message Channel API provides a flexible way to extend CloudXR applications with custom communication. By following this guide, you can implement robust bi-directional messaging between your client and server applications."}]}]}],"identifier":{"url":"doc:\/\/com.nvidia.CloudXRKit\/documentation\/CloudXRKit\/OpaqueDataChannel","interfaceLanguage":"swift"},"kind":"article","sections":[],"metadata":{"modules":[{"name":"CloudXRKit"}],"role":"article","title":"CloudXR Opaque Data (Message Channel) API User Guide","roleHeading":"Article"},"hierarchy":{"paths":[["doc:\/\/com.nvidia.CloudXRKit\/documentation\/CloudXRKit"]]},"variants":[{"paths":["\/documentation\/cloudxrkit\/opaquedatachannel"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/cloudxrkit\/opaquedatachannel"],"traits":[{"interfaceLanguage":"occ"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://com.nvidia.CloudXRKit/documentation/CloudXRKit":{"type":"topic","abstract":[{"type":"text","text":"Stream immersive applications."}],"role":"collection","url":"\/documentation\/cloudxrkit","identifier":"doc:\/\/com.nvidia.CloudXRKit\/documentation\/CloudXRKit","title":"CloudXRKit","kind":"symbol"}},"variantOverrides":[{"traits":[{"interfaceLanguage":"occ"}