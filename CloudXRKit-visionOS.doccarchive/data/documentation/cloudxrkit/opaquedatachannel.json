{"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The CloudXR Message Channel API provides a bi-directional communication mechanism between the CloudXR client and server applications. This allows you to send custom data alongside the video\/audio streaming, enabling rich interactions between client and server."}]},{"type":"paragraph","inlineContent":[{"text":"On the server-side, this requires the app to implement the XR_NV_opaque_data_channel extension. On the client side, the name used for the API is MessageChannel.","type":"text"}]},{"level":2,"anchor":"Key-Concepts","text":"Key Concepts","type":"heading"},{"level":3,"anchor":"Message-Channels","text":"Message Channels","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Channel","type":"text"}],"type":"strong"},{"type":"text","text":": A bi-directional communication pipe identified by a unique UUID"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Channel Info","type":"text"}],"type":"strong"},{"text":": Contains channel metadata (ID and UUID)","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Channel Status"}]},{"type":"text","text":": Tracks the state of a channel (Not Initialized, Ready, or Closed)"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":3,"anchor":"Components","text":"Components","type":"heading"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"CloudXRKit.Session"}],"type":"strong"},{"type":"text","text":": Manages available channels and provides access to them"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"MessageChannel","type":"text"}]},{"text":": Represents an individual communication channel","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"MessageChannelManager","type":"text"}],"type":"strong"},{"text":": Internal component that handles channel lifecycle","type":"text"}]}]}],"type":"orderedList"},{"level":2,"anchor":"API-Usage","text":"API Usage","type":"heading"},{"level":3,"anchor":"1-Discovering-Available-Channels","text":"1. Discovering Available Channels","type":"heading"},{"inlineContent":[{"text":"Channels are announced by the server. Monitor the session’s ","type":"text"},{"type":"codeVoice","code":"availableMessageChannels"},{"text":" property:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Access available channels from your CloudXRKit.Session instance","let availableChannels = cxrSession.availableMessageChannels","","\/\/ Each ChannelInfo contains:","\/\/ - channelId: Internal numeric identifier","\/\/ - uuid: Unique identifier as Data (can be converted to string)"],"type":"codeListing"},{"text":"2. Opening a Channel","anchor":"2-Opening-a-Channel","level":3,"type":"heading"},{"inlineContent":[{"text":"To start using a channel, retrieve it from the session:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Select a channel from available channels","let channelInfo = cxrSession.availableMessageChannels.first","","\/\/ Get the MessageChannel object","if let channel = cxrSession.getMessageChannel(channelInfo) {","    \/\/ Channel is now ready to use","    print(\"Channel status: \\(channel.status)\")","}"],"type":"codeListing"},{"text":"3. Sending Messages","anchor":"3-Sending-Messages","level":3,"type":"heading"},{"inlineContent":[{"text":"Send data to the server using the channel:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Convert your data to Data format","let message = \"Hello Server\"","if let data = message.data(using: .utf8) {","    let success = channel.sendServerMessage(data)","    if success {","        print(\"Message sent successfully\")","    }","}","","\/\/ You can send any binary data","let binaryData = Data([0x01, 0x02, 0x03, 0x04])","channel.sendServerMessage(binaryData)"],"type":"codeListing"},{"text":"4. Receiving Messages","anchor":"4-Receiving-Messages","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Messages from the server are delivered through an AsyncStream:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Set up a task to receive messages","Task {","    for await messageData in channel.receivedMessageStream {","        \/\/ Process received data","        if let message = String(data: messageData, encoding: .utf8) {","            print(\"Received: \\(message)\")","        } else {","            \/\/ Handle binary data","            print(\"Received \\(messageData.count) bytes\")","        }","    }","    \/\/ Stream ended - channel is closed","    print(\"Channel closed\")","}"],"type":"codeListing"},{"text":"5. Channel Status","anchor":"5-Channel-Status","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Monitor the channel status to ensure proper operation:"}],"type":"paragraph"},{"syntax":"swift","code":["switch channel.status {","case .notInitialized:","    print(\"Channel not yet initialized\")","case .ready:","    print(\"Channel ready for communication\")","case .closed:","    print(\"Channel has been closed\")","}"],"type":"codeListing"},{"text":"6. Closing a Channel","anchor":"6-Closing-a-Channel","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Explicitly close a channel when done:"}],"type":"paragraph"},{"syntax":"swift","code":["channel.disconnect()"],"type":"codeListing"},{"text":"Complete Example","anchor":"Complete-Example","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Here’s a complete example showing typical usage:"}],"type":"paragraph"},{"syntax":"swift","code":["import CloudXRKit","import SwiftUI","","struct MessageChannelExample: View {","    let cxrSession: CloudXRKit.Session","    @State private var currentChannel: MessageChannel?","    @State private var receivedMessages: [String] = []","    @State private var readerTask: Task<Void, Never>?","","    var body: some View {","        VStack {","            \/\/ Channel selection","            if let firstChannel = cxrSession.availableMessageChannels.first {","                Button(\"Open Channel\") {","                    openChannel(firstChannel)","                }","            }","","            \/\/ Send message","            if currentChannel?.status == .ready {","                Button(\"Send Hello\") {","                    sendMessage(\"Hello from client!\")","                }","            }","","            \/\/ Display received messages","            List(receivedMessages, id: \\.self) { message in","                Text(message)","            }","        }","        .onDisappear {","            \/\/ Clean up","            readerTask?.cancel()","            currentChannel?.disconnect()","        }","    }","","    func openChannel(_ channelInfo: ChannelInfo) {","        guard let channel = cxrSession.getMessageChannel(channelInfo) else {","            print(\"Failed to open channel\")","            return","        }","","        currentChannel = channel","","        \/\/ Start receiving messages","        readerTask = Task {","            for await data in channel.receivedMessageStream {","                if let message = String(data: data, encoding: .utf8) {","                    await MainActor.run {","                        receivedMessages.append(message)","                    }","                }","            }","        }","    }","","    func sendMessage(_ text: String) {","        guard let data = text.data(using: .utf8),","              let channel = currentChannel else { return }","","        _ = channel.sendServerMessage(data)","    }","}"],"type":"codeListing"},{"text":"Best Practices","anchor":"Best-Practices","level":2,"type":"heading"},{"text":"1. Error Handling","anchor":"1-Error-Handling","level":3,"type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Always check if "},{"code":"getMessageChannel()","type":"codeVoice"},{"type":"text","text":" returns a valid channel"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Verify "},{"type":"codeVoice","code":"sendServerMessage()"},{"type":"text","text":" return value for send confirmation"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Handle channel closure gracefully in your receive loop"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"2-Data-Encoding","type":"heading","level":3,"text":"2. Data Encoding"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use consistent encoding between client and server (e.g., UTF-8 for text)"}]}]},{"content":[{"inlineContent":[{"text":"Consider using structured formats (JSON, Protocol Buffers) for complex data","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Handle binary data appropriately"}],"type":"paragraph"}]}]},{"anchor":"3-Resource-Management","type":"heading","level":3,"text":"3. Resource Management"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Cancel reader tasks when no longer needed","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Disconnect channels explicitly when done","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Monitor channel status changes","type":"text"}],"type":"paragraph"}]}]},{"anchor":"4-Performance-Considerations","type":"heading","level":3,"text":"4. Performance Considerations"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Message channels share bandwidth with video\/audio streaming","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Avoid sending large amounts of data frequently"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Consider batching small messages","type":"text"}]}]}]},{"type":"heading","text":"Advanced Usage","level":2,"anchor":"Advanced-Usage"},{"type":"heading","text":"Custom Data Formats","level":3,"anchor":"Custom-Data-Formats"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For structured data, consider using JSON:"}]},{"type":"codeListing","code":["struct GameState: Codable {","    let playerPosition: SIMD3<Float>","    let score: Int","}","","\/\/ Sending","let gameState = GameState(playerPosition: [1, 2, 3], score: 100)","if let jsonData = try? JSONEncoder().encode(gameState) {","    channel.sendServerMessage(jsonData)","}","","\/\/ Receiving","for await data in channel.receivedMessageStream {","    if let gameState = try? JSONDecoder().decode(GameState.self, from: data) {","        print(\"Player at: \\(gameState.playerPosition), Score: \\(gameState.score)\")","    }","}"],"syntax":"swift"},{"type":"heading","text":"Multiple Channels","level":3,"anchor":"Multiple-Channels"},{"type":"paragraph","inlineContent":[{"text":"You can manage multiple channels simultaneously:","type":"text"}]},{"type":"codeListing","code":["var activeChannels: [ChannelInfo: MessageChannel] = [:]","","\/\/ Open multiple channels","for channelInfo in cxrSession.availableMessageChannels {","    if let channel = cxrSession.getMessageChannel(channelInfo) {","        activeChannels[channelInfo] = channel","        \/\/ Set up individual receivers for each channel","    }","}"],"syntax":"swift"},{"type":"heading","text":"Troubleshooting","level":2,"anchor":"Troubleshooting"},{"type":"heading","text":"Channel Not Available","level":3,"anchor":"Channel-Not-Available"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensure the server has announced the channel"}]}]},{"content":[{"inlineContent":[{"text":"Check that the session is in connected state","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Verify the channel UUID matches between client and server","type":"text"}]}]}]},{"type":"heading","text":"Messages Not Received","level":3,"anchor":"Messages-Not-Received"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Confirm the channel status is "},{"code":".ready","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Check that the receive task is running"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Verify data encoding matches between sender and receiver","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","text":"Channel Closes Unexpectedly","level":3,"anchor":"Channel-Closes-Unexpectedly"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Monitor server-side logs for errors","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Check network connectivity"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Ensure proper error handling in message processing"}],"type":"paragraph"}]}]},{"level":2,"text":"Server-Side Implementation","anchor":"Server-Side-Implementation","type":"heading"},{"inlineContent":[{"type":"text","text":"The server implements the XR_NV_opaque_data_channel OpenXR extension, which maps to the client’s MessageChannel API:"}],"type":"paragraph"},{"level":3,"text":"How Server and Client Connect","anchor":"How-Server-and-Client-Connect","type":"heading"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Server creates channel"}],"type":"strong"},{"type":"text","text":": "},{"code":"xrCreateOpaqueDataChannelNV()","type":"codeVoice"},{"type":"text","text":" with a UUID"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Client discovers channel","type":"text"}],"type":"strong"},{"text":": Appears in ","type":"text"},{"type":"codeVoice","code":"availableMessageChannels"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Client opens channel","type":"text"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"getMessageChannel()"},{"type":"text","text":" initiates connection"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Both wait for ready state","type":"text"}]},{"type":"text","text":": Server polls for CONNECTED, client for ready"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Exchange messages","type":"text"}],"type":"strong"},{"text":": ","type":"text"},{"type":"codeVoice","code":"xrSend\/ReceiveOpaqueDataChannelNV"},{"text":" ↔ ","type":"text"},{"type":"codeVoice","code":"sendServerMessage\/receivedMessageStream"}]}]}],"type":"orderedList"},{"text":"Key Differences","level":3,"anchor":"Key-Differences","type":"heading"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Shutdown vs Destroy"}]},{"type":"text","text":":"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"xrShutdownOpaqueDataChannelNV","type":"codeVoice"},{"type":"text","text":": Gracefully closes connection (client sees “closed”)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"xrDestroyOpaqueDataChannelNV"},{"type":"text","text":": Frees resources (must call after shutdown)"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Why Server Waits"}]},{"type":"text","text":": Although server creates the channel, it must wait for client connection due to announcement propagation and handshaking."}],"type":"paragraph"},{"text":"Example Pairing","level":3,"anchor":"Example-Pairing","type":"heading"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Server (C++)"}],"type":"strong"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"c++","code":["\/\/ Create with known UUID","xrCreateOpaqueDataChannelNV(instance, &createInfo, &channel);","WaitForConnection(channel);  \/\/ Poll until CONNECTED","xrSendOpaqueDataChannelNV(channel, len, data);"],"type":"codeListing"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Client (Swift)"}],"type":"strong"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["\/\/ Find matching UUID","let channel = cxrSession.getMessageChannel(channelInfo)!","channel.sendServerMessage(responseData)"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Summary","type":"heading","anchor":"Summary"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The CloudXR Message Channel API provides a flexible way to extend CloudXR applications with custom communication. By following this guide, you can implement robust bi-directional messaging between your client and server applications."}]}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/com.nvidia.CloudXRKit\/documentation\/CloudXRKit"]]},"kind":"article","metadata":{"role":"article","title":"CloudXR Opaque Data (Message Channel) API User Guide","modules":[{"name":"CloudXRKit"}],"roleHeading":"Article"},"sections":[],"identifier":{"url":"doc:\/\/com.nvidia.CloudXRKit\/documentation\/CloudXRKit\/OpaqueDataChannel","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/cloudxrkit\/opaquedatachannel"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/cloudxrkit\/opaquedatachannel"]}],"references":{"doc://com.nvidia.CloudXRKit/documentation/CloudXRKit":{"identifier":"doc:\/\/com.nvidia.CloudXRKit\/documentation\/CloudXRKit","title":"CloudXRKit","role":"collection","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Stream immersive applications."}],"url":"\/documentation\/cloudxrkit"}},"variantOverrides":[{"traits":[{"interfaceLanguage":"occ"}],"patch":[{"path":"\/identifier\/interfaceLanguage","op":"replace","value":"occ"},{"path":"\/topicSections","op":"add","value":null},{"path":"\/seeAlsoSections","op":"add","value":null}]}]}