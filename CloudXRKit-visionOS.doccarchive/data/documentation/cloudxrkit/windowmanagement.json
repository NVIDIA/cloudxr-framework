{"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"text":"This guide provides technical instructions for implementing a Window State Manager in visionOS applications using CloudXRKit. The Window State Manager ensures users can always recover the UI if accidentally dismissed during immersive CloudXR sessions.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Prerequisites","type":"heading","text":"Prerequisites"},{"inlineContent":[{"text":"To use this implementation, you’ll need:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"A visionOS app using CloudXRKit","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"SwiftUI-based UI with WindowGroup and ImmersiveSpace scenes"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A CloudXRKit.Session instance for streaming","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Your own content view and streaming view implementations"}]}]}],"type":"unorderedList"},{"text":"Architecture Overview","level":2,"type":"heading","anchor":"Architecture-Overview"},{"type":"paragraph","inlineContent":[{"text":"The Window State Manager coordinates between:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"SwiftUI Window lifecycle events","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"ImmersiveSpace lifecycle events","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"CloudXRKit session state changes (using CloudXRKit.SessionState)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"User interactions (gestures, system controls)","type":"text"}]}]}]},{"type":"codeListing","code":["┌─────────────────────────────────────────────────────────────────────────┐","│                              Your visionOS App                          │","├─────────────────────────────────────────────────────────────────────────┤","│                                                                         │","│  ┌─────────────────┐                           ┌────────────────────┐   │","│  │   WindowGroup   │                           │  ImmersiveSpace    │   │","│  │                 │                           │                    │   │","│  │  ┌───────────┐  │                           │  ┌──────────────┐  │   │","│  │  │ onAppear  │  │                           │  │  onAppear    │  │   │","│  │  │onDisappear│  │                           │  │ onDisappear  │  │   │","│  │  └─────┬─────┘  │                           │  └──────┬───────┘  │   │","│  └────────┼────────┘                           └─────────┼──────────┘   │","│           │                                              │              │","│           │         ┌──────────────────────────┐         │              │","│           └────────▶│                          │◀────────┘              │","│                     │   WindowStateManager     │                        │","│                     │                          │                        │","│  ┌─────────────┐    │  • windowVisible         │    ┌───────────────┐   │","│  │   Scene     │───▶│  • immersiveSpaceActive  │◀───│ User Gestures │   │","│  │   Phase     │    │  • sessionState          │    │ (Triple-tap)  │   │","│  └─────────────┘    │  • configured            │    └───────────────┘   │","│                     │                          │                        │","│  ┌─────────────┐    │  Recovery Logic:         │    ┌───────────────┐   │","│  │ CloudXRKit  │───▶│  • Crown press           │◀───│ System Events │   │","│  │   Session   │    │  • Disconnection         │    │ (Crown press) │   │","│  │   State     │    │  • Scene changes         │    └───────────────┘   │","│  └─────────────┘    └──────────────────────────┘                        │","│                                                                         │","└─────────────────────────────────────────────────────────────────────────┘"],"syntax":null},{"type":"heading","level":2,"text":"Core Components","anchor":"Core-Components"},{"type":"heading","level":3,"text":"1. Window State Manager Class","anchor":"1-Window-State-Manager-Class"},{"type":"codeListing","code":["import SwiftUI","import CloudXRKit","import os.log","","#if os(visionOS)","class WindowStateManager: ObservableObject {","    \/\/ Window state tracking","    private var windowVisible = false","    private var immersiveSpaceActive = false","    private var configured = false","","    \/\/ Session state tracking (using CloudXRKit.SessionState)","    @Published private(set) var sessionState: CloudXRKit.SessionState = .disconnected","    private var pauseOnImmersiveSpaceDismissed = true","","    \/\/ Configuration options","    var debugHideWindowAtConnection = false","","    \/\/ SwiftUI Actions","    private var openImmersiveSpace: OpenImmersiveSpaceAction!","    private var dismissImmersiveSpace: DismissImmersiveSpaceAction!","    private var openWindow: OpenWindowAction!","    private var dismissWindow: DismissWindowAction!","","    \/\/ Callbacks for session control","    var onSessionPauseRequested: (() -> Void)?","    var onSessionResumeRequested: (() async throws -> Void)?","","    \/\/ Thread safety","    private var lock = OSAllocatedUnfairLock()","    private static let logger = Logger()","","    \/\/ Window IDs","    private let launchWindowId = \"LaunchWindow\"","    private let immersiveSpaceId = \"ImmersiveSpace\"","}","#endif"],"syntax":"swift"},{"level":3,"text":"1.1 Complete WindowStateManager Implementation","anchor":"11-Complete-WindowStateManager-Implementation","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Here’s the full implementation that can be used in any CloudXRKit-based application:"}]},{"type":"codeListing","code":["extension WindowStateManager {","    \/\/ MARK: - Window Lifecycle","","    func windowOnAppear(openImmersiveSpace: OpenImmersiveSpaceAction,","                        dismissImmersiveSpace: DismissImmersiveSpaceAction,","                        openWindow: OpenWindowAction,","                        dismissWindow: DismissWindowAction) {","        guard !windowVisible else {","            Self.logger.error(\"windowOnAppear called while window already open\")","            return","        }","","        if !configured {","            self.openImmersiveSpace = openImmersiveSpace","            self.dismissImmersiveSpace = dismissImmersiveSpace","            self.openWindow = openWindow","            self.dismissWindow = dismissWindow","            configured = true","        }","","        windowVisible = true","    }","","    func windowOnDisappear() {","        guard windowVisible else {","            Self.logger.error(\"windowOnDisappear called when window is already dismissed\")","            return","        }","        windowVisible = false","    }","","    \/\/ MARK: - Scene Phase Management","","    func windowOnScenePhaseChange(scenePhase: ScenePhase) {","        guard configured else {","            Self.logger.error(\"Window manager not configured when scene phase changed\")","            return","        }","","        switch scenePhase {","        case .inactive:","            if windowVisible {","                dismissWindow(id: launchWindowId)","            }","        case .active:","            if sessionState == .paused {","                Task { @MainActor in","                    try? await onSessionResumeRequested?()","                    if !immersiveSpaceActive {","                        await openImmersiveSpace(id: immersiveSpaceId)","                    }","                }","            }","        case .background:","            dismissImmersiveSpaceIfOpen()","        @unknown default:","            break","        }","    }","","    \/\/ MARK: - Immersive Space Lifecycle","","    func immersiveSpaceOnAppear() {","        guard !immersiveSpaceActive else {","            Self.logger.error(\"Immersive space was already active when onAppear was called\")","            return","        }","        immersiveSpaceActive = true","    }","","    func immersiveSpaceOnDisappear() {","        guard immersiveSpaceActive else {","            Self.logger.error(\"Immersive space state incorrect on disappear\")","            return","        }","","        guard configured else {","            Self.logger.error(\"Window manager not configured when immersive space disappeared\")","            return","        }","","        immersiveSpaceActive = false","","        \/\/ RECOVERY MECHANISM: Restore window when exiting immersive space","        if windowVisible == false {","            openWindow(id: launchWindowId)","        }","","        \/\/ Handle session state","        switch sessionState {","        case .disconnecting, .disconnected, .initialized, .pausing, .paused:","            return","        default:","            if pauseOnImmersiveSpaceDismissed {","                onSessionPauseRequested?()","            }","        }","    }","","    \/\/ MARK: - Session State Management","","    func onSessionStateChanged(oldState: CloudXRKit.SessionState, newState: CloudXRKit.SessionState) async {","        sessionState = newState","","        switch newState {","        case .connected:","            await handleConnectionEstablished()","        case .disconnected:","            await handleDisconnection()","        default:","            return","        }","    }","","    \/\/ MARK: - Window Control","","    func toggleWindow() {","        guard configured else {","            Self.logger.error(\"Window manager is not configured when toggling the window\")","            return","        }","","        if windowVisible {","            dismissWindow(id: launchWindowId)","        } else {","            openWindow(id: launchWindowId)","        }","    }","","    func dismissImmersiveSpaceIfOpen() {","        if immersiveSpaceActive {","            Task { @MainActor in","                await dismissImmersiveSpace()","            }","        }","    }","}"],"syntax":"swift"},{"type":"heading","anchor":"2-SwiftUI-Event-Hookup-Points","level":3,"text":"2. SwiftUI Event Hookup Points"},{"type":"heading","anchor":"21-App-Entry-Point-Configuration","level":4,"text":"2.1 App Entry Point Configuration"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In your app’s main "},{"code":"App","type":"codeVoice"},{"type":"text","text":" struct:"}]},{"syntax":"swift","code":["@main","struct YourApp: App {","    @StateObject private var windowManager = WindowStateManager()","    @State private var cxrSession = CloudXRKit.Session(config: CloudXRKit.Config())","    @Environment(\\.openWindow) var openWindow","    @Environment(\\.dismissWindow) var dismissWindow","    @Environment(\\.openImmersiveSpace) var openImmersiveSpace","    @Environment(\\.dismissImmersiveSpace) var dismissImmersiveSpace","    @Environment(\\.scenePhase) var scenePhase","","    var body: some Scene {","        WindowGroup(id: \"LaunchWindow\") {","            YourContentView() \/\/ Your app's main UI","                .onAppear {","                    \/\/ Configure window manager with SwiftUI actions","                    windowManager.windowOnAppear(","                        openImmersiveSpace: openImmersiveSpace,","                        dismissImmersiveSpace: dismissImmersiveSpace,","                        openWindow: openWindow,","                        dismissWindow: dismissWindow","                    )","","                    \/\/ Set up session callbacks","                    windowManager.onSessionPauseRequested = {","                        cxrSession.pause()","                    }","","                    windowManager.onSessionResumeRequested = {","                        try await cxrSession.resume()","                    }","                }","                .onDisappear {","                    windowManager.windowOnDisappear()","                }","                .onChange(of: scenePhase) { _, newPhase in","                    windowManager.windowOnScenePhaseChange(scenePhase: newPhase)","                }","                .onChange(of: cxrSession.state) { oldState, newState in","                    Task {","                        await windowManager.onSessionStateChanged(","                            oldState: oldState,","                            newState: newState","                        )","                    }","                }","        }","        .environmentObject(windowManager)","","        ImmersiveSpace(id: \"ImmersiveSpace\") {","            YourStreamingView(cxrSession: cxrSession) \/\/ Your CloudXR streaming view","                .onAppear {","                    windowManager.immersiveSpaceOnAppear()","                }","                .onDisappear {","                    windowManager.immersiveSpaceOnDisappear()","                }","                .onTapGesture(count: 3) {","                    \/\/ RECOVERY MECHANISM: Triple-tap to toggle window","                    windowManager.toggleWindow()","                }","        }","        .environmentObject(windowManager)","    }","}"],"type":"codeListing"},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Note","type":"text"}],"type":"strong"},{"text":": ","type":"text"},{"code":"YourStreamingView","type":"codeVoice"},{"text":" should be your implementation that displays CloudXR content using the CloudXRKit session. This typically involves creating a RealityKit view that renders the streamed content.","type":"text"}],"type":"paragraph"}],"name":"Note","style":"note","type":"aside"},{"type":"heading","level":2,"anchor":"Event-Flow-and-Handling","text":"Event Flow and Handling"},{"type":"heading","level":3,"anchor":"3-Window-Lifecycle-Events","text":"3. Window Lifecycle Events"},{"type":"heading","level":4,"anchor":"31-Window-Appearance","text":"3.1 Window Appearance"},{"type":"codeListing","syntax":"swift","code":["func windowOnAppear(openImmersiveSpace: OpenImmersiveSpaceAction,","                    dismissImmersiveSpace: DismissImmersiveSpaceAction,","                    openWindow: OpenWindowAction,","                    dismissWindow: DismissWindowAction) {","    \/\/ Step 1: Validate state","    guard !windowVisible else {","        Self.logger.error(\"windowOnAppear called while window already open\")","        return","    }","","    \/\/ Step 2: Configure dependencies (first time only)","    if !configured {","        self.openImmersiveSpace = openImmersiveSpace","        self.dismissImmersiveSpace = dismissImmersiveSpace","        self.openWindow = openWindow","        self.dismissWindow = dismissWindow","        configured = true","    }","","    \/\/ Step 3: Update state","    windowVisible = true","}"]},{"type":"heading","level":4,"text":"3.2 Window Disappearance","anchor":"32-Window-Disappearance"},{"type":"codeListing","syntax":"swift","code":["func windowOnDisappear() {","    guard windowVisible else {","        fatalError(\"windowOnDisappear called when window is already dismissed\")","    }","    windowVisible = false","}"]},{"level":3,"text":"4. Scene Phase Changes","anchor":"4-Scene-Phase-Changes","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The scene phase handler manages app lifecycle transitions:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["func windowOnScenePhaseChange(scenePhase: ScenePhase) {","    guard configured else {","        fatalError(\"Window manager not configured when scene phase changed\")","    }","","    switch scenePhase {","    case .inactive:","        \/\/ App is becoming inactive (e.g., another app is in focus)","        if windowVisible {","            dismissWindow(id: launchWindowId)","        }","","    case .active:","        \/\/ App is becoming active","        if sessionState == .paused {","            Task { @MainActor in","                try? await onSessionResumeRequested?()","                if !immersiveSpaceActive {","                    await openImmersiveSpace(id: immersiveSpaceId)","                }","            }","        }","","    case .background:","        \/\/ App is in background (handle in ImmersiveSpace)","        break","","    @unknown default:","        break","    }","}"]},{"anchor":"5-Immersive-Space-Events","level":3,"text":"5. Immersive Space Events","type":"heading"},{"text":"5.1 Immersive Space Appearance","level":4,"anchor":"51-Immersive-Space-Appearance","type":"heading"},{"syntax":"swift","code":["func immersiveSpaceOnAppear() {","    guard !immersiveSpaceActive else {","        fatalError(\"Immersive space was already active when onAppear was called\")","    }","    immersiveSpaceActive = true","}"],"type":"codeListing"},{"text":"5.2 Immersive Space Disappearance (Crown Press Recovery)","level":4,"anchor":"52-Immersive-Space-Disappearance-Crown-Press-Recovery","type":"heading"},{"code":["func immersiveSpaceOnDisappear() {","    guard immersiveSpaceActive else {","        fatalError(\"Immersive space state incorrect on disappear\")","    }","","    guard configured else {","        fatalError(\"Window manager not configured when immersive space disappeared\")","    }","","    immersiveSpaceActive = false","","    \/\/ RECOVERY MECHANISM: Automatically restore window when exiting immersive space","    if windowVisible == false {","        openWindow(id: \"LaunchWindow\")","    }","","    \/\/ Handle session state","    switch sessionState {","    case .disconnecting, .disconnected, .initialized, .pausing, .paused:","        return","    default:","        if pauseOnImmersiveSpaceDismissed {","            onSessionPauseRequested?()","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"text":"Recovery Mechanisms Implementation","level":2,"anchor":"Recovery-Mechanisms-Implementation","type":"heading"},{"level":3,"anchor":"6-Triple-Tap-Gesture-Recovery","text":"6. Triple-Tap Gesture Recovery","type":"heading"},{"inlineContent":[{"type":"text","text":"Implementation in the ImmersiveSpace view:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["ImmersiveSpace(id: \"ImmersiveSpace\") {","    StreamingView(cxrSession: cxrSession)","        .onTapGesture(count: 3) {","            windowManager.toggleWindow()","        }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Toggle window implementation:"}]},{"type":"codeListing","syntax":"swift","code":["func toggleWindow() {","    guard configured else {","        Self.logger.error(\"Window manager is not configured when toggling the window\")","        return","    }","","    if windowVisible {","        dismissWindow(id: launchWindowId)","    } else {","        openWindow(id: launchWindowId)","    }","}"]},{"type":"heading","level":3,"anchor":"7-Connection-State-Recovery","text":"7. Connection State Recovery"},{"type":"paragraph","inlineContent":[{"text":"Hook up session state changes:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Session state changes are handled via onChange modifier",".onChange(of: cxrSession.state) { oldState, newState in","    Task { @MainActor in","        await windowManager.onSessionStateChanged(","            oldState: oldState,","            newState: newState","        )","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Implementation:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["func onSessionStateChanged(oldState: SessionState, newState: SessionState) async {","    \/\/ Update internal session state","    sessionState = newState","","    switch newState {","    case .connected:","        await handleConnectionEstablished()","    case .disconnected:","        await handleDisconnection()","    default:","        return","    }","}","","private func handleDisconnection() async {","    guard configured else {","        Self.logger.error(\"Disconnection before window manager was configured\")","        return","    }","","    \/\/ RECOVERY MECHANISM: Restore window on disconnection","    if windowVisible == false {","        await openWindow(id: launchWindowId)","    }","","    if immersiveSpaceActive == true {","        await dismissImmersiveSpace()","    }","}","","private func handleConnectionEstablished() async {","    guard configured else {","        Self.logger.error(\"Connection established before window manager was configured\")","        return","    }","","    if !immersiveSpaceActive {","        await openImmersiveSpace(id: immersiveSpaceId)","    }","","    \/\/ Hide window based on debug settings","    #if DEBUG","    if debugHideWindowAtConnection {","        await dismissWindow(id: launchWindowId)","    }","    #else","    await dismissWindow(id: launchWindowId)","    #endif","}"]},{"anchor":"Usage-in-Your-Views","level":2,"text":"Usage in Your Views","type":"heading"},{"inlineContent":[{"type":"text","text":"When using the WindowStateManager in your views, access it via @EnvironmentObject:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct YourView: View {","    @EnvironmentObject var windowManager: WindowStateManager","","    var body: some View {","        \/\/ Your view implementation","    }","}"]},{"level":2,"text":"Testing and Validation","anchor":"Testing-and-Validation","type":"heading"},{"level":3,"text":"8. Test Scenarios","anchor":"8-Test-Scenarios","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Normal Flow","type":"text"}],"type":"strong"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Launch app → Window appears","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Connect → Window dismisses, immersive space opens","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Triple-tap → Window toggles"}]}]}],"type":"unorderedList"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Crown Press Recovery","type":"text"}]}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"In immersive space → Press crown"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Verify: Window automatically reopens","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Disconnection Recovery","type":"text"}]}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Hide window → Disconnect session"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Verify: Window automatically reopens"}],"type":"paragraph"}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Rapid Toggle Test"}],"type":"strong"}]},{"syntax":"swift","code":["func testRapidToggle() async {","    for _ in 0..<10 {","        windowManager.toggleWindow()","        try? await Task.sleep(nanoseconds: 100_000_000) \/\/ 0.1s","    }","    \/\/ Verify final state is consistent","}"],"type":"codeListing"}]}],"type":"orderedList"},{"text":"9. State Validation","anchor":"9-State-Validation","type":"heading","level":3},{"inlineContent":[{"text":"Add debug assertions:","type":"text"}],"type":"paragraph"},{"code":["#if DEBUG","extension WindowStateManager {","    func validateState() {","        assert(!(windowVisible && !configured), \"Window visible but manager not configured\")","        assert(!(immersiveSpaceActive && !configured), \"Immersive space active but manager not configured\")","    }","}","#endif"],"type":"codeListing","syntax":"swift"},{"level":2,"anchor":"Best-Practices","type":"heading","text":"Best Practices"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Always validate state before operations"}],"type":"strong"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Use @MainActor for UI operations"}],"type":"strong"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Handle all error cases gracefully","type":"text"}],"type":"strong"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Provide multiple recovery paths"}]}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Test edge cases thoroughly","type":"text"}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Document recovery methods for users"}],"type":"strong"}]}]}],"type":"orderedList"},{"anchor":"Common-Pitfalls","level":2,"text":"Common Pitfalls","type":"heading"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Race Conditions"}],"type":"strong"},{"type":"text","text":": Use proper state management and locks"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Missing Configuration","type":"text"}]},{"type":"text","text":": Ensure window manager is configured before use"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Async\/Await Misuse"}],"type":"strong"},{"text":": Always await async operations properly","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"State Inconsistency","type":"text"}]},{"type":"text","text":": Validate state transitions"}],"type":"paragraph"}]}],"type":"orderedList"},{"text":"Integration Example","type":"heading","anchor":"Integration-Example","level":2},{"type":"paragraph","inlineContent":[{"text":"Here’s how to integrate the window manager into your CloudXRKit application:","type":"text"}]},{"code":["\/\/ WindowStateManager+Extensions.swift","extension WindowStateManager {","    \/\/ Public method to update session state from outside","    func updateSessionState(_ newState: SessionState) {","        lock.withLock {","            sessionState = newState","        }","    }","","    \/\/ Configuration options","    func configure(debugHideWindow: Bool = false,","                   pauseOnDismiss: Bool = true) {","        debugHideWindowAtConnection = debugHideWindow","        pauseOnImmersiveSpaceDismissed = pauseOnDismiss","    }","}","","\/\/ In your app initialization","let windowManager = WindowStateManager()","windowManager.configure(","    debugHideWindow: false,","    pauseOnDismiss: true",")"],"type":"codeListing","syntax":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"modules":[{"name":"CloudXRKit"}],"role":"article","roleHeading":"Article","title":"Window State Manager Implementation Guide for CloudXRKit Apps"},"variants":[{"paths":["\/documentation\/cloudxrkit\/windowmanagement"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/cloudxrkit\/windowmanagement"],"traits":[{"interfaceLanguage":"occ"}]}],"kind":"article","identifier":{"url":"doc:\/\/com.nvidia.CloudXRKit\/documentation\/CloudXRKit\/WindowManagement","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/com.nvidia.CloudXRKit\/documentation\/CloudXRKit"]]},"references":{"doc://com.nvidia.CloudXRKit/documentation/CloudXRKit":{"abstract":[{"text":"Stream immersive applications.","type":"text"}],"identifier":"doc:\/\/com.nvidia.CloudXRKit\/documentation\/CloudXRKit","kind":"symbol","type":"topic","title":"CloudXRKit","url":"\/documentation\/cloudxrkit","role":"collection"}},"variantOverrides":[{"patch":[{"value":"occ","op":"replace","path":"\/identifier\/interfaceLanguage"},{"value":null,"op":"add","path":"\/topicSections"},{"value":null,"op":"add","path":"\/seeAlsoSections"}],"traits":[{"interfaceLanguage":"occ"}]}]}